---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/view-transitions.css';
import Intro from '../components/home/Intro.astro';
import CartDrawer from '../components/menu/CartDrawer';
import AuthProvider from '../components/auth/AuthProvider';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Dimonca Repostería - Deliciosas galletas artesanales, cuchareables, brownies y pasteles preparados con amor y los mejores ingredientes."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&family=Sacramento&display=swap"
			rel="stylesheet"
		/>
		<title>Dimonca | Repostería y Galletas Artesanales</title>
		<ClientRouter />
	</head>
	<body>
		
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-pink focus:px-6 focus:py-3 focus:font-sans focus:font-bold focus:text-beige focus:shadow-lg focus:outline-none focus:ring-4 focus:ring-beige"
		>
			Saltar al contenido principal
		</a>
		<slot />
		<Intro />
		<AuthProvider client:load />
		<CartDrawer client:load />

		<script>
			import Lenis from 'lenis';

			// ======================================================================
			// View Transition: expansión card → detalle (solo mobile vía CSS)
			// Los nombres de transición se aplican SOLO a la card clickeada en el
			// momento del click. Si todas las cards los tuvieran, las no clickeadas
			// quedarían como snapshots fantasma flotando durante la transición.
			// capture:true → corre antes del interceptor de clicks de Astro.
			// ======================================================================
			document.addEventListener(
				'click',
				(e) => {
					if (!(e.target instanceof Element)) return;
					const link = e.target.closest('a[href^="/menu/"]');
					if (!link) return;
					const card = link.closest<HTMLElement>('[data-vt-card]');
					if (!card) return;

					const id = card.getAttribute('data-vt-card');
					if (!id) return;

					card.style.viewTransitionName = `product-card-${id}`;
					card
						.querySelector<HTMLElement>('[data-vt-image]')
						?.style.setProperty('view-transition-name', `product-image-${id}`);
					card
						.querySelector<HTMLElement>('[data-vt-name]')
						?.style.setProperty('view-transition-name', `product-name-${id}`);
					card
						.querySelector<HTMLElement>('[data-vt-price]')
						?.style.setProperty('view-transition-name', `product-price-${id}`);
				},
				true
			);

			// Al SALIR de una página de detalle, quitar sus nombres de transición:
			// si volviera al menú con nombres activos y sin match en las cards,
			// los snapshots del detalle flotarían como fantasmas sobre el menú.
			document.addEventListener('astro:before-preparation', () => {
				if (!document.getElementById('pd-hero')) return;
				document.querySelectorAll<HTMLElement>('[style*="view-transition-name"]').forEach((el) => {
					if (el.style.viewTransitionName.startsWith('product-')) {
						el.style.viewTransitionName = '';
					}
				});
			});

			let lenisInstance: Lenis | null = null;
			let rafId: number | null = null;

			function initSmoothScroll() {
				if (lenisInstance) {
					lenisInstance.destroy();
				}
				if (rafId) {
					cancelAnimationFrame(rafId);
				}

				lenisInstance = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					smoothWheel: true,
					touchMultiplier: 1.5,
				});
				(window as any).lenis = lenisInstance;

				function raf(time: number) {
					lenisInstance?.raf(time);
					rafId = requestAnimationFrame(raf);
				}

				rafId = requestAnimationFrame(raf);
			}

			const CURTAIN_COLORS = [
				'#6ca7d5', // Azul Pistacho Queen / Our Products
				'#f45d8c', // Rosa Cookies & Cream
				'#3a200e', // Café Red Velvet
				'#979255', // Oliva Galleta Roche
				'#f7f2e8', // Beige base
			];

			function setRandomCurtainColor() {
				const randomColor = CURTAIN_COLORS[Math.floor(Math.random() * CURTAIN_COLORS.length)];
				document.documentElement.style.setProperty('--curtain-color', randomColor);
			}

			document.addEventListener('astro:before-preparation', setRandomCurtainColor);
			document.addEventListener('astro:page-load', () => {
				initSmoothScroll();
				setRandomCurtainColor();
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
