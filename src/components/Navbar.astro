---
import { Icon } from 'astro-icon/components';

const categories = [
	{ label: 'Galletas', img: '/images/cookie.png' },
	{ label: 'Cuchareables', img: '/images/cuchareable.png' },
	{ label: 'Brownies', img: '/images/brownie.png' },
	{ label: 'Pasteles', img: '/images/cake.png' },
	{ label: 'Más Productos', img: '/images/crookie.png' },
];
---

<header class="navbar">
	<div class="bar">
		<a class="nav-link" href="#encuentranos">Encuéntranos</a>
		<button class="nav-link menu" type="button" aria-haspopup="true" aria-controls="dropdown">
			Menú
			<Icon name="lucide:chevron-down" class="chevron" aria-hidden="true" />
		</button>
		<a class="logo" href="/" aria-label="Dimonca, inicio">
			<img src="/images/logo.png" alt="Dimonca" />
		</a>
		<a class="nav-link" href="#sobre-nosotros">Sobre Nosotros</a>
		<a class="cta" href="#pedido">
			Haz tu pedido
			<span class="cta-icon"><img src="/images/map.svg" alt="" /></span>
		</a>
	</div>
	<nav class="dropdown" id="dropdown" aria-label="Categorías del menú">
		{
			categories.map((c) => (
				<a class="dd-item" href={`#${c.label.toLowerCase().replace(/\s+/g, '-')}`}>
					<img class="dd-img" src={c.img} alt={c.label} />
					<p class="dd-label">{c.label}</p>
				</a>
			))
		}
	</nav>
</header>

<style>
	.navbar {
		--beige: #f7f2e8;
		--brown: #3a200e;
		--pink: #f45d8c;

		font-family: 'Poppins', Inter, sans-serif;
		position: relative;
		width: 100%;
		filter: drop-shadow(0px 11px 19.05px rgba(58, 32, 14, 0.14));
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 60px;
		padding: 16px 80px;
		background: var(--beige);
	}

	.nav-link {
		display: flex;
		flex: 1 0 0;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-width: 0;
		padding: 10px;
		font-size: 15px;
		font-weight: 400;
		line-height: 1.2;
		color: var(--brown);
		text-decoration: none;
		white-space: nowrap;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.nav-link:hover {
		opacity: 0.75;
	}

	.menu {
		position: relative;
		height: 30px;
		color: var(--brown);
	}

	.menu::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 32px;
	}

	.chevron {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.logo {
		flex-shrink: 0;
	}

	.logo img {
		display: block;
		width: 159px;
		height: 46px;
	}

	.cta {
		display: flex;
		flex: 1 0 0;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-width: 0;
		height: 46px;
		padding: 8px 16px;
		border-radius: 57px;
		background: var(--pink);
		color: var(--beige);
		font-size: 15px;
		font-weight: 700;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
	}

	.cta:hover {
		filter: brightness(0.95);
	}

	.cta-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		padding: 5.4px;
		border-radius: 18.38px;
		background: var(--beige);
		box-sizing: border-box;
	}

	.cta-icon img {
		display: block;
		width: 12.98px;
		height: 12.98px;
	}

	.dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 93px;
		width: 100%;
		padding: 18px 0;
		background: var(--beige);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0.2s;
		pointer-events: none;
	}

	.navbar:has(.menu:hover, .dropdown:hover) .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.navbar:has(.menu:hover, .dropdown:hover) .chevron {
		transform: rotate(180deg);
	}

	.dd-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 9px;
		width: 121px;
		text-decoration: none;
	}

	.dd-img {
		display: block;
		width: 121px;
		height: 121px;
		object-fit: cover;
		object-position: center;
	}

	.dd-label {
		font-size: 15px;
		font-weight: 400;
		line-height: 1.2;
		color: var(--brown);
		text-align: center;
		margin: 0;
	}

	@media (max-width: 900px) {
		.bar {
			flex-wrap: wrap;
			gap: 24px 32px;
			padding: 16px 24px;
		}

		.nav-link {
			flex: none;
		}

		.cta {
			flex: none;
		}
	}
</style>
