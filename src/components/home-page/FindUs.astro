---
import { Icon } from 'astro-icon/components';

const stripes = Array.from({ length: 12 }, (_, i) => ({
	left: (i * (62.1 / 720)) * 100,
	width: (31 / 720) * 100,
}));

const findusImages = [
	'/images/findus/brookie.png',
	'/images/findus/brownie.png',
	'/images/findus/cooki.png',
	'/images/findus/cookie.png',
	'/images/findus/hovered.png',
	'/images/findus/milo.png',
	'/images/findus/oreo.png',
	'/images/findus/r-bronwnie.png',
	'/images/findus/r-cookie.png',
	'/images/findus/red.png',
	'/images/findus/velvet.png',
];
---

<section id="findus-section" class="relative w-full bg-beige overflow-hidden select-none">
	<!-- Malla interactiva de fondo: ubicada desde el botón 'Como llegar' hacia abajo -->
	<div
		id="findus-grid-container"
		class="pointer-events-none absolute inset-x-0 bottom-0 top-[480px] z-0 overflow-hidden"
		aria-hidden="true"
	>
		<div
			id="findus-grid"
			class="relative grid w-full h-full"
		>
		</div>
	</div>

	<div class="relative z-10 mx-auto grid min-h-[600px] max-w-[1440px] grid-cols-1 md:grid-cols-2 items-center">
		<!-- Columna Izquierda (50%) -->
		<div class="flex flex-col items-start justify-center px-10 md:pl-24 md:pr-12 py-16">
			<!-- Título -->
			<div class="relative mb-6">
				<h2 class="m-0 font-sans text-[44px] md:text-[48px] font-bold leading-tight text-brown">
					Encuentranos en:
				</h2>
				<span
					class="block font-exmouth text-[72px] md:text-[84px] leading-none text-pink -mt-2 tracking-wide"
					aria-hidden="true"
				>
					Valle del Lili
				</span>
			</div>

			<!-- Dirección con Pin -->
			<div class="mb-5 flex items-center gap-3">
				<img class="block size-8 shrink-0 object-contain" src="/images/marker-pin.svg" alt="" aria-hidden="true" />
				<p class="m-0 font-sans text-[26px] md:text-[28px] font-medium text-brown">
					Cra 90 #42-28
				</p>
			</div>

			<!-- Descripción -->
			<p class="mb-8 max-w-[420px] font-sans text-[17px] md:text-[18px] leading-relaxed text-brown">
				Te esperamos con el aroma de galletas recién horneadas y muchas delicias para compartir.
			</p>

			<!-- Botón Como llegar -->
			<a
				class="group flex h-[52px] items-center justify-center gap-3 whitespace-nowrap rounded-[57px] bg-pink px-7 py-3 font-sans text-[18px] font-bold text-beige no-underline shadow-[0_4px_14px_rgba(244,93,140,0.4)] transition-all duration-300 hover:shadow-[0_6px_20px_rgba(244,93,140,0.6)] hover:brightness-95"
				href="#como-llegar"
			>
				Como llegar
				<span
					class="flex h-[32px] w-[32px] shrink-0 items-center justify-center rounded-full bg-beige transition-transform duration-300 group-hover:scale-110"
				>
					<Icon name="lucide:map" class="block h-[16px] w-[16px] text-pink" aria-hidden="true" />
				</span>
			</a>
		</div>

		<!-- Columna Derecha (50%) -->
		<div class="relative flex h-full min-h-[620px] w-full items-center justify-center overflow-hidden bg-beige">
			<!-- Rayas verticales rosadas de fondo -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
				{
					stripes.map((s) => (
						<div
							class="absolute top-0 bottom-0 bg-pink"
							style={`left: ${s.left}%; width: ${s.width}%;`}
						/>
					))
				}
			</div>

			<!-- Contenedor del Mapa e Ilustraciones decorativas -->
			<div class="relative z-10 flex items-center justify-center p-8">
				<div class="relative">
					<!-- Imagen principal del Mapa -->
					<img
						src="/images/map.png"
						alt="Mapa de ubicación Dimonca en Valle del Lili"
						class="block h-auto max-h-[500px] w-auto max-w-full object-contain drop-shadow-xl"
					/>

					<!-- map1: Persona/chica abrazando galleta (centrado verticalmente, borde izquierdo) -->
					<img
						src="/images/map1.png"
						alt=""
						aria-hidden="true"
						class="pointer-events-none absolute top-1/2 -left-12 -translate-y-1/2 z-20 w-[120px] md:w-[140px] drop-shadow-lg"
					/>

					<!-- map2: Galleta en empaque kraft (arriba a la derecha) -->
					<img
						src="/images/map3.png"
						alt=""
						aria-hidden="true"
						class="pointer-events-none absolute -top-6 -right-6 z-20 w-[90px] md:w-[105px] drop-shadow-lg"
					/>

					<!-- map3: Logo Dimonca (abajo a la derecha) -->
					<img
						src="/images/map2.png"
						alt=""
						aria-hidden="true"
						class="pointer-events-none absolute bottom-10 scale-150 -right-20 z-20 w-[140px] md:w-[165px] drop-shadow-xl"
					/>
				</div>
			</div>
		</div>
	</div>

	<!-- Mini Call To Action inferior -->
	<div class="relative z-10 mx-auto max-w-[1440px] px-10 md:px-24 py-16 md:py-36">
		<div class="grid grid-cols-1 md:grid-cols-2 items-center gap-10 md:gap-16">
			<!-- Lado Izquierdo CTA: Título con caligrafía -->
			<div class="relative">
				<h3
					style="paint-order: stroke;"
					class="m-0 font-sans text-[42px] md:text-[48px] font-extrabold leading-[1.15] text-brown [-webkit-text-stroke:10px_#F7F2E8]">
					El mejor momento para<br />
					un postre <span class="relative inline-block">es
						<span
							style="paint-order: stroke;"
							class="pointer-events-none absolute -top-8 left-full ml-3 font-exmouth text-[100px] 
							md:text-[120px] font-normal leading-none text-pink 
							[-webkit-text-stroke:6px_#F7F2E8]"
							aria-hidden="true"
						>
							Ahora
						</span>
					</span>
				</h3>
			</div>

			<!-- Lado Derecho CTA: Descripción + Botón -->
			<div class="flex flex-col items-start gap-5 max-w-[420px]">
				<p class="m-0 font-sans text-[17px] leading-relaxed text-brown">
					No esperes a que el antojo pase. Explora nuestro menú, elige tus favoritos y déjanos endulzar tu día con cada bocado.
				</p>
				<a
					class="group flex h-[48px] items-center justify-center gap-3 whitespace-nowrap rounded-[57px] bg-pink px-6 py-2 font-sans text-[17px] font-bold text-beige no-underline shadow-[0_4px_14px_rgba(244,93,140,0.4)] transition-all duration-300 hover:shadow-[0_6px_20px_rgba(244,93_140,0.6)] hover:brightness-95"
					href="#pedido"
				>
					Haz tu pedido
					<span
						class="flex h-[28px] w-[28px] shrink-0 items-center justify-center rounded-full bg-beige transition-transform duration-300 group-hover:scale-110"
					>
						<Icon name="lucide:map" class="block h-[14px] w-[14px] text-pink" aria-hidden="true" />
					</span>
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { animate } from 'motion';

	const images = [
		'/images/findus/brookie.png',
		'/images/findus/brownie.png',
		'/images/findus/cooki.png',
		'/images/findus/cookie.png',
		'/images/findus/hovered.png',
		'/images/findus/milo.png',
		'/images/findus/oreo.png',
		'/images/findus/r-bronwnie.png',
		'/images/findus/r-cookie.png',
		'/images/findus/red.png',
		'/images/findus/velvet.png',
	];

	function setupFindUsGrid() {
		const section = document.getElementById('findus-section');
		const gridContainer = document.getElementById('findus-grid-container');
		const grid = document.getElementById('findus-grid');
		const btnLlegar = section?.querySelector('a[href="#como-llegar"]');
		if (!section || !grid || !gridContainer) return;

		const cellSize = 85;
		let lastCellIndex = -1;
		let lastActiveImg: HTMLImageElement | null = null;
		let imgIndex = 0;

		function updateContainerBounds() {
			if (!btnLlegar || !section || !gridContainer) return;
			const sectionRect = section.getBoundingClientRect();
			const btnRect = btnLlegar.getBoundingClientRect();
			const topOffset = btnRect.bottom - sectionRect.top + 10;
			gridContainer.style.top = `${Math.max(0, topOffset)}px`;
		}

		function fillGrid() {
			if (!grid || !gridContainer) return;
			updateContainerBounds();

			grid.innerHTML = '';
			const width = gridContainer.offsetWidth;
			const height = gridContainer.offsetHeight;

			const cols = Math.ceil(width / cellSize);
			const rows = Math.ceil(height / cellSize);
			const totalCells = cols * rows;

			grid.style.gridTemplateColumns = `repeat(${cols}, ${cellSize}px)`;
			grid.style.gridTemplateRows = `repeat(${rows}, ${cellSize}px)`;

			for (let i = 0; i < totalCells; i++) {
				const cell = document.createElement('div');
				cell.className = 'relative flex items-center justify-center w-full h-full overflow-visible';
				cell.dataset.index = i.toString();

				const img = document.createElement('img');
				img.className = 'pointer-events-none absolute w-[95px] h-[95px] object-contain opacity-0 select-none';
				img.style.transform = 'scale(0.3)';
				cell.appendChild(img);

				grid.appendChild(cell);
			}
		}

		fillGrid();

		window.addEventListener('resize', fillGrid);

		function hideImage(img: HTMLImageElement | null) {
			if (!img) return;
			animate(
				img,
				{
					opacity: [1, 0],
					scale: [1, 0.4],
				},
				{
					duration: 0.22,
					ease: 'easeIn',
				}
			);
		}

		section.addEventListener('mousemove', (e) => {
			if (!gridContainer) return;
			const containerRect = gridContainer.getBoundingClientRect();
			const x = e.clientX - containerRect.left;
			const y = e.clientY - containerRect.top;

			// Si el cursor está arriba de la zona del grid (por encima del botón), no activar
			if (y < 0) {
				if (lastActiveImg) {
					hideImage(lastActiveImg);
					lastActiveImg = null;
					lastCellIndex = -1;
				}
				return;
			}

			const cols = Math.ceil(gridContainer.offsetWidth / cellSize);
			const rows = Math.ceil(gridContainer.offsetHeight / cellSize);

			const col = Math.floor(x / cellSize);
			const row = Math.floor(y / cellSize);

			if (col < 0 || col >= cols || row < 0 || row >= rows) {
				if (lastActiveImg) {
					hideImage(lastActiveImg);
					lastActiveImg = null;
					lastCellIndex = -1;
				}
				return;
			}

			const cellIndex = row * cols + col;
			if (cellIndex === lastCellIndex) return;

			// Ocultar rápidamente la imagen anterior que estaba activa
			if (lastActiveImg) {
				hideImage(lastActiveImg);
			}

			lastCellIndex = cellIndex;

			const cell = grid.children[cellIndex] as HTMLElement | undefined;
			if (!cell) {
				lastActiveImg = null;
				return;
			}

			const img = cell.querySelector('img');
			if (!img) {
				lastActiveImg = null;
				return;
			}

			img.src = images[imgIndex % images.length];
			imgIndex++;

			const randomRotation = (Math.random() - 0.5) * 25;

			// Entrada rápida y fija mientras el cursor esté aquí
			animate(
				img,
				{
					opacity: [0, 1],
					scale: [0.3, 1.12, 1],
					rotate: [-randomRotation, randomRotation * 0.3, 0],
				},
				{
					duration: 0.25,
					ease: 'backOut',
				}
			);

			lastActiveImg = img;
		});

		section.addEventListener('mouseleave', () => {
			if (lastActiveImg) {
				hideImage(lastActiveImg);
				lastActiveImg = null;
				lastCellIndex = -1;
			}
		});
	}

	setupFindUsGrid();
</script>