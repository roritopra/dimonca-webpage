---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/common/Navbar.astro';
import Footer from '../../../components/common/Footer.astro';
import { PRODUCTS } from '../../../data/products';
import type { Product } from '../../../types/products';

export function getStaticPaths() {
	const boxProducts = PRODUCTS.filter((p) => p.productType === 'custom_box');
	const availableCookies = PRODUCTS.filter((p) => p.productType === 'single' && p.category === 'galletas');

	return boxProducts.map((product) => ({
		params: { id: product.id },
		props: {
			product,
			availableCookies,
		},
	}));
}

interface Props {
	product: Product;
	availableCookies: Product[];
}

const { product, availableCookies } = Astro.props;

if (!product || product.productType !== 'custom_box') {
	return Astro.redirect('/menu');
}

const boxCapacity = product.boxConfig?.capacity || 3;
---

<Layout>
	<Navbar />

	<main id="main-content" class="min-h-screen bg-beige pt-24 sm:pt-28 pb-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4">
			<nav class="flex items-center gap-2 text-xs sm:text-sm font-medium text-brown/60">
				<a href="/" class="hover:text-pink transition-colors">Inicio</a>
				<span>/</span>
				<a href="/menu" class="hover:text-pink transition-colors">Menú</a>
				<span>/</span>
				<span class="text-pink font-semibold">Combos & Cajas</span>
				<span>/</span>
				<span class="text-brown font-bold truncate max-w-[200px]">{product.name}</span>
			</nav>
		</div>

		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 mt-2">
			<div class="rounded-3xl bg-white p-6 sm:p-10 shadow-[0_4px_30px_rgba(58,32,14,0.06)] border border-brown/10">
				<div class="text-center max-w-2xl mx-auto mb-8">
					<span class="rounded-full bg-pink/15 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-pink inline-block mb-3">
						Experiencia Interactiva
					</span>
					<h1 class="font-sans text-3xl sm:text-4xl font-extrabold text-brown">
						{product.name}
					</h1>
					<p class="font-sans text-2xl font-bold text-pink mt-2">
						{product.priceFormatted}
					</p>
					<p class="mt-3 text-sm text-brown/75 leading-relaxed">
						{product.fullDescription}
					</p>
					<p class="mt-2 text-xs font-semibold text-brown/60">
						Capacidad máxima: <strong class="text-pink">{boxCapacity} galletas</strong>
					</p>
				</div>

				<div id="box-builder-root" data-capacity={boxCapacity} data-box-id={product.id}>
					<div class="py-12 text-center border-2 border-dashed border-pink/30 rounded-2xl bg-beige/40">
						<p class="font-sans text-base font-bold text-brown">
							Lógica y props listos para {product.name}.
						</p>
						<p class="mt-1 text-xs text-brown/60">
							{availableCookies.length} variedades de galletas listas para cargarse dinámicamente en la caja.
						</p>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>