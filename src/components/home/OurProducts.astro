---
import { Icon } from "astro-icon/components";
import CookieCard from "./CookieCard.astro";

import oreoImg from "../../assets/images/home/our-products/card-oreo.png";
import oreoCrackedImg from "../../assets/images/home/our-products/card-oreo-cracked.png";
import redVelvetImg from "../../assets/images/home/our-products/card-red-velvet.png";
import redVelvetCrackedImg from "../../assets/images/home/our-products/card-red-velvet-cracked.png";
import rocheImg from "../../assets/images/home/our-products/card-roche.png";
import rocheCrackedImg from "../../assets/images/home/our-products/card-roche-cracked.png";

const cookies = [
  {},
  {
    img: oreoImg,
    imgCracked: oreoCrackedImg,
    color: "#F45D8C",
    scriptTop: "Cookies",
    scriptBottom: "Cream",
    title: "Cookies & Cream",
    price: "$ 13.000",
    description: "Galleta premium de oreo con trozos reales y relleno suave ...",
  },
  {
    img: redVelvetImg,
    imgCracked: redVelvetCrackedImg,
    color: "#3A200E",
    scriptTop: "Red",
    scriptBottom: "Velvet",
    title: "Red Velvet",
    price: "$ 13.000",
    description: "Galleta premium de red velvet con centro cremoso y chips de chocolate blanco ...",
  },
  {
    img: rocheImg,
    imgCracked: rocheCrackedImg,
    color: "#979255",
    hoverBg: "#FCF48D",
    hoverPrice: "#32311C",
    scriptTop: "Galleta",
    scriptBottom: "Roche",
    title: "Galleta Roche",
    price: "$ 13.000",
    description: "Galleta premium estilo bombón roche con avellanas y chocolate ...",
  },
];

// Grupos idénticos para el loop infinito: el track avanza un ancho de grupo y
// envuelve (módulo), como los grupos son iguales el corte es invisible.
// 4 grupos cubren viewports anchos (se necesita track >= viewport + 1 grupo).
const groups = [0, 1, 2, 3];
---

<section id="galletas" class="relative z-10 w-full overflow-hidden bg-beige">
  <div class="absolute inset-x-0 top-0 h-[440px] sm:h-[510px] lg:h-[606px] bg-blue-500">
    <div
      class="absolute inset-0 left-1/2 w-[1440px] max-w-full -translate-x-1/2"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-35"
        style={{
          width: "2000px",
          height: "2000px",
          backgroundImage:
            "radial-gradient(circle, #f7f2e8 2.8px, transparent 2px)",
          backgroundSize: "20px 20px",
          backgroundPosition: "8px 8px",
        }}
        aria-hidden="true"
      >
      </div>

      <div class="absolute inset-x-0 top-[28px] sm:top-[38px] lg:top-[51px] text-center px-4">
        <h2
          style="paint-order: stroke;"
          class="m-0 font-sans text-[28px] sm:text-[34px] lg:text-[38px] leading-[1.2] text-brown [-webkit-text-stroke:8px_#F7F2E8] sm:[-webkit-text-stroke:12px_#F7F2E8] lg:[-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Conoce Nuestras
        </h2>
      </div>
      <div class="absolute inset-x-0 top-[50px] sm:top-[62px] lg:top-[81px] text-center" aria-hidden="true">
        <p
          style="paint-order: stroke;"
          class="m-0 font-exmouth text-[100px] sm:text-[130px] lg:text-[154.71px] leading-[1.2] text-brown [-webkit-text-stroke:8px_#F7F2E8] sm:[-webkit-text-stroke:12px_#F7F2E8] lg:[-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Galletas
        </p>
      </div>
    </div>
  </div>

  <!-- Carrusel infinito de borde a borde (sin max-width: toca ambos finales).
    Se mueve solo, despacio, sin botones ni puntos, en mobile y desktop. -->
  <div class="relative w-full pt-[240px] sm:pt-[275px] lg:pt-[310px]">
    <div class="w-full overflow-hidden py-8">
      <div class="cookie-marquee-track flex w-max will-change-transform">
        {
          groups.map((g) => (
            <div
              class="cookie-marquee-group flex shrink-0 items-stretch gap-[20px] pr-[20px] sm:gap-[24px] sm:pr-[24px] lg:gap-[30px] lg:pr-[30px]"
              aria-hidden={g > 0 ? "true" : undefined}
            >
              {cookies.map((c) => (
                <CookieCard {...c} />
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="mx-auto flex max-w-[1440px] flex-col items-center px-6 sm:px-10 lg:px-20 pb-12 lg:pb-16">
      <a
        class="group flex h-[48px] sm:h-[52px] w-[190px] sm:w-[210px] items-center justify-center gap-3
        whitespace-nowrap rounded-[57px] bg-[#6CA7D5] px-6 py-3 font-sans text-[17px] sm:text-[19px]
        leading-[1.2] font-bold text-beige no-underline
        transition-all duration-300 hover:brightness-95"
        href="#galletas"
      >
        Ver más
        <span
          class="flex h-[30px] w-[30px] sm:h-[32px] sm:w-[32px] shrink-0 items-center justify-center rounded-full bg-beige transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >
          <Icon
            name="lucide:arrow-up-right"
            class="h-4 w-4 sm:h-[18px] sm:w-[18px] text-[#6CA7D5]"
            aria-hidden="true"
          />
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  // Carrusel infinito: avance lineal lento (px/s) con envolvimiento por módulo
  // sobre el ancho de un grupo. Solo avanza cuando la sección está visible.
  const MARQUEE_SPEED = 28;

  function initCookieMarquee() {
    const track = document.querySelector<HTMLElement>('.cookie-marquee-track');
    if (!track) return;
    const group = track.querySelector<HTMLElement>('.cookie-marquee-group');
    if (!group) return;

    // Los grupos clonados repiten los mismos links: sacarlos del tab order.
    track.querySelectorAll('.cookie-marquee-group[aria-hidden="true"] a').forEach((a) => {
      (a as HTMLElement).tabIndex = -1;
    });

    // Invalidar el loop anterior si existía (navegación SPA reemplaza el DOM).
    const prev = (window as unknown as { __cookieMq?: { dead: boolean; io: IntersectionObserver | null } }).__cookieMq;
    if (prev) {
      prev.dead = true;
      prev.io?.disconnect();
    }
    const state = { dead: false, io: null as IntersectionObserver | null };
    (window as unknown as { __cookieMq?: typeof state }).__cookieMq = state;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let visible = true;
    if ('IntersectionObserver' in window) {
      state.io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            visible = entry.isIntersecting;
          });
        },
        { threshold: 0 }
      );
      state.io.observe(track);
    }

    let dist = 0;
    let last = performance.now();

    const tick = (now: number) => {
      if (state.dead) return;
      const dt = Math.min(Math.max((now - last) / 1000, 0), 0.1);
      last = now;
      if (visible) {
        const w = group.offsetWidth;
        if (w > 0) {
          dist = (dist + MARQUEE_SPEED * dt) % w;
          track.style.transform = `translate3d(${-dist}px, 0, 0)`;
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  initCookieMarquee();
  document.addEventListener('astro:page-load', initCookieMarquee);
</script>
