---
import { Icon } from "astro-icon/components";
import CookieCard from "./CookieCard.astro";

import oreoImg from "../../assets/images/cookie-card-oreo.png";
import oreoCrackedImg from "../../assets/images/cookie-card-oreo-cracked.png";
import redVelvetImg from "../../assets/images/cookie-card-red-velvet.png";
import redVelvetCrackedImg from "../../assets/images/cookie-card-red-velvet-cracked.png";
import rocheImg from "../../assets/images/cookie-card-roche.png";
import rocheCrackedImg from "../../assets/images/cookie-card-roche-cracked.png";
---

<section id="galletas" class="relative z-10 w-full overflow-hidden bg-beige">
  <div class="absolute inset-x-0 top-0 h-[606px] bg-blue-500">
    <div
      class="absolute inset-0 left-1/2 w-[1440px] max-w-full -translate-x-1/2"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-35"
        style={{
          width: "2000px",
          height: "2000px",
          backgroundImage:
            "radial-gradient(circle, #f7f2e8 2.8px, transparent 2px)",
          backgroundSize: "20px 20px",
          backgroundPosition: "8px 8px",
        }}
        aria-hidden="true"
      >
      </div>

      <div class="absolute inset-x-0 top-[51px] text-center">
        <h2
          style="paint-order: stroke;"
          class="m-0 font-sans text-[38px] leading-[1.2] text-brown [-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Conoce Nuestras
        </h2>
      </div>
      <div class="absolute inset-x-0 top-[81px] text-center" aria-hidden="true">
        <p
          style="paint-order: stroke;"
          class="m-0 font-exmouth text-[154.71px] leading-[1.2] text-brown [-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Galletas
        </p>
      </div>
    </div>
  </div>

  <div
    class="relative mx-auto flex max-w-[1440px] flex-col items-center px-20 pt-[350px] pb-16"
  >
    <div class="grid grid-cols-4 gap-[30px]">
      <CookieCard />
      <CookieCard
        img={oreoImg}
        imgCracked={oreoCrackedImg}
        color="#F45D8C"
        scriptTop="Cookies"
        scriptBottom="Cream"
        title="Cookies & Cream"
        price="$ 13.000"
        description="Galleta premium de oreo con trozos reales y relleno suave ..."
      />
      <CookieCard
        img={redVelvetImg}
        imgCracked={redVelvetCrackedImg}
        color="#3A200E"
        scriptTop="Red"
        scriptBottom="Velvet"
        title="Red Velvet"
        price="$ 13.000"
        description="Galleta premium de red velvet con centro cremoso y chips de chocolate blanco ..."
      />
      <CookieCard
        img={rocheImg}
        imgCracked={rocheCrackedImg}
        color="#979255"
        hoverBg="#FCF48D"
        hoverPrice="#32311C"
        scriptTop="Galleta"
        scriptBottom="Roche"
        title="Galleta Roche"
        price="$ 13.000"
        description="Galleta premium estilo bombón roche con avellanas y chocolate ..."
      />
    </div>

    <a
      class="group mt-10 flex h-[52px] w-[210px] items-center justify-center gap-3 
      whitespace-nowrap rounded-[57px] bg-[#6CA7D5] px-6 py-3 font-sans text-[19px] 
      leading-[1.2] font-bold text-beige no-underline 
      transition-all duration-300 hover:brightness-95"
      href="#galletas"
    >
      Ver más
      <span
        class="flex h-[32px] w-[32px] shrink-0 items-center justify-center rounded-full bg-beige transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        <Icon
          name="lucide:arrow-up-right"
          class="h-[18px] w-[18px] text-[#6CA7D5]"
          aria-hidden="true"
        />
      </span>
    </a>
  </div>
</section>
