---
import { Icon } from "astro-icon/components";

const photos = [
  { id: "sobre-1", src: "/images/sobre-1.png", alt: "", justify: "justify-start" },
  { src: "/images/sobre-2.png", alt: "", justify: "justify-end" },
  { src: "/images/sobre-4.png", alt: "", justify: "justify-start" },
  { src: "/images/sobre-3.png", alt: "", justify: "justify-start" },
];
---

<section class="w-full bg-beige">
  <div
    class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-center gap-16 px-20 py-16"
  >
    <div class="relative grid w-[540px] max-w-full grid-cols-2 gap-x-5 gap-y-8">
      {
        photos.map((p) => (
          <div class={`flex flex-col ${p.justify}`}>
            <img
              id={p.id}
              class="block h-auto w-full object-contain"
              src={p.src}
              alt={p.alt}
            />
          </div>
        ))
      }
      <p
        class="absolute top-0 left-8/12 z-10 w-full max-w-[300px]
		-translate-x-1/2 font-exmouth text-[40.74px] leading-[1.2]
		text-brown [-webkit-text-stroke:8px_#F7F2E8] [paint-order:stroke_fill]
		[filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
      >
        Darte siempre un poquito más de lo que amas.
      </p>
      <img
        class="absolute bottom-0 left-1/2 z-10 -translate-x-1/2 block w-[160px] h-auto"
        src="/images/sobre-cookie.png"
        alt=""
      />
      <div
        class="absolute top-1/2 right-0 z-20 flex size-[71px] -translate-y-1/2 items-center justify-center"
      >
        <div class="-rotate-30">
          <div
            class="flex items-center rounded-[140.54px] border-[2.11px] border-beige bg-pink p-[7.03px] drop-shadow-[0px_2.81px_1.4px_rgba(58,32,14,0.15)]"
          >
            <div
              class="flex items-center rounded-[22.49px] border-[2px] border-pink-200 p-[7.03px]"
            >
              <Icon name="lucide:heart" class="block h-[23.89px] w-[23.89px] text-beige" aria-hidden="true" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex w-[522px] max-w-full flex-col gap-[9px]">
      <div class="relative h-[158px]">
        <p
          class="w-[521px] font-sans text-[59px] leading-[1.2] font-bold text-brown"
        >
          Bienvenido al universo
        </p>
        <span
          class="absolute top-[62px] left-[273px] font-exmouth text-[81.14px] leading-[1.2] text-pink"
          >Dimonca</span
        >
      </div>
      <p
        class="min-w-full text-[19px] leading-[1.2] whitespace-pre-wrap text-brown"
      >
        Bienvenidos a Dimonca deliciosos momentos dulces te esperan en nuestro{
          " "
        }
        <strong>rincón de tentaciones</strong>
        {
          ", donde cada bocado es una experiencia única! Desde clásicos tradicionales hasta "
        }
        <strong>creaciones innovadoras</strong>
        {
          " Nuestra pasión por la pastelería se refleja en cada pastel que preparamos con mucho amor! "
        }
      </p>
      <a
        class="mt-1 flex h-[46px] w-[196px] items-center justify-center gap-2 whitespace-nowrap rounded-[57px] bg-pink px-4 py-2 font-sans text-[19px] leading-[1.2] font-bold text-beige no-underline hover:brightness-95"
        href="#contacto"
      >
        Contáctanos
        <span
          class="flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-[21.25px] bg-beige p-[6.25px]"
        >
          <Icon
            name="lucide:phone-call"
            class="block h-[15px] w-[15px]"
            aria-hidden="true"
          />
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { animate, inView } from "motion";

  function setupSobreAnimation() {
    const sobre1 = document.getElementById("sobre-1");
    if (!sobre1) return;

    inView(sobre1, () => {
      animate(
        sobre1,
        {
          x: [-200, 0],
          rotate: [-9, 0],
        },
        {
          duration: 1.4,
          ease: [0.7, -0.4, 0.25, 1.35],
        }
      );

      animate(
        sobre1,
        {
          y: [-100, 0],
        },
        {
          duration: 1.4,
          ease: [0.35, -0.3, 0.1, 1.45],
        }
      );
    });
  }

  setupSobreAnimation();
</script>
