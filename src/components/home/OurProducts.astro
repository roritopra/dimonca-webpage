---
import { Icon } from "astro-icon/components";
import CookieCard from "./CookieCard.astro";

import oreoImg from "../../assets/images/cookie-card-oreo.png";
import oreoCrackedImg from "../../assets/images/cookie-card-oreo-cracked.png";
import redVelvetImg from "../../assets/images/cookie-card-red-velvet.png";
import redVelvetCrackedImg from "../../assets/images/cookie-card-red-velvet-cracked.png";
import rocheImg from "../../assets/images/cookie-card-roche.png";
import rocheCrackedImg from "../../assets/images/cookie-card-roche-cracked.png";
---

<section id="galletas" class="relative z-10 w-full overflow-hidden bg-beige">
  <div class="absolute inset-x-0 top-0 h-[380px] sm:h-[480px] lg:h-[606px] bg-blue-500">
    <div
      class="absolute inset-0 left-1/2 w-[1440px] max-w-full -translate-x-1/2"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-35"
        style={{
          width: "2000px",
          height: "2000px",
          backgroundImage:
            "radial-gradient(circle, #f7f2e8 2.8px, transparent 2px)",
          backgroundSize: "20px 20px",
          backgroundPosition: "8px 8px",
        }}
        aria-hidden="true"
      >
      </div>

      <div class="absolute inset-x-0 top-[28px] sm:top-[40px] lg:top-[51px] text-center px-4">
        <h2
          style="paint-order: stroke;"
          class="m-0 font-sans text-[22px] sm:text-[30px] lg:text-[38px] leading-[1.2] text-brown [-webkit-text-stroke:8px_#F7F2E8] sm:[-webkit-text-stroke:12px_#F7F2E8] lg:[-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Conoce Nuestras
        </h2>
      </div>
      <div class="absolute inset-x-0 top-[50px] sm:top-[64px] lg:top-[81px] text-center" aria-hidden="true">
        <p
          style="paint-order: stroke;"
          class="m-0 font-exmouth text-[80px] sm:text-[115px] lg:text-[154.71px] leading-[1.2] text-brown [-webkit-text-stroke:8px_#F7F2E8] sm:[-webkit-text-stroke:12px_#F7F2E8] lg:[-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Galletas
        </p>
      </div>
    </div>
  </div>

  <div
    class="relative mx-auto flex max-w-[1440px] flex-col items-center px-0 lg:px-20 pt-[210px] sm:pt-[270px] lg:pt-[350px] pb-12 lg:pb-16"
  >
    <!-- Carrusel en móvil/tablet, grid en desktop -->
    <div
      class="cookie-cards-wrapper w-full lg:w-auto overflow-x-auto scroll-smooth snap-x snap-mandatory lg:overflow-visible flex lg:grid lg:grid-cols-4 gap-[20px] sm:gap-[24px] lg:gap-[30px] px-6 sm:px-10 lg:px-0 pb-4 lg:pb-0"
      style="-webkit-overflow-scrolling: touch; scrollbar-width: none;"
    >
      <CookieCard />
      <CookieCard
        img={oreoImg}
        imgCracked={oreoCrackedImg}
        color="#F45D8C"
        scriptTop="Cookies"
        scriptBottom="Cream"
        title="Cookies & Cream"
        price="$ 13.000"
        description="Galleta premium de oreo con trozos reales y relleno suave ..."
      />
      <CookieCard
        img={redVelvetImg}
        imgCracked={redVelvetCrackedImg}
        color="#3A200E"
        scriptTop="Red"
        scriptBottom="Velvet"
        title="Red Velvet"
        price="$ 13.000"
        description="Galleta premium de red velvet con centro cremoso y chips de chocolate blanco ..."
      />
      <CookieCard
        img={rocheImg}
        imgCracked={rocheCrackedImg}
        color="#979255"
        hoverBg="#FCF48D"
        hoverPrice="#32311C"
        scriptTop="Galleta"
        scriptBottom="Roche"
        title="Galleta Roche"
        price="$ 13.000"
        description="Galleta premium estilo bombón roche con avellanas y chocolate ..."
      />
    </div>

    <!-- Indicadores de puntos (solo visibles en móvil/tablet) -->
    <div class="flex lg:hidden items-center justify-center gap-2 mt-5 py-2" aria-hidden="true" id="cookie-dots">
      <button class="cookie-dot transition-all duration-300 rounded-full h-2.5 w-6 bg-blue-500" data-index="0" data-active="true" aria-label="Ir a galleta 1"></button>
      <button class="cookie-dot transition-all duration-300 rounded-full h-2.5 w-2.5 bg-blue-500/30" data-index="1" data-active="false" aria-label="Ir a galleta 2"></button>
      <button class="cookie-dot transition-all duration-300 rounded-full h-2.5 w-2.5 bg-blue-500/30" data-index="2" data-active="false" aria-label="Ir a galleta 3"></button>
      <button class="cookie-dot transition-all duration-300 rounded-full h-2.5 w-2.5 bg-blue-500/30" data-index="3" data-active="false" aria-label="Ir a galleta 4"></button>
    </div>

    <a
      class="group mt-8 lg:mt-10 flex h-[48px] sm:h-[52px] w-[190px] sm:w-[210px] items-center justify-center gap-3
      whitespace-nowrap rounded-[57px] bg-[#6CA7D5] px-6 py-3 font-sans text-[17px] sm:text-[19px]
      leading-[1.2] font-bold text-beige no-underline
      transition-all duration-300 hover:brightness-95"
      href="#galletas"
    >
      Ver más
      <span
        class="flex h-[30px] w-[30px] sm:h-[32px] sm:w-[32px] shrink-0 items-center justify-center rounded-full bg-beige transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        <Icon
          name="lucide:arrow-up-right"
          class="h-4 w-4 sm:h-[18px] sm:w-[18px] text-[#6CA7D5]"
          aria-hidden="true"
        />
      </span>
    </a>
  </div>
</section>

<style>
  .cookie-cards-wrapper::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 1023px) {
    .cookie-cards-wrapper > :global(.cookie-card) {
      snap-align: center;
      flex-shrink: 0;
      scroll-snap-align: center;
      width: 270px;
    }
  }
  @media (max-width: 479px) {
    .cookie-cards-wrapper > :global(.cookie-card) {
      width: 250px;
    }
  }
</style>

<script>
  function initCookieCarousel() {
    const wrapperEl = document.querySelector<HTMLElement>('.cookie-cards-wrapper');
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.cookie-dot'));
    if (!wrapperEl || dots.length === 0) return;
    const wrapper = wrapperEl;

    function updateDots(activeIndex: number) {
      dots.forEach((dot, i) => {
        const isActive = i === activeIndex;
        dot.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          dot.className = 'cookie-dot transition-all duration-300 rounded-full h-2.5 w-6 bg-blue-500';
        } else {
          dot.className = 'cookie-dot transition-all duration-300 rounded-full h-2.5 w-2.5 bg-blue-500/30';
        }
      });
    }

    let isScrollingFromClick = false;
    let scrollTimeout: number | undefined;

    function getActiveIndex() {
      const cards = Array.from(wrapper.querySelectorAll<HTMLElement>('.cookie-card'));
      if (cards.length === 0) return 0;

      const wrapperRect = wrapper.getBoundingClientRect();
      const targetCenter = wrapperRect.left + wrapperRect.width / 2;

      let closest = 0;
      let minDiff = Infinity;

      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        const cardCenter = r.left + r.width / 2;
        const diff = Math.abs(targetCenter - cardCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closest = i;
        }
      });

      return closest;
    }

    function onScroll() {
      if (window.innerWidth >= 1024 || isScrollingFromClick) return;
      const activeIdx = getActiveIndex();
      updateDots(activeIdx);
    }

    wrapper.addEventListener('scroll', onScroll, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        if (window.innerWidth >= 1024) return;
        const index = parseInt(dot.dataset.index ?? '0', 10);
        const cards = Array.from(wrapper.querySelectorAll<HTMLElement>('.cookie-card'));
        const targetCard = cards[index];

        if (targetCard) {
          isScrollingFromClick = true;
          updateDots(index);

          const cardOffsetLeft = targetCard.offsetLeft;
          const cardWidth = targetCard.offsetWidth;
          const wrapperWidth = wrapper.clientWidth;
          const scrollTarget = cardOffsetLeft - (wrapperWidth / 2) + (cardWidth / 2);

          wrapper.scrollTo({
            left: scrollTarget,
            behavior: 'smooth'
          });

          window.clearTimeout(scrollTimeout);
          scrollTimeout = window.setTimeout(() => {
            isScrollingFromClick = false;
            updateDots(getActiveIndex());
          }, 450);
        }
      });
    });

    updateDots(getActiveIndex());
  }

  initCookieCarousel();
  document.addEventListener('astro:page-load', initCookieCarousel);
</script>
