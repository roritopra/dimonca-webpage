---
import sobre1Img from "../../assets/images/home/sobre-nosotros/foto-1.png";
import sobre2Img from "../../assets/images/home/sobre-nosotros/foto-2.png";
import sobre3Img from "../../assets/images/home/sobre-nosotros/foto-3.png";
import sobre4Img from "../../assets/images/home/sobre-nosotros/foto-4.png";
---

<div id="intro-overlay" transition:persist aria-hidden="true">
  <!-- Definición del clip-path para las 6 fotos dentro de la D -->
  <svg class="absolute h-0 w-0 pointer-events-none" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="intro-d-clip" clipPathUnits="objectBoundingBox">
        <path
          transform="scale(0.00125, 0.00125)"
          d="M397.28,554.41c-11.97,22.97-21.45,45.15-34.34,65.12-34.4,53.29-83.29,82.13-147.68,83.66-41.78.99-84.02-25.75-100.96-66.44-15.98-38.39-16.57-77.04,1.74-114.96,11.21-23.23,29.57-38.55,54.55-45.5,6.84-1.9,13.51-2.29,16.11,6.63,11.5,39.52,62.3,46.44,95.8,31.3,43.86-19.82,67.98-57.23,80.51-101.1,10.81-37.83,16.01-77.27,23.62-116.01,2.48-12.64,4.23-25.45,7.24-37.96,6.17-25.57,29.48-34.53,51.13-33.71,12.63.48,21.66,8.57,21.06,21.47-1.13,24.27-3.48,48.55-6.72,72.64-5.15,38.26-12.13,76.28-16.96,114.57-2.09,16.51-.75,33.9,16.45,43.39,17.1,9.44,33.12,2.95,47.4-7.09,21.35-15.01,32.91-37.22,40.1-61.45,15.58-52.49,16.98-105.27-2.98-156.9-14.95-38.68-45.25-59.1-86.17-60.94-49.07-2.2-94.73,9.41-131.79,43.68-25.23,23.33-35.24,53.09-28.71,87.14,3.35,17.49,11.28,31.97,32.39,33.43,2.59.18,6.54,4.53,6.96,7.37.81,5.53.24,11.51-.93,17.06-11.14,53.04-57.12,89.58-105.62,84.18-34.4-3.83-64.89-34.22-74.8-70.99-27.23-101.03,24.64-186.38,95.18-234.8,74.91-51.42,158.38-71.21,248.41-56.92,64.48,10.23,111.6,47.01,137.34,106.38,50.53,116.54,41.11,230.89-22.25,340.09-19.89,34.28-49.07,60.61-88.72,72.81-50.21,15.45-98.06.4-120.25-51.62-2.04-4.77-4.56-9.34-7.14-14.56Z"
        />
      </clipPath>
    </defs>
  </svg>

  <!-- Capa Rosa de Pantalla Completa con Recorte D (1:1 idéntico al contenedor) -->
  <svg
    id="intro-pink-cutout"
    class="absolute inset-0 h-full w-full pointer-events-none opacity-0"
  >
    <defs>
      <mask id="intro-pink-mask">
        <!-- Todo blanco = fondo rosa opaco -->
        <rect x="0" y="0" width="100%" height="100%" fill="#ffffff" />
        <!-- D centrada con dimensiones idénticas a dContainer -->
        <g id="intro-cutout-center">
          <g id="intro-cutout-scaler">
            <path
              fill="#000000"
              transform="translate(-400, -400)"
              d="M397.28,554.41c-11.97,22.97-21.45,45.15-34.34,65.12-34.4,53.29-83.29,82.13-147.68,83.66-41.78.99-84.02-25.75-100.96-66.44-15.98-38.39-16.57-77.04,1.74-114.96,11.21-23.23,29.57-38.55,54.55-45.5,6.84-1.9,13.51-2.29,16.11,6.63,11.5,39.52,62.3,46.44,95.8,31.3,43.86-19.82,67.98-57.23,80.51-101.1,10.81-37.83,16.01-77.27,23.62-116.01,2.48-12.64,4.23-25.45,7.24-37.96,6.17-25.57,29.48-34.53,51.13-33.71,12.63.48,21.66,8.57,21.06,21.47-1.13,24.27-3.48,48.55-6.72,72.64-5.15,38.26-12.13,76.28-16.96,114.57-2.09,16.51-.75,33.9,16.45,43.39,17.1,9.44,33.12,2.95,47.4-7.09,21.35-15.01,32.91-37.22,40.1-61.45,15.58-52.49,16.98-105.27-2.98-156.9-14.95-38.68-45.25-59.1-86.17-60.94-49.07-2.2-94.73,9.41-131.79,43.68-25.23,23.33-35.24,53.09-28.71,87.14,3.35,17.49,11.28,31.97,32.39,33.43,2.59.18,6.54,4.53,6.96,7.37.81,5.53.24,11.51-.93,17.06-11.14,53.04-57.12,89.58-105.62,84.18-34.4-3.83-64.89-34.22-74.8-70.99-27.23-101.03,24.64-186.38,95.18-234.8,74.91-51.42,158.38-71.21,248.41-56.92,64.48,10.23,111.6,47.01,137.34,106.38,50.53,116.54,41.11,230.89-22.25,340.09-19.89,34.28-49.07,60.61-88.72,72.81-50.21,15.45-98.06.4-120.25-51.62-2.04-4.77-4.56-9.34-7.14-14.56Z"
            />
          </g>
        </g>
      </mask>
    </defs>
    <rect x="0" y="0" width="100%" height="100%" fill="#f45d8c" mask="url(#intro-pink-mask)" />
  </svg>

  <!-- Contenedor central de la D para fases 1 y 2 -->
  <div id="intro-d-container" class="relative flex items-center justify-center pointer-events-none">
    <!-- 1. D Blanca Inicial -->
    <img
      id="intro-d-solid"
      src="/images/shared/logo-simple.svg"
      alt="Dimonca"
      class="absolute inset-0 h-full w-full object-contain"
    />

    <!-- 2. Slideshow con máscara de recorte D (6 imágenes) -->
    <div id="intro-d-masked" class="absolute inset-0 h-full w-full opacity-0">
      <div id="intro-slides-wrapper" class="relative h-full w-full bg-beige">
        <img class="intro-slide active" src={sobre1Img.src} alt="" />
        <img class="intro-slide" src={sobre2Img.src} alt="" />
        <img class="intro-slide" src={sobre3Img.src} alt="" />
        <img class="intro-slide" src={sobre4Img.src} alt="" />
        <img class="intro-slide" src={sobre1Img.src} alt="" />
        <img class="intro-slide" src={sobre2Img.src} alt="" />
      </div>
    </div>
  </div>
</div>

<style>
  #intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-pink, #f45d8c);
    overflow: hidden;
  }

  #intro-d-container {
    width: clamp(240px, 35vw, 360px);
    height: clamp(240px, 35vw, 360px);
    aspect-ratio: 1 / 1;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  #intro-d-masked {
    clip-path: url(#intro-d-clip);
    -webkit-clip-path: url(#intro-d-clip);
  }

  .intro-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.15);
    transition: opacity 0.12s ease-out, transform 0.15s ease-out;
  }

  .intro-slide.active {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  import { animate } from 'motion';

  function playIntroAnimation() {
    const overlay = document.getElementById('intro-overlay');
    const dContainer = document.getElementById('intro-d-container');
    const dSolid = document.getElementById('intro-d-solid');
    const dMasked = document.getElementById('intro-d-masked');
    const pinkCutout = document.getElementById('intro-pink-cutout');
    const cutoutCenter = document.getElementById('intro-cutout-center');
    const cutoutScaler = document.getElementById('intro-cutout-scaler');

    if (!overlay || !dContainer || !dSolid || !dMasked || !pinkCutout || !cutoutCenter || !cutoutScaler) return;

    document.body.style.overflow = 'hidden';

    // 1. D blanca aparece de pequeño a grande
    animate(
      dContainer,
      { opacity: [0, 1], scale: [0.3, 1] },
      { type: 'spring', stiffness: 260, damping: 20, mass: 1 }
    );

    // 2. Transición fluida a fotos de Sobre Nosotros (6 pases continuos)
    setTimeout(() => {
      dMasked.style.opacity = '1';
      dSolid.style.opacity = '0';

      const slides = Array.from(dMasked.querySelectorAll<HTMLImageElement>('.intro-slide'));
      let currentSlide = 0;
      const slideDuration = 180; // ms por cada foto

      const slideInterval = setInterval(() => {
        slides[currentSlide]?.classList.remove('active');
        currentSlide = (currentSlide + 1) % slides.length;
        slides[currentSlide]?.classList.add('active');
      }, slideDuration);

      // 3. FASE 7: Corte exacto de la D mostrando la web y expansión fluida hacia la izquierda
      setTimeout(() => {
        clearInterval(slideInterval);

        // Posición y dimensiones exactas del elemento D en pantalla
        const rect = dContainer.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const initialScale = rect.width / 800;

        cutoutCenter.setAttribute('transform', `translate(${centerX}, ${centerY})`);
        cutoutScaler.setAttribute('transform', `scale(${initialScale}) rotate(0)`);

        // Transición instantánea a la máscara rosa
        overlay.style.backgroundColor = 'transparent';
        pinkCutout.style.opacity = '1';
        dContainer.style.display = 'none';

        // Mantener la D recortada con la página visible durante 0.7s (700ms) antes de expandir
        const pauseDuration = 700; // ms
        setTimeout(() => {
          const duration = 900; // ms
          const startTime = performance.now();

          function stepExpansion(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Curva de aceleración cúbica para salida rápida y contundente
            const ease = Math.pow(progress, 3);
            const currentScale = initialScale + ease * 35;
            const currentRotation = -progress * 25; // Rota 25 grados a la izquierda

            cutoutScaler?.setAttribute(
              'transform',
              `scale(${currentScale}) rotate(${currentRotation})`
            );

            if (progress > 0.6) {
              // Desvanecer el fondo rosa en el tramo final
              const fadeProgress = (progress - 0.6) / 0.4;
              if (pinkCutout) pinkCutout.style.opacity = String(1 - fadeProgress);
            }

            if (progress < 1) {
              requestAnimationFrame(stepExpansion);
            } else {
              if (overlay) overlay.style.display = 'none';
              document.body.style.overflow = '';
            }
          }

          requestAnimationFrame(stepExpansion);
        }, pauseDuration);
      }, slideDuration * slides.length);
    }, 700);
  }

  playIntroAnimation();
</script>
