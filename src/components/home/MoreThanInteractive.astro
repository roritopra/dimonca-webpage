---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import cuchareableNormal from "../../assets/images/cuchareable-more-than.png";
import cuchareableHover from "../../assets/images/cuchareable-more-than-hover.png";
import miniCakeNormal from "../../assets/images/mini-cake-more-than.png";
import miniCakeHover from "../../assets/images/mini-cake-more-than-hover.png";
import cakeNormal from "../../assets/images/cake-more-than.png";
import cakeHover from "../../assets/images/cake-more-than-hover.png";

import moreThan1 from "../../assets/images/more-than-1.png";
import moreThan2 from "../../assets/images/more-than-2.png";
import moreThan3 from "../../assets/images/more-than-3.png";
import moreThan4 from "../../assets/images/more-than-4.png";

const products = [
  {
    normalImg: cuchareableNormal,
    hoverImg: cuchareableHover,
    alt: "Cuchareable de Red Velvet",
  },
  {
    normalImg: miniCakeNormal,
    hoverImg: miniCakeHover,
    alt: "Mini Cake",
  },
  {
    normalImg: cakeNormal,
    hoverImg: cakeHover,
    alt: "Pastel artesanal Dimonca",
  },
];

const gridImages = [
  { src: moreThan1, alt: "Variedad de cuchareables Dimonca", borderColor: "#6ca7d5" },
  { src: moreThan2, alt: "Torre de brownies Dimonca", borderColor: "#3A200E" },
  { src: moreThan3, alt: "Caja de galletas y helados Dimonca", borderColor: "#F45D8C" },
  { src: moreThan4, alt: "Cuchareable personal Dimonca", borderColor: "#979255" },
];
---

<div class="relative flex flex-col md:flex-row items-center justify-center gap-8 xl:gap-6 select-none w-full xl:w-auto shrink-0">
  <!-- Sección Interactiva del Producto Central -->
  <div
    id="more-than-interactive"
    class="relative flex w-full max-w-[340px] sm:max-w-[370px] xl:w-[370px] flex-col items-center justify-center cursor-pointer shrink-0"
  >
    <div class="product-container relative flex h-[340px] sm:h-[400px] xl:h-[430px] w-full items-center justify-center">
      {products.map((item, idx) => (
        <div
          class={`product-slide absolute inset-0 flex items-center justify-center ${
            idx === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"
          }`}
          data-index={idx}
        >
          <!-- Imagen Normal -->
          <Image
            src={item.normalImg}
            alt={item.alt}
            class="product-img-normal block h-full w-auto object-contain drop-shadow-[0px_14px_24px_rgba(58,32,14,0.18)]"
            loading="lazy"
          />
          <!-- Imagen Hover -->
          <Image
            src={item.hoverImg}
            alt={`${item.alt} detalle`}
            class="product-img-hover absolute inset-0 m-auto block h-full w-auto object-contain opacity-0 drop-shadow-[0px_14px_24px_rgba(58,32,14,0.18)]"
            loading="lazy"
          />

        </div>
      ))}

      <!-- Texto flotante estático en estilo script superpuesto permanentemente -->
      <div class="product-title-badge pointer-events-none absolute top-4 sm:top-[40px] xl:top-[55px] -right-2 sm:-right-8 xl:right-[-80px] z-30 max-w-[170px] sm:max-w-[210px]">
        <p
          class="font-exmouth text-[30px] sm:text-[38px] xl:text-[44px] leading-[1.05] text-brown [-webkit-text-stroke:5px_#ffffff] sm:[-webkit-text-stroke:6px_#ffffff] xl:[-webkit-text-stroke:8px_#ffffff] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
          style="paint-order: stroke fill;"
          aria-hidden="true"
        >
          Cuchareable de Red Velvet
        </p>
      </div>

      <!-- Botón flotante inferior izquierdo con corazón -->
      <button
        id="more-than-next-btn"
        type="button"
        class="group absolute bottom-4 sm:bottom-[30px] xl:bottom-[35px] left-2 sm:left-[15px] z-20 flex h-[48px] w-[48px] sm:h-[54px] sm:w-[54px] xl:h-[58px] xl:w-[58px] items-center justify-center rounded-full border-[2.5px] sm:border-[3px] border-white bg-[#6ca7d5] text-white shadow-[0px_8px_16px_rgba(108,167,213,0.4)] transition-transform duration-200 hover:scale-105 hover:bg-[#5b96c4]"
        aria-label="Ver siguiente producto"
      >
        <Icon name="lucide:heart" class="h-5 w-5 sm:h-6 sm:w-6 xl:h-7 xl:w-7 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Grid de 4 imágenes a la derecha (o abajo en móvil) -->
  <div class="grid grid-cols-2 gap-2.5 sm:gap-3.5 w-full max-w-[340px] sm:max-w-[390px] xl:w-[390px] shrink-0">
    {gridImages.map((img) => (
      <div
        class="group relative w-full overflow-hidden rounded-[16px] sm:rounded-none transition-all duration-300 hover:scale-[1.03]"
      >
        <Image
          src={img.src}
          alt={img.alt}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</div>

<script>
  import { animate } from "motion";

  function initMoreThanInteractive() {
    const root = document.getElementById("more-than-interactive");
    if (!root) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>(".product-slide"));
    const nextBtn = document.getElementById("more-than-next-btn");
    let currentIndex = 0;
    let isHovered = false;

    // Control de hover para cada slide
    slides.forEach((slide) => {
      const normal = slide.querySelector<HTMLElement>(".product-img-normal");
      const hover = slide.querySelector<HTMLElement>(".product-img-hover");

      if (normal && hover) {
        slide.addEventListener("mouseenter", () => {
          isHovered = true;
          animate(normal, { opacity: 0 }, { duration: 0.2, ease: "easeOut" });
          animate(hover, { opacity: 1 }, { duration: 0.2, ease: "easeOut" });
        });

        slide.addEventListener("mouseleave", () => {
          isHovered = false;
          animate(normal, { opacity: 1 }, { duration: 0.2, ease: "easeInOut" });
          animate(hover, { opacity: 0 }, { duration: 0.2, ease: "easeInOut" });
        });
      }
    });

    // Cambio de producto al hacer click (crossfade limpio)
    const nextProduct = () => {
      if (slides.length <= 1) return;

      const prevIndex = currentIndex;
      currentIndex = (currentIndex + 1) % slides.length;

      const prevSlide = slides[prevIndex];
      const nextSlide = slides[currentIndex];

      if (prevSlide && nextSlide) {
        const nextNormal = nextSlide.querySelector<HTMLElement>(".product-img-normal");
        const nextHover = nextSlide.querySelector<HTMLElement>(".product-img-hover");

        if (nextNormal && nextHover) {
          if (isHovered) {
            nextNormal.style.opacity = "0";
            nextHover.style.opacity = "1";
          } else {
            nextNormal.style.opacity = "1";
            nextHover.style.opacity = "0";
          }
        }

        animate(prevSlide, { opacity: 0 }, { duration: 0.2, ease: "easeInOut" }).then(() => {
          prevSlide.style.pointerEvents = "none";
        });

        nextSlide.style.pointerEvents = "auto";
        animate(nextSlide, { opacity: [0, 1] }, { duration: 0.2, ease: "easeInOut" });
      }
    };

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      nextProduct();
    });

    root.addEventListener("click", nextProduct);
  }

  document.addEventListener("astro:page-load", initMoreThanInteractive);
</script>