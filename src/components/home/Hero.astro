---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import creamHero from '../../assets/images/home/hero/hero-cream.png';
import cookieHero from '../../assets/images/home/hero/hero-cookie.png';
import crookieHero from '../../assets/images/home/hero/hero-crookie.png';
import crookieHeroSplit from '../../assets/images/home/hero/hero-crookie-split.png';

const stripes = Array.from({ length: 24 }, (_, i) => ({
	left: (i * (62.1 / 1440)) * 100,
	width: (31 / 1440) * 100,
	up: i % 2 === 0,
}));

// Set móvil: menos rayas (12) y más gruesas, como el diseño (~11 visibles).
// En pantallas angostas las 24 de desktop se ven finitas y apretadas.
const stripesMobile = Array.from({ length: 12 }, (_, i) => ({
	left: i * (100 / 12),
	width: 4,
	up: i % 2 === 0,
}));

const slidesData = [
	{
		id: 'hero-slide-1',
		bgClass: 'bg-brown-400',
		stripeBg: 'bg-[#89796e]',
		titleWord1: 'Galleta',
		titleWord2: 'Habibi',
		titleTextColor: 'text-pink-200',
		titleStroke: '[-webkit-text-stroke:6px_#614d3e] sm:[-webkit-text-stroke:10px_#614d3e] xl:[-webkit-text-stroke:15px_#614d3e]',
		cookieWrapClass: 'top-[125px] sm:top-[80px] xl:top-[52.08px] left-1/2 -translate-x-1/2 xl:left-[382.25px] xl:translate-x-0 h-[370px] w-[370px] sm:h-[460px] sm:w-[460px] md:h-[520px] md:w-[520px] xl:h-[650px] xl:w-[650px]',
		cookieWidthClass: 'w-[370px] sm:w-[460px] md:w-[520px] xl:w-[650px]',
		cookieNormalImg: creamHero,
		cookieHoverImg: cookieHero,
		cookieAlt: 'Galleta Habibi con crema de pistacho',
		cookieHoverAlt: 'Galleta Habibi partida mostrando relleno artesanal de pistacho',
		starWrapClass: 'top-[125px] right-4 sm:right-6 md:right-10 xl:right-auto xl:top-[186.68px] xl:left-200 h-[160px] w-[160px] sm:h-[195px] sm:w-[195px] md:h-[220px] md:w-[220px] xl:h-[279.66px] xl:w-[282.03px]',
		starImg: '/images/home/hero/star.svg',
		starTextClass: 'text-[17px] sm:text-[20px] xl:text-[27px] text-brown [-webkit-text-stroke:3px_#F7F2E8] xl:[-webkit-text-stroke:5px_#F7F2E8]',
		infoTitle: 'Galleta Habibi',
		infoTitleStroke: 'text-beige [-webkit-text-stroke:8px_#614d3e]',
		infoDesc: 'Galleta de chocolate tipo brownie, rellena con una exquisita crema de pistacho artesanal. Un postre al mejor estilo Dubai.',
		infoDescStroke: 'text-beige [-webkit-text-stroke:8px_#614d3e]',
	},
	{
		id: 'hero-slide-2',
		bgClass: 'bg-blue-500',
		stripeBg: 'bg-[#d7ebfb]',
		titleWord1: 'Crookie',
		titleWord2: 'Chips',
		titleTextColor: 'text-pink',
		titleStroke: '[-webkit-text-stroke:6px_#f7f2e8] sm:[-webkit-text-stroke:10px_#f7f2e8] xl:[-webkit-text-stroke:15px_#f7f2e8]',
		cookieWrapClass: 'top-[115px] sm:top-[60px] xl:top-[17.08px] left-1/2 -translate-x-1/2 xl:left-[347.25px] xl:translate-x-0 h-[390px] w-[390px] sm:h-[490px] sm:w-[490px] md:h-[560px] md:w-[560px] xl:h-[720px] xl:w-[720px]',
		cookieWidthClass: 'w-[390px] sm:w-[490px] md:w-[560px] xl:w-[720px]',
		cookieNormalImg: crookieHero,
		cookieHoverImg: crookieHeroSplit,
		cookieAlt: 'Crookie Chips con relleno de nutella',
		cookieHoverAlt: 'Crookie partido con centro cremoso de nutella',
		starWrapClass: 'top-[125px] right-4 sm:right-6 md:right-10 xl:right-auto xl:top-[186.68px] xl:left-200 h-[170px] w-[170px] sm:h-[210px] sm:w-[210px] md:h-[240px] md:w-[240px] xl:h-[311px] xl:w-[314px]',
		starImg: '/images/home/hero/star-2.svg',
		starTextClass: 'text-[18px] sm:text-[22px] xl:text-[30px] text-white',
		infoTitle: 'Crookie Chips',
		infoTitleStroke: 'text-brown [-webkit-text-stroke:8px_#9ACCF4]',
		infoDesc: 'Croissant + galleta de chips de chocolate + relleno de nutella. Hojaldrado, super crocante y con un centro cremoso de chocolate.',
		infoDescStroke: 'text-brown-600 [-webkit-text-stroke:8px_#9ACCF4]',
	},
];
---

<section class="sticky top-0 z-0 h-screen min-h-[660px] max-h-[760px] sm:max-h-[920px] w-full overflow-hidden bg-brown-400">
	<div id="hero-carousel" class="absolute inset-0">
		{
			slidesData.map((slide, idx) => (
				<div
					id={slide.id}
					class={`hero-slide absolute inset-0 ${slide.bgClass} transition-opacity duration-300`}
					data-slide={idx}
					style={idx !== 0 ? 'opacity: 0; visibility: hidden; pointer-events: none;' : ''}
				>
					<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
						{stripesMobile.map((s) => (
							<div
								class={`hero-stripe absolute top-0 bottom-0 sm:hidden ${slide.stripeBg}`}
								style={`left: ${s.left}%; width: ${s.width}%;`}
								data-dir={s.up ? 'up' : 'down'}
							/>
						))}
						{stripes.map((s) => (
							<div
								class={`hero-stripe absolute top-0 bottom-0 hidden sm:block ${slide.stripeBg}`}
								style={`left: ${s.left}%; width: ${s.width}%;`}
								data-dir={s.up ? 'up' : 'down'}
							/>
						))}
					</div>

					<div class="hero-stage-wrapper absolute inset-0 flex items-center justify-center">
						<div
							class="hero-content relative h-[660px] w-full max-w-[420px] sm:h-[700px] sm:max-w-[600px] xl:h-[775px] xl:w-[1440px] xl:max-w-none"
						>
							<!-- Halo de brillo detrás de la galleta (hecho en código, como en Combos):
								círculo blanco con blur y blend overlay. En cada breakpoint su centro
								coincide con el centro de la galleta y es un poco más grande que ella. -->
							<div class="pointer-events-none absolute top-[100px] sm:top-[40px] xl:top-[-13px] left-1/2 -translate-x-1/2 xl:left-[317px] xl:translate-x-0 h-[420px] w-[420px] sm:h-[540px] sm:w-[540px] xl:h-[780px] xl:w-[780px] rounded-full bg-white/30 mix-blend-overlay blur-[40px] sm:blur-[60px] xl:blur-[80px]" aria-hidden="true">
							</div>

							<!-- Palabra 1: en móvil centrada arriba de la galleta; en sm+ vuelve a la izquierda -->
							<p
								class={`pointer-events-none absolute top-12 sm:top-14 xl:top-[33.68px] left-1/2 -translate-x-1/2 
									sm:left-8 sm:translate-x-0 xl:left-[157.8px] z-1 font-script text-[135px] sm:text-[120px] 
									md:text-[150px] xl:text-[203.79px] leading-none whitespace-nowrap 
									${slide.titleTextColor}`}
								aria-hidden="true"
							>
								<span
									class={`hero-title-word font-exmouth inline-block ${slide.titleStroke}`}
									style="paint-order: stroke"
									data-dir="left"
								>
									{slide.titleWord1}
								</span>
							</p>

							<!-- Palabra 2: en móvil centrada debajo de la galleta; en sm+ vuelve a la derecha -->
							<p
								class={`pointer-events-none absolute bottom-[100px] sm:bottom-[135px] xl:bottom-auto 
									xl:top-[33.68px] left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:right-8 xl:right-auto xl:left-[1252.2px] 
									z-1 xl:w-[502.2px] xl:-translate-x-full text-center sm:text-right font-script text-[135px] 
									sm:text-[120px] md:text-[150px] xl:text-[203.79px] leading-none whitespace-nowrap 
									${slide.titleTextColor}`}
								aria-hidden="true"
							>
								<span
									class={`hero-title-word font-exmouth inline-block ${slide.titleStroke}`}
									style="paint-order: stroke"
									data-dir="right"
								>
									{slide.titleWord2}
								</span>
							</p>

							<!-- Galleta interactiva -->
							<div class={`hero-cookie-interactive absolute z-2 ${slide.cookieWrapClass}`}>
								<div class="hero-cookie-left absolute inset-y-0 left-0 w-1/2 overflow-hidden">
									<Image
										class={`absolute top-0 left-0 h-full max-w-none object-cover ${slide.cookieWidthClass}`}
										src={slide.cookieNormalImg}
										alt={slide.cookieAlt}
										loading="eager"
										decoding="sync"
									/>
								</div>
								<div class="hero-cookie-right absolute inset-y-0 right-0 w-1/2 overflow-hidden">
									<Image
										class={`absolute top-0 right-0 h-full max-w-none object-cover ${slide.cookieWidthClass}`}
										src={slide.cookieNormalImg}
										alt={slide.cookieAlt}
										loading="eager"
										decoding="sync"
									/>
								</div>
								<Image
									class="hero-cookie-cracked pointer-events-none absolute inset-0 h-full w-full object-cover"
									style="opacity: 0;"
									src={slide.cookieHoverImg}
									alt={slide.cookieHoverAlt}
									loading="eager"
									decoding="sync"
								/>
							</div>

							<!-- Estrella Nueva: el SVG tiene su centro visual desplazado (~+5% X, ~-4.5% Y
								respecto al centro del viewBox), por eso el texto se ancla en 55% / 45.5%
								en vez de 50% / 50% para quedar ópticamente centrado en todos los breakpoints.
								Solo el <img> rota (hero-star-img) alrededor del centro visual de la estrella,
								que coincide con el texto: la estrella gira y "Nueva" queda quieta.
								El giro es continuo con aceleración/desaceleración (ver SPIN_* en el script). -->
							<div class={`hero-star-interactive absolute z-3 ${slide.starWrapClass}`}>
								<img class="hero-star-img block h-full w-full object-contain will-change-transform" src={slide.starImg} alt="" aria-hidden="true" style="transform-origin: 55% 45.5%;" />
								<span
									class={`absolute top-[45.5%] left-[55%] -translate-x-1/2 -translate-y-1/2 font-sans font-bold whitespace-nowrap text-center leading-[1.2] ${slide.starTextClass}`}
									style="paint-order: stroke;"
								>
									Nueva
								</span>
							</div>

							<!-- Info lateral (solo visible en desktop xl+) -->
							<div class="hero-left-info hidden xl:block absolute top-[310.9px] left-53.5 z-3 w-60.75">
								<h1
									class={`mb-3 font-sans text-[38px] leading-[1.2] font-bold ${slide.infoTitleStroke}`}
									style="paint-order: stroke"
								>
									{slide.infoTitle}
								</h1>
								<p
									class={`font-sans text-[21.6px] leading-[1.2] ${slide.infoDescStroke}`}
									style="paint-order: stroke"
								>
									{slide.infoDesc}
								</p>
							</div>
						</div>
					</div>
				</div>
			))
		}
	</div>

	<!-- Capa compartida: botones del carrusel y Ver menú -->
	<div class="hero-stage-wrapper pointer-events-none absolute inset-0 z-10 flex items-center justify-center">
		<div
			class="relative h-[660px] w-full max-w-[420px] sm:h-[700px] sm:max-w-[600px] xl:h-[775px] xl:w-[1440px] xl:max-w-none"
		>
			<a
				id="hero-menu-btn"
				class="pointer-events-auto absolute bottom-4 sm:bottom-6 xl:bottom-auto xl:top-164.5 left-1/2 -translate-x-1/2 xl:translate-x-0 xl:left-148.75 z-3 flex h-11 sm:h-12 xl:h-12.25 w-[180px] sm:w-[200px] xl:w-[218.1px] items-center justify-center gap-2 whitespace-nowrap rounded-[57px] bg-pink px-4 py-2 font-sans text-[16px] sm:text-[18px] xl:text-[19px] leading-[1.2] font-bold text-beige no-underline shadow-lg hover:brightness-95"
				href="#menu"
			>
				Ver menú
				<span class="flex h-7 w-7 sm:h-8 sm:w-8 shrink-0 items-center justify-center rounded-[22.68px] bg-beige p-1 sm:p-[6.67px]">
					<img class="block h-3.5 w-3.5 sm:h-[16.01px] sm:w-[16.01px]" src="/images/shared/chef-hat.svg" alt="" aria-hidden="true" />
				</span>
			</a>

			<button
				id="hero-prev"
				class="pointer-events-auto absolute top-[46%] -translate-y-1/2 left-3 sm:left-6 xl:translate-y-0 xl:top-83 xl:left-23.75 z-4 flex h-10 w-10 sm:h-16 sm:w-16 xl:h-20 xl:w-20 cursor-pointer items-center justify-center rounded-full border-2 sm:border-[3px] border-white bg-pink text-beige shadow-md hover:brightness-95"
				type="button"
				aria-label="Ver postre anterior"
			>
				<Icon name="lucide:chevron-left" class="h-5 w-5 sm:h-8 sm:w-8 xl:h-10 xl:w-10 shrink-0" aria-hidden="true" />
			</button>
			<button
				id="hero-next"
				class="pointer-events-auto absolute top-[46%] -translate-y-1/2 right-3 sm:right-6 xl:translate-y-0 xl:right-auto xl:top-[268.13px] xl:left-[1219.13px] z-4 flex h-10 w-10 sm:h-16 sm:w-16 xl:h-20 xl:w-20 cursor-pointer items-center justify-center rounded-full border-2 sm:border-[3px] border-white bg-pink text-beige shadow-md hover:brightness-95"
				type="button"
				aria-label="Ver postre siguiente"
			>
				<Icon name="lucide:chevron-right" class="h-5 w-5 sm:h-8 sm:w-8 xl:h-10 xl:w-10 shrink-0" aria-hidden="true" />
			</button>
		</div>
	</div>
</section>

<script>
	import { animate } from 'motion';

	const carousel = document.getElementById('hero-carousel');
	const slides = carousel ? Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]')) : [];
	const prevBtn = document.getElementById('hero-prev');
	const nextBtn = document.getElementById('hero-next');

	const EXIT_MS = 600;
	const PAUSE_MS = 200;
	const ENTER_MS = 600;

	let current = 0;
	let transitioning = false;

	let hoverTimeout: ReturnType<typeof setTimeout> | null = null;

	// --- Giro continuo de la estrella con aceleración / desaceleración ---
	// Mientras el mouse está sobre la estrella, el SVG acelera de 0 hasta SPIN_MAX
	// (deg/s); al quitarlo, desacelera suavemente hasta detenerse. Al ser una
	// velocidad que persigue un objetivo en vez de un salto fijo, entrar/salir
	// rápido del hover se siente como pisar/soltar pedal, sin cortes toscos.
	const SPIN_MAX = 200; // velocidad máxima del giro (grados/segundo)
	const SPIN_ACCEL_K = 3.2; // qué tan rápido acelera (mayor = llega antes al máximo)
	const SPIN_DECEL_K = 1.6; // qué tan rápido frena (menor = cola de frenado más larga)
	const SPIN_STOP_EPS = 0.6; // por debajo de esta velocidad se considera detenido

	type SpinState = {
		angle: number;
		vel: number;
		target: number;
		scroll: number;
		raf: number | null;
		last: number;
		img: HTMLElement | null;
	};
	const spinStates = new WeakMap<HTMLElement, SpinState>();

	function getSpin(slideEl: HTMLElement): SpinState {
		let st = spinStates.get(slideEl);
		if (!st) {
			st = { angle: 0, vel: 0, target: 0, scroll: 0, raf: null, last: 0, img: null };
			spinStates.set(slideEl, st);
		}
		if (!st.img) st.img = slideEl.querySelector<HTMLElement>('.hero-star-img');
		return st;
	}

	function renderSpin(slideEl: HTMLElement, st: SpinState) {
		if (!st.img) st.img = slideEl.querySelector<HTMLElement>('.hero-star-img');
		if (st.img) st.img.style.transform = `rotate(${st.angle + st.scroll}deg)`;
	}

	function spinTick(slideEl: HTMLElement, st: SpinState, now: number) {
		const dt = Math.min(Math.max((now - st.last) / 1000, 0), 0.05);
		st.last = now;
		const k = st.target > 0 ? SPIN_ACCEL_K : SPIN_DECEL_K;
		st.vel += (st.target - st.vel) * (1 - Math.exp(-k * dt));
		if (st.target === 0 && Math.abs(st.vel) < SPIN_STOP_EPS) {
			st.vel = 0;
			st.raf = null;
			renderSpin(slideEl, st);
			return;
		}
		st.angle = (st.angle + st.vel * dt) % 360;
		renderSpin(slideEl, st);
		st.raf = requestAnimationFrame((t) => spinTick(slideEl, st, t));
	}

	function ensureSpin(slideEl: HTMLElement, st: SpinState) {
		if (st.raf !== null) return;
		st.last = performance.now();
		st.raf = requestAnimationFrame((t) => spinTick(slideEl, st, t));
	}

	function setSpinTarget(slideEl: HTMLElement, target: number) {
		const st = getSpin(slideEl);
		st.target = target;
		if (target > 0 || Math.abs(st.vel) > 0) ensureSpin(slideEl, st);
	}

	function stopSpinHard(slideEl: HTMLElement) {
		const st = getSpin(slideEl);
		st.target = 0;
		st.vel = 0;
		if (st.raf !== null) {
			cancelAnimationFrame(st.raf);
			st.raf = null;
		}
	}

	// --- Lectura del estado visual real ---
	// El handler de scroll escribe transform/opacity directo en el DOM, mientras
	// que `motion` recuerda el último valor que ÉL animó. Al volver del scroll,
	// esa caché queda stale y el siguiente animate() de un solo objetivo arranca
	// desde un valor falso (= pop instantáneo). Leyendo el computed style y
	// animando con keyframes explícitos [real, objetivo], el inicio siempre es el correcto.
	function readBox(el: HTMLElement | null) {
		if (!el) return { x: 0, y: 0, rot: 0, sc: 1, op: 1 };
		const cs = getComputedStyle(el);
		let x = 0;
		let y = 0;
		let rot = 0;
		let sc = 1;
		if (cs.transform && cs.transform !== 'none') {
			try {
				const m = new DOMMatrixReadOnly(cs.transform);
				x = m.e;
				y = m.f;
				rot = (Math.atan2(m.b, m.a) * 180) / Math.PI;
				sc = Math.hypot(m.a, m.b) || 1;
			} catch {
				// Si el navegador no parsea la matriz, se usan los valores identidad.
			}
		}
		const op = Number.parseFloat(cs.opacity);
		return { x, y, rot, sc, op: Number.isFinite(op) ? op : 1 };
	}

	function resetHoverState(slideEl: HTMLElement) {
		if (hoverTimeout) {
			clearTimeout(hoverTimeout);
			hoverTimeout = null;
		}
		const cookie = slideEl.querySelector<HTMLElement>('.hero-cookie-interactive');
		const star = slideEl.querySelector<HTMLElement>('.hero-star-interactive');
		const leftHalf = slideEl.querySelector<HTMLElement>('.hero-cookie-left');
		const rightHalf = slideEl.querySelector<HTMLElement>('.hero-cookie-right');
		const cracked = slideEl.querySelector<HTMLElement>('.hero-cookie-cracked');

		if (window.scrollY <= 5 && cookie) {
			// Keyframes desde el valor real del DOM: inmunes a caché stale de motion tras el scroll.
			const cb = readBox(cookie);
			animate(cookie, { rotate: [cb.rot, 0], scale: [cb.sc, 1] }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
			// Solo la estrella rota (vía el loop de giro); el contenedor solo recupera escala.
			if (star) {
				const sb = readBox(star);
				animate(star, { scale: [sb.sc, 1] }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
			}
		}
		if (leftHalf) {
			animate(leftHalf, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		}
		if (rightHalf) {
			animate(rightHalf, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		}
		if (cracked) {
			animate(cracked, { opacity: 0 }, { duration: 0.2, ease: 'easeInOut' });
		}
	}

	function startHoverState(slideEl: HTMLElement) {
		if (window.scrollY > 5 || hoverTimeout) return;
		const cookie = slideEl.querySelector<HTMLElement>('.hero-cookie-interactive');
		const star = slideEl.querySelector<HTMLElement>('.hero-star-interactive');
		const leftHalf = slideEl.querySelector<HTMLElement>('.hero-cookie-left');
		const rightHalf = slideEl.querySelector<HTMLElement>('.hero-cookie-right');
		const cracked = slideEl.querySelector<HTMLElement>('.hero-cookie-cracked');

		if (!cookie || !leftHalf || !rightHalf || !cracked) return;

		const slide = (cookie.offsetWidth / 600) * 2.5;
		// Keyframes desde el valor real del DOM: inmunes a caché stale de motion tras el scroll.
		const cb0 = readBox(cookie);
		animate(cookie, { rotate: [cb0.rot, -10] }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		// El giro continuo lo maneja el loop (setSpinTarget); aquí solo el pop de escala.
		if (star) {
			const sb0 = readBox(star);
			animate(star, { scale: [sb0.sc, 1.08] }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		}
		animate(leftHalf, { x: -slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		animate(rightHalf, { x: slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });

		hoverTimeout = setTimeout(() => {
			if (window.scrollY > 5) {
				resetHoverState(slideEl);
				return;
			}
			animate(cracked, { opacity: 1 }, { duration: 0.1, ease: 'easeOut' });
			animate(leftHalf, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
			animate(rightHalf, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
			const cb1 = readBox(cookie);
			animate(cookie, { scale: [cb1.sc, 1.08] }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		}, 50);
	}

	// Hover unificado: galleta y estrella comparten la misma interacción. Entrar a
	// CUALQUIERA de las dos arranca ambos efectos (split de la galleta + giro
	// continuo de la estrella); salir de AMBAS los detiene (el giro desacelera,
	// no para en seco). Galleta y estrella son hermanos con cajas que se solapan
	// (la estrella va encima, z-3 sobre z-2): al cruzar de una a otra el navegador
	// dispara mouseleave en una y mouseenter en la otra aunque el puntero nunca
	// salió de la zona. Sin el chequeo de relatedTarget eso reiniciaba el hover
	// (flicker: se desarma y se rearma la partida). Por eso solo se resetea al
	// salir de ambas; al pasar entre ellas todo se mantiene andando.
	slides.forEach((slideEl) => {
		const cookie = slideEl.querySelector<HTMLElement>('.hero-cookie-interactive');
		const star = slideEl.querySelector<HTMLElement>('.hero-star-interactive');
		const insideInteractive = (n: EventTarget | null) =>
			n instanceof Node && ((cookie?.contains(n) ?? false) || (star?.contains(n) ?? false));
		const spinOn = () => {
			if (window.scrollY <= 5) setSpinTarget(slideEl, SPIN_MAX);
		};

		cookie?.addEventListener('mouseenter', () => {
			startHoverState(slideEl);
			spinOn();
		});
		cookie?.addEventListener('mouseleave', (e: MouseEvent) => {
			if (insideInteractive(e.relatedTarget)) return; // va hacia la estrella: todo sigue
			resetHoverState(slideEl);
			setSpinTarget(slideEl, 0);
		});
		star?.addEventListener('mouseenter', () => {
			startHoverState(slideEl);
			spinOn();
		});
		star?.addEventListener('mouseleave', (e: MouseEvent) => {
			if (insideInteractive(e.relatedTarget)) return; // va hacia la galleta: todo sigue
			resetHoverState(slideEl);
			setSpinTarget(slideEl, 0);
		});
	});

	function goTo(index: number) {
		if (transitioning || index === current || !slides[index]) return;
		transitioning = true;

		const from = slides[current];
		const to = slides[index];

		resetHoverState(from);

		const fromLeftInfo = from.querySelector<HTMLElement>('.hero-left-info');
		const toLeftInfo = to.querySelector<HTMLElement>('.hero-left-info');
		const fromCookieImg = from.querySelector<HTMLElement>('.hero-cookie-interactive');
		const toCookieImg = to.querySelector<HTMLElement>('.hero-cookie-interactive');
		const fromStar = from.querySelector<HTMLElement>('.hero-star-interactive');
		const toStar = to.querySelector<HTMLElement>('.hero-star-interactive');
		const fromStarImg = from.querySelector<HTMLElement>('.hero-star-img');
		const toStarImg = to.querySelector<HTMLElement>('.hero-star-img');
		// Congelar el giro durante la transición (el fundido oculta el cambio);
		// el ángulo se conserva para no dar saltos al volver al slide.
		const fromSpin = getSpin(from);
		const toSpin = getSpin(to);
		stopSpinHard(from);
		stopSpinHard(to);
		const fromStripes = Array.from(from.querySelectorAll<HTMLElement>('.hero-stripe'));
		const toStripes = Array.from(to.querySelectorAll<HTMLElement>('.hero-stripe'));
		const fromTitles = Array.from(from.querySelectorAll<HTMLElement>('.hero-title-word'));
		const toTitles = Array.from(to.querySelectorAll<HTMLElement>('.hero-title-word'));
		const travel = from.offsetHeight;

		fromStripes.forEach((stripe) => {
			const dir = stripe.dataset.dir === 'up' ? -1 : 1;
			const b = readBox(stripe);
			animate(
				stripe,
				{ y: [b.y, dir * travel], opacity: [b.op, 0] },
				{ duration: EXIT_MS / 1000, ease: 'easeInOut' }
			);
		});

		fromTitles.forEach((word) => {
			const isLeft = word.dataset.dir === 'left';
			const targetX = isLeft ? -150 : 150;
			const b = readBox(word);
			animate(
				word,
				{ x: [b.x, targetX], opacity: [b.op, 0] },
				{ duration: EXIT_MS / 1000, ease: 'easeInOut' }
			);
		});

		if (fromLeftInfo) {
			const b = readBox(fromLeftInfo);
			animate(
				fromLeftInfo,
				{ x: [b.x, -120], opacity: [b.op, 0] },
				{ duration: EXIT_MS / 1000, ease: 'easeInOut' }
			);
		}

		if (fromCookieImg) {
			const b = readBox(fromCookieImg);
			animate(
				fromCookieImg,
				{ opacity: [b.op, 0], scale: [b.sc, 0.8], rotate: [b.rot, -25] },
				{ duration: EXIT_MS / 1000, ease: 'backIn' }
			);
		}

		if (fromStar) {
			const b = readBox(fromStar);
			animate(
				fromStar,
				{ opacity: [b.op, 0], scale: [b.sc, 0.85], y: [b.y, 24] },
				{ duration: EXIT_MS / 1000, ease: 'backIn' }
			);
		}
		if (fromStarImg) {
			// Giro relativo al ángulo actual: sin saltos aunque la estrella quedara girada.
			const total = fromSpin.angle + fromSpin.scroll;
			animate(fromStarImg, { rotate: [total, total - 45] }, { duration: EXIT_MS / 1000, ease: 'backIn' });
		}

		setTimeout(() => {
			animate(from, { opacity: 0 }, { duration: 0.3, ease: 'easeInOut' }).then(() => {
				from.style.visibility = 'hidden';
				from.style.pointerEvents = 'none';
			});

			to.style.visibility = 'visible';
			to.style.pointerEvents = 'auto';
			animate(to, { opacity: [0, 1] }, { duration: 0.4, ease: 'easeInOut' });

			toStripes.forEach((stripe) => {
				const dir = stripe.dataset.dir === 'up' ? -1 : 1;
				animate(
					stripe,
					{ y: [dir * travel, 0], opacity: [0, 1] },
					{ duration: ENTER_MS / 1000, ease: 'easeInOut' }
				);
			});
			toTitles.forEach((word) => {
				const isLeft = word.dataset.dir === 'left';
				const startX = isLeft ? -150 : 150;
				animate(
					word,
					{ x: [startX, 0], opacity: [0, 1] },
					{ duration: ENTER_MS / 1000, ease: 'easeOut' }
				);
			});
			if (toLeftInfo) {
				animate(
					toLeftInfo,
					{ x: [-120, 0], opacity: [0, 1] },
					{ duration: ENTER_MS / 1000, ease: 'easeOut' }
				);
			}
			if (toCookieImg) {
				animate(
					toCookieImg,
					{ opacity: [0, 1], scale: [0.8, 1], rotate: [25, 0] },
					{ duration: ENTER_MS / 1000, ease: 'backOut' }
				);
			}
			if (toStar) {
				animate(
					toStar,
					{ opacity: [0, 1], scale: [0.9, 1], y: [-16, 0] },
					{ duration: ENTER_MS / 1000, ease: 'backOut' }
				);
			}
			if (toStarImg) {
				const total = toSpin.angle + toSpin.scroll;
				animate(toStarImg, { rotate: [total + 45, total] }, { duration: ENTER_MS / 1000, ease: 'backOut' });
			}
			transitioning = false;
		}, EXIT_MS + PAUSE_MS);

		current = index;
	}

	prevBtn?.addEventListener('click', () => goTo(current === 0 ? slides.length - 1 : current - 1));
	nextBtn?.addEventListener('click', () => goTo(current === slides.length - 1 ? 0 : current + 1));

	// --- Animación de entrada inicial: misma coreografía que el ENTER del carrusel ---
	// Cuando la página abre por primera vez (tras el Intro), el slide visible entra
	// con los mismos valores del "to" en goTo(): rayas barriendo, títulos desde ±150,
	// info desde -120, galleta scale 0.8/rotate 25 backOut, estrella scale/y backOut,
	// starImg rotate +45 -> ángulo actual. Así la entrada se siente como "bum, entra
	// el otro" igual que al pulsar prev/next hacia Crookie Chips.
	function playHeroEnter() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const carouselEl = document.getElementById('hero-carousel');
		// Re-query fresco: tras View Transitions el DOM se reemplaza y `slides` queda stale.
		const fresh = carouselEl ? Array.from(carouselEl.querySelectorAll<HTMLElement>('[data-slide]')) : slides;
		const to = fresh[current] ?? fresh[0];
		if (!to) return;
		const travel = to.offsetHeight || window.innerHeight;
		const toSpin = getSpin(to);

		to.style.visibility = 'visible';
		to.style.pointerEvents = 'auto';
		animate(to, { opacity: [0, 1] }, { duration: 0.4, ease: 'easeInOut' });

		const toStripes = Array.from(to.querySelectorAll<HTMLElement>('.hero-stripe'));
		toStripes.forEach((stripe) => {
			const dir = stripe.dataset.dir === 'up' ? -1 : 1;
			animate(
				stripe,
				{ y: [dir * travel, 0], opacity: [0, 1] },
				{ duration: ENTER_MS / 1000, ease: 'easeInOut' }
			);
		});
		const toTitles = Array.from(to.querySelectorAll<HTMLElement>('.hero-title-word'));
		toTitles.forEach((word) => {
			const isLeft = word.dataset.dir === 'left';
			const startX = isLeft ? -150 : 150;
			animate(
				word,
				{ x: [startX, 0], opacity: [0, 1] },
				{ duration: ENTER_MS / 1000, ease: 'easeOut' }
			);
		});
		const toLeftInfo = to.querySelector<HTMLElement>('.hero-left-info');
		if (toLeftInfo) {
			animate(
				toLeftInfo,
				{ x: [-120, 0], opacity: [0, 1] },
				{ duration: ENTER_MS / 1000, ease: 'easeOut' }
			);
		}
		const toCookieImg = to.querySelector<HTMLElement>('.hero-cookie-interactive');
		if (toCookieImg) {
			animate(
				toCookieImg,
				{ opacity: [0, 1], scale: [0.8, 1], rotate: [25, 0] },
				{ duration: ENTER_MS / 1000, ease: 'backOut' }
			);
		}
		const toStar = to.querySelector<HTMLElement>('.hero-star-interactive');
		if (toStar) {
			animate(
				toStar,
				{ opacity: [0, 1], scale: [0.9, 1], y: [-16, 0] },
				{ duration: ENTER_MS / 1000, ease: 'backOut' }
			);
		}
		const toStarImg = to.querySelector<HTMLElement>('.hero-star-img');
		if (toStarImg) {
			const total = toSpin.angle + toSpin.scroll;
			animate(toStarImg, { rotate: [total + 45, total] }, { duration: ENTER_MS / 1000, ease: 'backOut' });
		}
	}

	function scheduleHeroEnter() {
		const overlay = document.getElementById('intro-overlay');
		const introPending =
			overlay !== null &&
			overlay.style.display !== 'none' &&
			sessionStorage.getItem('dimonca_intro_played') !== '1';
		if (!introPending) {
			// Sin intro (ya vista o sin overlay): entrar casi de inmediato.
			setTimeout(playHeroEnter, 80);
		} else {
			// Con intro: esperar a que termine la cortina de la D.
			window.addEventListener('dimonca:intro-done', () => setTimeout(playHeroEnter, 50), { once: true });
		}
	}

	scheduleHeroEnter();
	document.addEventListener('astro:page-load', scheduleHeroEnter);

	// Animación de scroll: zoom en el título, rotación continua y fade out de UI
	const heroSection = document.querySelector('section.sticky');
	if (heroSection) {
		function handleScrollAnimation() {
			const scrollY = window.scrollY;
			const maxScroll = 450;
			const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

			const currentSlideEl = slides[current];
			if (!currentSlideEl) return;

			if (scrollY > 5) {
				// Si había hover activo, deshacerlo con la misma animación suave del
				// mouseleave (las mitades se juntan, el cracked se desvanece) en vez
				// de quitarlo de golpe. resetHoverState limpia el timeout pendiente y
				// anima mitades/cracked; como hoverTimeout queda en null, esto corre
				// una sola vez al cruzar el umbral aunque el scroll siga disparando.
				if (hoverTimeout) {
					resetHoverState(currentSlideEl);
				}
				// Al hacer scroll el giro continuo frena solo (desacelera, no para en seco).
				const spinSt = getSpin(currentSlideEl);
				if (spinSt.target !== 0) spinSt.target = 0;
			}

			const titles = currentSlideEl.querySelectorAll<HTMLElement>('.hero-title-word');
			const cookieEl = currentSlideEl.querySelector<HTMLElement>('.hero-cookie-interactive');
			const starEl = currentSlideEl.querySelector<HTMLElement>('.hero-star-interactive');
			const infoEl = currentSlideEl.querySelector<HTMLElement>('.hero-left-info');

			const scaleTitle = 1 + progress * (current === 0 ? 0.16 : 0.22);
			titles.forEach((title) => {
				const isLeft = title.dataset.dir === 'left';
				const separateX = isLeft ? -progress * 35 : progress * 35;
				title.style.transform = `translateX(${separateX}px) scale(${scaleTitle})`;
				title.style.transformOrigin = isLeft ? 'left center' : 'right center';
			});

			if (cookieEl) {
				const cookieScale = 1 + progress * 0.22;
				const cookieRotate = scrollY * 0.12 * (current === 0 ? -1 : 1);
				cookieEl.style.transform = `scale(${cookieScale}) rotate(${cookieRotate}deg)`;
				cookieEl.style.filter = `drop-shadow(0px ${15 + progress * 25}px ${25 + progress * 20}px rgba(58,32,14,${0.25 + progress * 0.2}))`;
				cookieEl.style.opacity = '1';
			}

			if (starEl) {
				const starRotate = scrollY * 0.35;
				const starScale = 1 + progress * 0.28;
				const starX = progress * 25;
				const starY = -progress * 20;
				// El contenedor se desplaza/escala (arrastra al texto sin rotarlo);
				// el scroll aporta su ángulo y el loop de giro suma el suyo.
				starEl.style.transform = `translate(${starX}px, ${starY}px) scale(${starScale})`;
				starEl.style.opacity = `${Math.max(1 - progress * 0.3, 0.7)}`;
				const spinSt = getSpin(currentSlideEl);
				spinSt.scroll = starRotate;
				if (spinSt.raf === null) renderSpin(currentSlideEl, spinSt);
			}

			const ellipseGlow = currentSlideEl.querySelector<HTMLElement>('div[class*="mix-blend-overlay"]');
			if (ellipseGlow) {
				ellipseGlow.style.transform = `scale(${1 + progress * 0.4}) rotate(${scrollY * 0.05}deg)`;
				ellipseGlow.style.opacity = `${0.6 + progress * 0.4}`;
			}

			const heroStripes = currentSlideEl.querySelectorAll<HTMLElement>('.hero-stripe');
			heroStripes.forEach((stripe) => {
				const dir = (stripe.dataset.dir === 'up' ? -1 : 1);
				stripe.style.transform = `translateY(${dir * progress * 30}px) scaleY(${1 + progress * 0.05})`;
				stripe.style.opacity = `${1 - progress * 0.25}`;
			});

			const opacityUi = Math.max(1 - progress * 2.2, 0);

			if (infoEl) {
				infoEl.style.opacity = `${opacityUi}`;
				infoEl.style.transform = `translateX(${-progress * 30}px)`;
			}

			const menuBtnHero = document.getElementById('hero-menu-btn');
			if (menuBtnHero) {
				menuBtnHero.style.opacity = `${opacityUi}`;
				menuBtnHero.style.transform = `translateX(${progress * 25}px)`;
				menuBtnHero.style.pointerEvents = opacityUi === 0 ? 'none' : 'auto';
			}

			if (prevBtn) {
				prevBtn.style.opacity = `${opacityUi}`;
				prevBtn.style.transform = `translateX(${-progress * 25}px)`;
				prevBtn.style.pointerEvents = opacityUi === 0 ? 'none' : 'auto';
			}

			if (nextBtn) {
				nextBtn.style.opacity = `${opacityUi}`;
				nextBtn.style.transform = `translateX(${progress * 25}px)`;
				nextBtn.style.pointerEvents = opacityUi === 0 ? 'none' : 'auto';
			}
		}

		window.addEventListener('scroll', handleScrollAnimation, { passive: true });
	}
</script>
