---
import Layout from '../layouts/Layout.astro';
import CheckoutView from '../components/checkout/CheckoutView';
---

<Layout>
	<main id="main-content" class="min-h-screen bg-beige pt-24 pb-20">
		<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
			<!-- Breadcrumb: Menú < Carrito < Pago -->
			<nav aria-label="Ruta de compra" class="mb-6 flex items-center gap-1.5 font-sans text-sm text-brown/60">
				<a href="/menu" class="transition-colors hover:text-pink">Menú</a>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
					<path d="m9 18 6-6-6-6" />
				</svg>
				<a href="/checkout" class="transition-colors hover:text-pink">Carrito</a>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
					<path d="m9 18 6-6-6-6" />
				</svg>
				<span class="font-bold text-pink" aria-current="page">Pago</span>
			</nav>

			<h1 class="mb-6 font-sans text-3xl font-black text-brown sm:text-4xl">Pago</h1>

			<CheckoutView client:load />
		</div>
	</main>
</Layout>
