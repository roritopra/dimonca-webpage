---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import logoImg from '../../assets/images/logo.png';

const categories = [
	{ label: 'Galletas', img: '/images/cookie.png', imgHover: '/images/cookie-hover.png' },
	{ label: 'Cuchareables', img: '/images/cuchareable.png', imgHover: '/images/cuchareable-hover.png' },
	{ label: 'Brownies', img: '/images/brownie.png', imgHover: '/images/brownie-hover.png' },
	{ label: 'Pasteles', img: '/images/cake.png', imgHover: '/images/cake-hover.png' },
	{ label: 'Más Productos', img: '/images/crookie.png', imgHover: '/images/crookie-hover.png' },
];
---

<header
	id="navbar"
	class="group fixed top-0 left-0 z-50 w-full font-sans transition-all duration-400 ease-out pointer-events-none"
>
	<div
		id="navbar-container"
		class="pointer-events-auto mx-auto flex flex-wrap items-center justify-center gap-x-[60px] gap-y-6 bg-beige px-10 py-3.5 transition-all duration-400 ease-out max-[900px]:gap-x-8 max-[900px]:px-6 mt-4 max-w-[1240px] rounded-full drop-shadow-[0px_10px_25px_rgba(58,32,14,0.18)]"
	>
		<a
			class="flex flex-1 min-w-0 items-center justify-center whitespace-nowrap p-2 text-[15px] leading-[1.2] text-brown no-underline hover:opacity-75 max-[900px]:flex-none"
			href="#encuentranos"
			>Encuéntranos</a
		>
		<button
			id="menu-btn"
			class="group/btn relative flex h-[30px] flex-1 min-w-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap border-0 bg-transparent p-2 text-[15px] leading-[1.2] text-brown transition-colors duration-200 group-data-[open]:text-pink group-data-[open]:font-bold hover:opacity-75 max-[900px]:flex-none"
			type="button"
			aria-haspopup="true"
			aria-expanded="false"
			aria-controls="dropdown"
			aria-label="Abrir menú de navegación de postres"
		>
			Menú
			<Icon
				name="lucide:chevron-down"
				class="h-6 w-6 shrink-0 transition-transform duration-200 group-data-[open]:rotate-180 group-data-[open]:text-pink"
				aria-hidden="true"
			/>
		</button>
		<a class="shrink-0" href="/" aria-label="Dimonca, inicio">
			<Image class="block h-[42px] w-[145px] object-contain transition-all duration-300" src={logoImg} alt="Dimonca" loading="eager" />
		</a>
		<a
			class="flex flex-1 min-w-0 items-center justify-center whitespace-nowrap p-2 text-[15px] leading-[1.2] text-brown no-underline hover:opacity-75 max-[900px]:flex-none"
			href="#sobre-nosotros"
			>Sobre Nosotros</a
		>
		<a
			class="flex h-[42px] flex-1 min-w-0 items-center justify-center gap-2 whitespace-nowrap rounded-[57px] bg-pink px-4 py-2 text-[15px] font-bold leading-[1.2] text-beige no-underline hover:brightness-95 max-[900px]:flex-none"
			href="#pedido"
		>
			Haz tu pedido
			<span class="flex h-6.5 w-6.5 shrink-0 items-center justify-center rounded-[18.38px] bg-beige p-[5px]">
				<img class="block h-[11.5px] w-[11.5px]" src="/images/map.svg" alt="" />
			</span>
		</a>
	<nav
		class="pointer-events-none invisible absolute top-[calc(100%+8px)] inset-x-0 z-50 flex items-start justify-center gap-[93px] bg-beige py-[18px] opacity-0 drop-shadow-[0px_11px_19.05px_rgba(58,32,14,0.14)]"
		id="dropdown"
		aria-label="Categorías del menú"
	>
		{
			categories.map((c) => {
				if (c.label === 'Galletas' || c.label === 'Más Productos') {
					return (
						<a data-category="split" class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href={`#${c.label.toLowerCase().replace(/\s+/g, '-')}`}>
							<div class="nav-cookie-wrap relative h-[121px] w-[121px]">
								<div class="nav-cookie-left absolute inset-y-0 left-0 w-1/2 overflow-hidden">
									<img class="absolute top-0 left-0 h-full w-[121px] max-w-none object-cover" src={c.img} alt={c.label} />
								</div>
								<div class="nav-cookie-right absolute inset-y-0 right-0 w-1/2 overflow-hidden">
									<img class="absolute top-0 right-0 h-full w-[121px] max-w-none object-cover" src={c.img} alt="" aria-hidden="true" />
								</div>
								<img class="nav-cookie-cracked pointer-events-none absolute inset-0 h-full w-full object-cover" style="opacity: 0;" src={c.imgHover} alt="" aria-hidden="true" />
							</div>
							<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
						</a>
					);
				} else if (c.label === 'Brownies') {
					return (
						<a data-category="brownies" class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href="#brownies">
							<div class="relative h-[121px] w-[121px]">
								<img class="brownie-left absolute inset-0 block h-full w-full object-cover object-center opacity-0" src="/images/brownie-pistacho.png" alt="" aria-hidden="true" />
								<img class="brownie-right absolute inset-0 block h-full w-full object-cover object-center opacity-0" src="/images/brownie-redvelvet.png" alt="" aria-hidden="true" />
								<img class="brownie-center absolute inset-0 block h-full w-full object-cover object-center z-10" src="/images/brownie-clasico.png" alt={c.label} />
							</div>
							<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
						</a>
					);
				} else {
					return (
						<a class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href={`#${c.label.toLowerCase().replace(/\s+/g, '-')}`}>
							<div class="relative h-[121px] w-[121px] overflow-clip">
								<img class="absolute inset-0 block h-full w-full object-cover object-center" src={c.img} alt={c.label} />
								<img class="absolute inset-0 block h-full w-full object-cover object-center opacity-0" src={c.imgHover} alt="" aria-hidden="true" />
							</div>
							<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
						</a>
					);
				}
			})
		}
	</nav>
	</div>
</header>

<script>
	import { animate } from 'motion';

	const navbar = document.getElementById('navbar');
	const menuBtn = document.getElementById('menu-btn');
	const dropdown = document.getElementById('dropdown');

	if (navbar && menuBtn && dropdown) {
		let isOpen = false;

		const open = () => {
			isOpen = true;
			navbar.dataset.open = 'true';
			menuBtn.setAttribute('aria-expanded', 'true');
			animate(
				dropdown,
				{ opacity: 1, y: 0, visibility: 'visible', pointerEvents: 'auto' },
				{ duration: 0.25, ease: 'easeOut' }
			);
		};

		const close = () => {
			isOpen = false;
			delete navbar.dataset.open;
			menuBtn.setAttribute('aria-expanded', 'false');
			animate(
				dropdown,
				{ opacity: 0, y: -8, visibility: 'hidden', pointerEvents: 'none' },
				{ duration: 0.2, ease: 'easeIn' }
			);
		};

		const navbarContainer = document.getElementById('navbar-container');

		const handleScroll = () => {
			const scrollY = window.scrollY;
			const maxScroll = 420;
			const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

			if (!navbarContainer) return;

			// Margen superior: de 16px (1rem) a 0px
			const marginTop = (1 - progress) * 16;
			navbarContainer.style.marginTop = `${marginTop}px`;

			// Ancho: de 1240px a 100%
			if (progress === 0) {
				navbarContainer.style.maxWidth = '1240px';
				navbarContainer.style.width = 'calc(100% - 32px)';
			} else if (progress >= 1) {
				navbarContainer.style.maxWidth = '100%';
				navbarContainer.style.width = '100%';
			} else {
				navbarContainer.style.maxWidth = `calc(1240px + (100% - 1240px) * ${progress})`;
				navbarContainer.style.width = `calc(100% - ${(1 - progress) * 32}px)`;
			}

			// Redondeo de esquinas: de 9999px a 0px
			const borderRadius = (1 - progress) * 40;
			navbarContainer.style.borderRadius = `${borderRadius}px`;

			// Sincronizar el redondeo y la distancia superior del dropdown con el navbar
			if (dropdown) {
				dropdown.style.borderRadius = `${Math.min(borderRadius, 32)}px`;
				const dropdownGap = (1 - progress) * 8;
				dropdown.style.top = `calc(100% + ${dropdownGap}px)`;
			}

			// Padding lateral: de 40px (2.5rem) a 80px (5rem)
			const paddingX = 40 + progress * 40;
			navbarContainer.style.paddingLeft = `${paddingX}px`;
			navbarContainer.style.paddingRight = `${paddingX}px`;

			// Sombra
			if (progress >= 1) {
				navbarContainer.style.filter = 'drop-shadow(0px 11px 19.05px rgba(58,32,14,0.14))';
			} else {
				navbarContainer.style.filter = 'drop-shadow(0px 10px 25px rgba(58,32,14,0.18))';
			}
		};

		window.addEventListener('scroll', handleScroll, { passive: true });
		handleScroll();

		menuBtn.addEventListener('click', () => {
			isOpen ? close() : open();
		});

		document.addEventListener('click', (e) => {
			if (isOpen && !navbar.contains(e.target as Node)) {
				close();
			}
		});

		dropdown.querySelectorAll<HTMLAnchorElement>('[data-category="split"]').forEach((splitLink) => {
			const cookieWrap = splitLink.querySelector<HTMLElement>('.nav-cookie-wrap');
			const leftHalf = splitLink.querySelector<HTMLElement>('.nav-cookie-left');
			const rightHalf = splitLink.querySelector<HTMLElement>('.nav-cookie-right');
			const cracked = splitLink.querySelector<HTMLElement>('.nav-cookie-cracked');
			const label = splitLink.querySelector('p');
			let crackedTimeout: ReturnType<typeof setTimeout> | null = null;

			splitLink.addEventListener('mouseenter', () => {
				animate(cookieWrap!, { rotate: -17 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
				animate(leftHalf!, { x: -2 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
				animate(rightHalf!, { x: 2 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
				crackedTimeout = setTimeout(() => {
					animate(cracked!, { opacity: 1 }, { duration: 0.1, ease: 'easeOut' });
					animate(leftHalf!, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
					animate(rightHalf!, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
				}, 50);
				if (label) animate(label, { color: '#c34a70' }, { duration: 0.2, ease: 'easeOut' });
			});

			splitLink.addEventListener('mouseleave', () => {
				if (crackedTimeout) { clearTimeout(crackedTimeout); crackedTimeout = null; }
				animate(cookieWrap!, { rotate: 0 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
				animate(leftHalf!, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
				animate(rightHalf!, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
				animate(cracked!, { opacity: 0 }, { duration: 0.3, ease: 'easeInOut' });
				if (label) animate(label, { color: '#3a200e' }, { duration: 0.2, ease: 'easeOut' });
			});
		});

		const browniesLink = dropdown.querySelector<HTMLAnchorElement>('[data-category="brownies"]');
		if (browniesLink) {
			const bLeft = browniesLink.querySelector<HTMLElement>('.brownie-left');
			const bRight = browniesLink.querySelector<HTMLElement>('.brownie-right');
			const bCenter = browniesLink.querySelector<HTMLElement>('.brownie-center');
			const label = browniesLink.querySelector('p');

			browniesLink.addEventListener('mouseenter', () => {
				if (bLeft) {
					animate(bLeft, { opacity: 1, x: -30, y: 4, rotate: -12, scale: 0.9 }, { type: 'spring', stiffness: 300, damping: 20 });
				}
				if (bRight) {
					animate(bRight, { opacity: 1, x: 30, y: 4, rotate: 12, scale: 0.9 }, { type: 'spring', stiffness: 300, damping: 20 });
				}
				if (bCenter) {
					animate(bCenter, { scale: 1.05, y: -4 }, { type: 'spring', stiffness: 300, damping: 20 });
				}
				if (label) animate(label, { color: '#c34a70' }, { duration: 0.2, ease: 'easeOut' });
			});

			browniesLink.addEventListener('mouseleave', () => {
				if (bLeft) {
					animate(bLeft, { opacity: 0, x: 0, y: 0, rotate: 0, scale: 1 }, { duration: 0.25, ease: 'easeInOut' });
				}
				if (bRight) {
					animate(bRight, { opacity: 0, x: 0, y: 0, rotate: 0, scale: 1 }, { duration: 0.25, ease: 'easeInOut' });
				}
				if (bCenter) {
					animate(bCenter, { scale: 1, y: 0 }, { duration: 0.25, ease: 'easeInOut' });
				}
				if (label) animate(label, { color: '#3a200e' }, { duration: 0.2, ease: 'easeOut' });
			});
		}

		dropdown.querySelectorAll<HTMLAnchorElement>('a:not([data-category="split"]):not([data-category="brownies"])').forEach((link) => {
			const [img, imgHover] = link.querySelectorAll('img');
			const label = link.querySelector('p');

			link.addEventListener('mouseenter', () => {
				if (img && imgHover) {
					animate(img, { opacity: 0, scale: 0.94 }, { duration: 0.25, ease: 'easeOut' });
					animate(imgHover, { opacity: 1, scale: 1.06 }, { duration: 0.25, ease: 'easeOut' });
				}
				if (label) animate(label, { color: '#c34a70' }, { duration: 0.2, ease: 'easeOut' });
			});

			link.addEventListener('mouseleave', () => {
				if (img && imgHover) {
					animate(img, { opacity: 1, scale: 1 }, { duration: 0.25, ease: 'easeOut' });
					animate(imgHover, { opacity: 0, scale: 0.94 }, { duration: 0.25, ease: 'easeOut' });
				}
				if (label) animate(label, { color: '#3a200e' }, { duration: 0.2, ease: 'easeOut' });
			});
		});
	}
</script>
