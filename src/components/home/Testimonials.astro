---
import { Icon } from 'astro-icon/components';

const testimonials = [
	{
		id: 1,
		background: '/images/home/testimonials/bg-1.png',
		text: 'Todo es delicioso, el espacio es super acogedor. Las galletas y el latte frío son mis favoritos. Me encanta todo del lugar. La torta de chocolate es la mejor que he probado.',
		author: 'Diana Carolina Roa',
		stamp: '/images/home/testimonials/stamp-1.png',
		badge: '/images/home/testimonials/badge-1.png',
		stampClass: 'w-[160px] sm:w-[190px] md:w-[220px] -top-10 -right-8 sm:-top-14 sm:-right-12 md:-top-16 md:-right-16',
		badgeClass: 'w-[90px] sm:w-[105px] md:w-[120px] -bottom-8 -left-6 sm:-bottom-10 sm:-left-8 md:-bottom-12 md:-left-10',
	},
	{
		id: 2,
		background: '/images/home/testimonials/bg-2.png',
		text: 'Las mejores galletas artesanales de la ciudad. El crocante por fuera y la suavidad por dentro son de otro nivel. Siempre vuelvo por más.',
		author: 'Camila Morales',
		stamp: '/images/home/testimonials/stamp-2.png',
		badge: '/images/home/testimonials/badge-2.png',
		stampClass: 'w-[165px] sm:w-[195px] md:w-[225px] -top-10 -right-8 sm:-top-14 sm:-right-12 md:-top-16 md:-right-16',
		badgeClass: 'w-[95px] sm:w-[110px] md:w-[125px] -bottom-8 -left-6 sm:-bottom-10 sm:-left-8 md:-bottom-12 md:-left-10',
	},
	{
		id: 3,
		background: '/images/home/testimonials/bg-3.png',
		text: 'Una experiencia dulce inigualable. Los brownies y los sabores especiales son una locura. ¡Recomendadísimo para compartir con amigos o familia!',
		author: 'Sebastián Gómez',
		stamp: '/images/home/testimonials/stamp-3.png',
		badge: '/images/home/testimonials/badge-3.png',
		stampClass: 'w-[120px] sm:w-[140px] md:w-[160px] -top-8 -right-6 sm:-top-10 sm:-right-8 md:-top-12 md:-right-10',
		badgeClass: 'w-[95px] sm:w-[110px] md:w-[125px] -bottom-8 -left-6 sm:-bottom-10 sm:-left-8 md:-bottom-12 md:-left-10',
	},
];
---

<section id="testimonials" class="relative w-full h-[620px] md:h-[720px] overflow-hidden select-none">
	<!-- Carrusel de fondos -->
	<div id="testimony-bg-container" class="absolute inset-0 z-0">
		{
			testimonials.map((t, idx) => (
				<div
					data-bg-slide={idx}
					class:list={[
						'absolute inset-0 bg-cover bg-center transition-opacity duration-700 ease-in-out',
						idx === 0 ? 'opacity-100 z-1' : 'opacity-0 z-0'
					]}
					style={`background-image: url('${t.background}');`}
				/>
			))
		}
	</div>

	<!-- Contenedor general centrado -->
	<div class="relative z-10 mx-auto flex h-full max-w-[1440px] items-center justify-center px-4 sm:px-12 md:px-24">
		<!-- Botón Prev -->
		<button
			id="testimony-prev"
			class="absolute left-2 sm:left-6 md:left-12 lg:left-20 z-20 flex h-10 w-10 sm:h-12 sm:w-12 md:h-14 md:w-14 cursor-pointer items-center justify-center rounded-full border-2 sm:border-[3px] border-white bg-pink text-beige shadow-lg transition-transform duration-200 hover:scale-105 hover:brightness-95 active:scale-95"
			type="button"
			aria-label="Ver testimonio anterior"
		>
			<Icon name="lucide:chevron-left" class="h-5 w-5 sm:h-6 sm:w-6 md:h-7 md:w-7 shrink-0" aria-hidden="true" />
		</button>

		<!-- Card de Testimonio (Toldo / Tienda) -->
		<div class="relative w-full max-w-[580px] md:max-w-[620px] mx-10 sm:mx-14 md:mx-0">
			<!-- Estampa / Stamp Top Right -->
			<div
				id="testimony-stamp-wrap"
				class:list={[
					'pointer-events-none absolute z-30 transition-all duration-500',
					testimonials[0].stampClass
				]}
			>
				<img
					id="testimony-stamp"
					src={testimonials[0].stamp}
					alt="Dimonca stamp"
					class="block h-auto w-full object-contain drop-shadow-md"
				/>
			</div>

			<!-- Badge / Logo Left Bottom -->
			<div
				id="testimony-badge-wrap"
				class:list={[
					'pointer-events-none absolute z-30 transition-all duration-500',
					testimonials[0].badgeClass
				]}
			>
				<img
					id="testimony-badge"
					src={testimonials[0].badge}
					alt="Badge"
					class="block h-auto w-full object-contain drop-shadow-md"
				/>
			</div>

			<!-- Tarjeta principal blanca (rectángulo recto sin redondez ni sombra) -->
			<div class="testimony-card-box relative bg-white p-6 sm:p-9 md:p-10">
				<!-- Estrellas (SVG de testimony) -->
				<div class="mb-5 flex items-center justify-center gap-1.5 sm:gap-2">
					<img src="/images/home/testimonials/star.svg" alt="" class="h-6 w-6 sm:h-7 sm:w-7" />
					<img src="/images/home/testimonials/star.svg" alt="" class="h-6 w-6 sm:h-7 sm:w-7" />
					<img src="/images/home/testimonials/star.svg" alt="" class="h-6 w-6 sm:h-7 sm:w-7" />
					<img src="/images/home/testimonials/star.svg" alt="" class="h-6 w-6 sm:h-7 sm:w-7" />
					<img src="/images/home/testimonials/star.svg" alt="" class="h-6 w-6 sm:h-7 sm:w-7" />
				</div>

				<!-- Texto del testimonio -->
				<div id="testimony-content" class="min-h-[140px] flex flex-col justify-between">
					<p
						id="testimony-text"
						class="m-0 text-center font-sans text-[15px] sm:text-[16px] md:text-[17px] font-medium leading-relaxed text-pink transition-opacity duration-300"
					>
						{testimonials[0].text}
					</p>

					<!-- Autor -->
					<p
						id="testimony-author"
						class="mt-5 text-right font-sans text-[15px] sm:text-[16px] italic font-semibold text-pink transition-opacity duration-300"
					>
						{testimonials[0].author}
					</p>
				</div>

				<!-- Festón / Ondas inferiores tipo toldo de tienda (SVG repetible y perfecto de borde a borde) -->
				<div class="testimony-scallops absolute -bottom-4 inset-x-0 h-4 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
					<svg class="w-full h-full block" viewBox="0 0 600 16" preserveAspectRatio="none">
						<defs>
							<pattern id="scallop-pattern" x="0" y="0" width="30" height="16" patternUnits="userSpaceOnUse">
								<circle cx="15" cy="0" r="15" fill="#ffffff" />
							</pattern>
						</defs>
						<rect x="0" y="0" width="100%" height="16" fill="url(#scallop-pattern)" />
					</svg>
				</div>
			</div>
		</div>

		<!-- Botón Next -->
		<button
			id="testimony-next"
			class="absolute right-2 sm:right-6 md:right-12 lg:right-20 z-20 flex h-10 w-10 sm:h-12 sm:w-12 md:h-14 md:w-14 cursor-pointer items-center justify-center rounded-full border-2 sm:border-[3px] border-white bg-pink text-beige shadow-lg transition-transform duration-200 hover:scale-105 hover:brightness-95 active:scale-95"
			type="button"
			aria-label="Ver testimonio siguiente"
		>
			<Icon name="lucide:chevron-right" class="h-5 w-5 sm:h-6 sm:w-6 md:h-7 md:w-7 shrink-0" aria-hidden="true" />
		</button>
	</div>
</section>

<script>
	import { animate } from 'motion';

	const testimonialsData = [
		{
			id: 1,
			background: '/images/home/testimonials/bg-1.png',
			text: 'Todo es delicioso, el espacio es super acogedor. Las galletas y el latte frío son mis favoritos. Me encanta todo del lugar. La torta de chocolate es la mejor que he probado.',
			author: 'Diana Carolina Roa',
			stamp: '/images/home/testimonials/stamp-1.png',
			badge: '/images/home/testimonials/badge-1.png',
			stampClass: 'w-[160px] sm:w-[190px] md:w-[220px] -top-10 -right-8 sm:-top-14 sm:-right-12 md:-top-16 md:-right-16',
			badgeClass: 'w-[90px] sm:w-[105px] md:w-[120px] -bottom-8 -left-6 sm:-bottom-10 sm:-left-8 md:-bottom-12 md:-left-10',
		},
		{
			id: 2,
			background: '/images/home/testimonials/bg-2.png',
			text: 'Las mejores galletas artesanales de la ciudad. El crocante por fuera y la suavidad por dentro son de otro nivel. Siempre vuelvo por más.',
			author: 'Camila Morales',
			stamp: '/images/home/testimonials/stamp-2.png',
			badge: '/images/home/testimonials/badge-2.png',
			stampClass: 'w-[165px] sm:w-[195px] md:w-[225px] -top-10 -right-8 sm:-top-14 sm:-right-12 md:-top-16 md:-right-16',
			badgeClass: 'w-[95px] sm:w-[110px] md:w-[125px] -bottom-8 -left-6 sm:-bottom-10 sm:-left-8 md:-bottom-12 md:-left-10',
		},
		{
			id: 3,
			background: '/images/home/testimonials/bg-3.png',
			text: 'Una experiencia dulce inigualable. Los brownies y los sabores especiales son una locura. ¡Recomendadísimo para compartir con amigos o familia!',
			author: 'Sebastián Gómez',
			stamp: '/images/home/testimonials/stamp-3.png',
			badge: '/images/home/testimonials/badge-3.png',
			stampClass: 'w-[120px] sm:w-[140px] md:w-[160px] -top-8 -right-6 sm:-top-10 sm:-right-8 md:-top-12 md:-right-10',
			badgeClass: 'w-[95px] sm:w-[110px] md:w-[125px] -bottom-8 -left-6 sm:-bottom-10 sm:-left-8 md:-bottom-12 md:-left-10',
		},
	];

	function initTestimonials() {
		const section = document.getElementById('testimonials');
		if (!section) return;

		const prevBtn = document.getElementById('testimony-prev');
		const nextBtn = document.getElementById('testimony-next');
		const textEl = document.getElementById('testimony-text');
		const authorEl = document.getElementById('testimony-author');
		const stampWrap = document.getElementById('testimony-stamp-wrap');
		const badgeWrap = document.getElementById('testimony-badge-wrap');
		const stampImg = document.getElementById('testimony-stamp') as HTMLImageElement | null;
		const badgeImg = document.getElementById('testimony-badge') as HTMLImageElement | null;
		const bgSlides = Array.from(section.querySelectorAll<HTMLElement>('[data-bg-slide]'));

		let currentIndex = 0;
		let isTransitioning = false;

		function updateTestimonial(newIndex: number) {
			if (isTransitioning || newIndex === currentIndex) return;
			isTransitioning = true;

			// Fade out texto, autor, estampa y badge
			if (textEl && authorEl) {
				animate(textEl, { opacity: [1, 0], y: [0, -8] }, { duration: 0.25, ease: 'easeIn' });
				animate(authorEl, { opacity: [1, 0], y: [0, -8] }, { duration: 0.25, ease: 'easeIn' });
			}
			if (stampWrap && badgeWrap) {
				animate(stampWrap, { opacity: [1, 0], scale: [1, 0.9] }, { duration: 0.2, ease: 'easeIn' });
				animate(badgeWrap, { opacity: [1, 0], scale: [1, 0.9] }, { duration: 0.2, ease: 'easeIn' });
			}

			// Actualizar fondos
			bgSlides.forEach((bg, idx) => {
				if (idx === newIndex) {
					bg.classList.remove('opacity-0', 'z-0');
					bg.classList.add('opacity-100', 'z-1');
				} else {
					bg.classList.remove('opacity-100', 'z-1');
					bg.classList.add('opacity-0', 'z-0');
				}
			});

			setTimeout(() => {
				const item = testimonialsData[newIndex];
				const oldItem = testimonialsData[currentIndex];

				if (textEl) textEl.textContent = item.text;
				if (authorEl) authorEl.textContent = item.author;

				// Cambiar clases de tamaño y posición de estampa y badge
				if (stampWrap) {
					oldItem.stampClass.split(' ').forEach((c) => stampWrap.classList.remove(c));
					item.stampClass.split(' ').forEach((c) => stampWrap.classList.add(c));
				}
				if (badgeWrap) {
					oldItem.badgeClass.split(' ').forEach((c) => badgeWrap.classList.remove(c));
					item.badgeClass.split(' ').forEach((c) => badgeWrap.classList.add(c));
				}

				if (stampImg) stampImg.src = item.stamp;
				if (badgeImg) badgeImg.src = item.badge;

				if (textEl && authorEl) {
					animate(textEl, { opacity: [0, 1], y: [8, 0] }, { duration: 0.35, ease: 'easeOut' });
					animate(authorEl, { opacity: [0, 1], y: [8, 0] }, { duration: 0.35, ease: 'easeOut' });
				}
				if (stampWrap && badgeWrap) {
					animate(stampWrap, { opacity: [0, 1], scale: [0.9, 1] }, { duration: 0.35, ease: 'easeOut' });
					animate(badgeWrap, { opacity: [0, 1], scale: [0.9, 1] }, { duration: 0.35, ease: 'easeOut' });
				}

				currentIndex = newIndex;
				isTransitioning = false;
			}, 260);
		}

		prevBtn?.addEventListener('click', () => {
			const nextIdx = (currentIndex - 1 + testimonialsData.length) % testimonialsData.length;
			updateTestimonial(nextIdx);
		});

		nextBtn?.addEventListener('click', () => {
			const nextIdx = (currentIndex + 1) % testimonialsData.length;
			updateTestimonial(nextIdx);
		});
	}

	document.addEventListener('astro:page-load', initTestimonials);
</script>
