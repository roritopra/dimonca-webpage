---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import sobre1Img from "../../assets/images/home/sobre-nosotros/foto-1.png";
import sobre2Img from "../../assets/images/home/sobre-nosotros/foto-2.png";
import sobre3Img from "../../assets/images/home/sobre-nosotros/foto-3.png";
import sobre4Img from "../../assets/images/home/sobre-nosotros/foto-4.png";
import sobreCookieImg from "../../assets/images/home/sobre-nosotros/cookie.png";

const photos = [
  {
    id: "sobre-1",
    src: sobre1Img,
    alt: "Postres artesanales Dimonca",
    justify: "justify-start",
    initialStyle: "transform: translate(-80px, 30px) rotate(-9deg);",
  },
  {
    id: "sobre-2",
    src: sobre2Img,
    alt: "Variedad de galletas y pasteles Dimonca",
    justify: "justify-end",
    initialStyle: "transform: translate(80px, 30px) rotate(9deg);",
  },
  {
    id: "sobre-4",
    src: sobre4Img,
    alt: "Detalle de repostería fresca",
    justify: "justify-start",
    initialStyle: "transform: translate(-50px, 100px) rotate(-9deg);",
  },
  {
    id: "sobre-3",
    src: sobre3Img,
    alt: "Momentos dulces con postres Dimonca",
    justify: "justify-start",
    initialStyle: "transform: translate(50px, 100px) rotate(9deg);",
  },
];
---

<section id="sobre-nosotros" class="relative z-10 w-full overflow-hidden bg-beige shadow-[0_-12px_24px_rgba(58,32,14,0.12)]">
  <div
    class="mx-auto flex max-w-[1440px] flex-col-reverse lg:flex-row items-center justify-center gap-12 sm:gap-16 px-6 sm:px-12 lg:px-20 py-12 sm:py-16"
  >
    <!-- Collage interactivo con fotos y animaciones -->
    <div
      id="sobre-grid"
      class="relative grid w-full max-w-[340px] sm:max-w-[460px] lg:max-w-[540px] grid-cols-2 gap-x-4 sm:gap-x-5 gap-y-6 sm:gap-y-8 mt-4 lg:mt-0"
    >
      {
        photos.map((p) => (
          <div class={`flex flex-col ${p.justify}`}>
            <Image
              id={p.id}
              class="block h-auto w-full object-contain"
              style={p.initialStyle}
              src={p.src}
              alt={p.alt}
              loading="lazy"
            />
          </div>
        ))
      }
      <div
        class="absolute top-0 left-8/12 z-10 w-full max-w-[200px] sm:max-w-[260px] lg:max-w-[300px] -translate-x-1/2"
      >
        <p
          id="sobre-texto"
          class="font-exmouth text-[26px] sm:text-[34px] lg:text-[40.74px] leading-[1.2]
		text-brown [-webkit-text-stroke:4px_#F7F2E8] sm:[-webkit-text-stroke:6px_#F7F2E8] lg:[-webkit-text-stroke:8px_#F7F2E8] [paint-order:stroke_fill]
		[filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
          style="transform: translate(-50px, 100px);"
          aria-hidden="true"
        >
          Darte siempre un poquito más de lo que amas.
        </p>
      </div>
      <div class="absolute bottom-0 left-1/2 z-10 -translate-x-1/2">
        <Image
          id="sobre-cookie"
          class="block w-[100px] sm:w-[130px] lg:w-[160px] h-auto scale-125"
          style="transform: translate(-100px, -100px);"
          src={sobreCookieImg}
          alt=""
          aria-hidden="true"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-1/2 right-0 z-20 flex size-[48px] sm:size-[58px] lg:size-[71px] -translate-y-1/2 items-center justify-center"
      >
        <div
          id="sobre-heart"
          class="flex items-center justify-center"
          style="transform: translate(50px, 100px);"
        >
          <div class="-rotate-30">
            <div
              class="flex items-center rounded-[140.54px] border-[1.5px] sm:border-[2px] lg:border-[2.11px] border-beige bg-pink p-[4px] sm:p-[5.5px] lg:p-[7.03px] drop-shadow-[0px_2.81px_1.4px_rgba(58,32,14,0.15)]"
            >
              <div
                class="flex items-center rounded-[22.49px] border-[1.5px] sm:border-[2px] border-pink-200 p-[4px] sm:p-[5.5px] lg:p-[7.03px]"
              >
                <Icon
                  name="lucide:heart"
                  class="block h-4 w-4 sm:h-5 sm:w-5 lg:h-[23.89px] lg:w-[23.89px] text-beige"
                  aria-hidden="true"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna de Información / Texto -->
    <div class="flex w-full max-w-[522px] flex-col items-center lg:items-start text-center lg:text-left gap-4 sm:gap-6">
      <div class="relative w-full flex flex-col items-center lg:items-start">
        <h2
          class="font-sans text-[36px] sm:text-[46px] lg:text-[59px] leading-[1.15] font-bold text-brown m-0"
        >
          Bienvenido al universo
        </h2>
        <span
          class="font-exmouth text-[58px] sm:text-[70px] lg:text-[81.14px] leading-none text-pink -mt-2 sm:-mt-3 lg:-mt-4 lg:absolute lg:top-[62px] lg:left-[273px]"
          aria-hidden="true"
        >
          Dimonca
        </span>
      </div>
      <p
        class="w-full font-sans text-[16px] sm:text-[18px] lg:text-[19px] leading-[1.35] text-brown m-0 max-w-[480px] lg:max-w-none"
      >
        Bienvenidos a Dimonca deliciosos momentos dulces te esperan en nuestro{' '}
        <strong>rincón de tentaciones</strong>
        {', donde cada bocado es una experiencia única! Desde clásicos tradicionales hasta '}
        <strong>creaciones innovadoras</strong>
        {' Nuestra pasión por la pastelería se refleja en cada pastel que preparamos con mucho amor! '}
      </p>
      <a
        class="group mt-2 flex h-[48px] sm:h-[52px] w-[190px] sm:w-[210px] items-center justify-center gap-3 whitespace-nowrap rounded-[57px] bg-pink px-6 py-3 font-sans text-[17px] sm:text-[19px] leading-[1.2] font-bold text-beige no-underline shadow-[0_4px_14px_rgba(244,93,140,0.4)] transition-all duration-300 hover:shadow-[0_6px_20px_rgba(244,93,140,0.6)] hover:brightness-95"
        href="#contacto"
      >
        Contáctanos
        <span
          class="flex h-7 w-7 sm:h-[34px] sm:w-[34px] shrink-0 items-center justify-center rounded-full bg-beige p-1.5 sm:p-[7px] transition-transform duration-300 group-hover:scale-110"
        >
          <Icon
            name="lucide:phone-call"
            class="block h-3.5 w-3.5 sm:h-[16px] sm:w-[16px] text-pink"
            aria-hidden="true"
          />
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  function setupSobreAnimation() {
    const section = document.getElementById("sobre-nosotros");
    const sobre1 = document.getElementById("sobre-1");
    const sobre2 = document.getElementById("sobre-2");
    const sobre3 = document.getElementById("sobre-3");
    const sobre4 = document.getElementById("sobre-4");
    const sobreHeart = document.getElementById("sobre-heart");
    const sobreTexto = document.getElementById("sobre-texto");
    const sobreCookie = document.getElementById("sobre-cookie");

    if (
      !section ||
      !sobre1 ||
      !sobre2 ||
      !sobre3 ||
      !sobre4 ||
      !sobreHeart ||
      !sobreTexto ||
      !sobreCookie
    ) {
      return;
    }

    const handleScroll = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // El progreso va de 0 (cuando entra en pantalla por abajo) a 1 (cuando llega a su punto óptimo de visualización)
      const start = windowHeight;
      const end = windowHeight * 0.25;
      const progress = Math.min(Math.max((start - rect.top) / (start - end), 0), 1);

      // Interpolación de sobre-1 (arriba izquierda)
      const s1X = -80 * (1 - progress);
      const s1Y = 30 * (1 - progress);
      const s1Rot = -9 * (1 - progress);
      sobre1.style.transform = `translate(${s1X}px, ${s1Y}px) rotate(${s1Rot}deg)`;

      // Interpolación de sobre-2 (arriba derecha)
      const s2X = 80 * (1 - progress);
      const s2Y = 30 * (1 - progress);
      const s2Rot = 9 * (1 - progress);
      sobre2.style.transform = `translate(${s2X}px, ${s2Y}px) rotate(${s2Rot}deg)`;

      // Interpolación de sobre-4 (abajo izquierda)
      const s4X = -50 * (1 - progress);
      const s4Y = 100 * (1 - progress);
      const s4Rot = 9 * (1 - progress);
      sobre4.style.transform = `translate(${s4X}px, ${s4Y}px) rotate(${s4Rot}deg)`;

      // Interpolación de sobre-3 (abajo derecha)
      const s3X = 50 * (1 - progress);
      const s3Y = 100 * (1 - progress);
      const s3Rot = -9 * (1 - progress);
      sobre3.style.transform = `translate(${s3X}px, ${s3Y}px) rotate(${s3Rot}deg)`;

      // Interpolación del corazón
      const hX = 50 * (1 - progress);
      const hY = 100 * (1 - progress);
      sobreHeart.style.transform = `translate(${hX}px, ${hY}px)`;

      // Interpolación del texto caligráfico
      const tX = -120 * (1 - progress);
      const tY = 120 * (1 - progress);
      sobreTexto.style.transform = `translate(${tX}px, ${tY}px)`;

      // Interpolación de la galleta
      const cX = -120 * (1 - progress);
      const cY = -120 * (1 - progress);
      sobreCookie.style.transform = `translate(${cX}px, ${cY}px)`;
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  document.addEventListener("astro:page-load", setupSobreAnimation);
</script>
