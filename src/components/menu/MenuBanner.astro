---
import { Image } from 'astro:assets';

import menuBanner1 from '../../assets/images/menu/home/menu-banner-1.png';
import menuBanner2 from '../../assets/images/menu/home/menu-banner-2.png';

/* ==========================================================================
   MenuBanner — carrusel de pósters full-bleed.
   Cada slide es UNA sola imagen que cubre todo el banner (object-cover).
   Para agregar más pósters: importa la imagen y añade una entrada al array.
   ========================================================================== */

const SLIDES = [
	{
		id: 'menu-banner-slide-1',
		img: menuBanner1,
		alt: 'Banner del menú Dimonca 1',
	},
	{
		id: 'menu-banner-slide-2',
		img: menuBanner2,
		alt: 'Banner del menú Dimonca 2',
	},
];
---

<section id="menu-banner" class="relative w-full max-w-[1400px] mx-auto px-4 sm:px-6 pt-4 pb-6">
	<!-- Contenedor del Banner: mismo tamaño de antes, ahora póster full-bleed -->
	<div
		id="menu-banner-box"
		class="group/banner relative w-full overflow-hidden rounded-[18px] shadow-sm min-h-[320px] sm:min-h-[360px] md:min-h-[420px] lg:min-h-[460px]"
	>
		<!-- Slides apilados: cada uno cubre el 100% del banner -->
		<div id="menu-banner-track" class="absolute inset-0">
			{SLIDES.map((slide, i) => (
				<div
					id={slide.id}
					class="menu-banner-slide absolute inset-0"
					data-slide={i}
					style={i !== 0 ? 'opacity: 0; visibility: hidden; pointer-events: none;' : ''}
				>
						<Image
						src={slide.img}
						alt={slide.alt}
						class="absolute inset-0 h-full w-full object-cover"
						loading={i === 0 ? 'eager' : 'lazy'}
					/>
				</div>
			))}
		</div>

		<!-- Flecha anterior -->
		<button
			id="menu-banner-prev"
			type="button"
			class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-40 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-pink text-white shadow-md border-2 border-white/80 transition-transform hover:scale-110 active:scale-95 cursor-pointer"
			aria-label="Anterior banner"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
				<path d="m15 18-6-6 6-6" />
			</svg>
		</button>

		<!-- Flecha siguiente -->
		<button
			id="menu-banner-next"
			type="button"
			class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-40 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-pink text-white shadow-md border-2 border-white/80 transition-transform hover:scale-110 active:scale-95 cursor-pointer"
			aria-label="Siguiente banner"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
				<path d="m9 18 6-6-6-6" />
			</svg>
		</button>

		<!-- Dots -->
		<div id="menu-banner-dots" class="absolute bottom-4 sm:bottom-5 left-1/2 -translate-x-1/2 z-40 flex items-center gap-2">
			{SLIDES.map((slide, i) => (
				<button
					type="button"
					class="menu-banner-dot h-2.5 rounded-full transition-all duration-300 cursor-pointer"
					data-dot={i}
					style={i === 0 ? 'width: 28px; background-color: #fff;' : 'width: 10px; background-color: rgba(255,255,255,0.5);'}
					aria-label={`Ir al banner ${i + 1}`}
				/>
			))}
		</div>
	</div>
</section>

<script>
	import { animate } from 'motion';

	// ======================================================================
	// MenuBanner: entrada + carrusel de pósters (crossfade con leve zoom).
	// - Entrada: caja fade + subida + escala (mismo lenguaje del home).
	// - Carrusel: autoplay 6s, flechas, dots, pausa en hover/focus.
	// - Respeta prefers-reduced-motion y re-inicializa en SPA (page-load).
	// ======================================================================
	const BANNER_EASE: [number, number, number, number] = [0.22, 1, 0.36, 1];
	const CROSSFADE_MS = 600;
	const AUTOPLAY_MS = 6000;

	const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function setMenuBannerStart() {
		if (reduceMotion()) return;
		const instant = { duration: 0 };
		const box = document.getElementById('menu-banner-box');
		const prev = document.getElementById('menu-banner-prev');
		const next = document.getElementById('menu-banner-next');
		const dots = document.getElementById('menu-banner-dots');
		if (!box) return;
		animate(box, { opacity: 0, y: 28, scale: 0.97 }, instant);
		if (prev) animate(prev, { opacity: 0 }, instant);
		if (next) animate(next, { opacity: 0 }, instant);
		if (dots) animate(dots, { opacity: 0 }, instant);
	}

	function playMenuBannerEnter() {
		if (reduceMotion()) return;
		const box = document.getElementById('menu-banner-box');
		const prev = document.getElementById('menu-banner-prev');
		const next = document.getElementById('menu-banner-next');
		const dots = document.getElementById('menu-banner-dots');
		if (!box) return;
		// Keyframes [origen, destino] para forzar el estado inicial en el primer frame.
		animate(box, { opacity: [0, 1], y: [28, 0], scale: [0.97, 1] }, { duration: 0.7, ease: BANNER_EASE });
		if (prev) animate(prev, { opacity: [0, 1] }, { duration: 0.5, delay: 0.4, ease: 'easeOut' });
		if (next) animate(next, { opacity: [0, 1] }, { duration: 0.5, delay: 0.4, ease: 'easeOut' });
		if (dots) animate(dots, { opacity: [0, 1] }, { duration: 0.5, delay: 0.5, ease: 'easeOut' });
	}

	function paintDots(dots: HTMLElement[], active: number) {
		dots.forEach((dot, i) => {
			const on = i === active;
			animate(
				dot,
				{ opacity: 1, scale: 1 },
				{ duration: 0 }
			);
			dot.style.width = on ? '28px' : '10px';
			dot.style.backgroundColor = on ? '#fff' : 'rgba(255,255,255,0.5)';
		});
	}

	function initMenuBannerCarousel() {
		const box = document.getElementById('menu-banner-box');
		// Guard por vista: evita doble-init en carga inicial (módulo + page-load).
		// En SPA el DOM se reemplaza y el dataset se pierde, así que re-inicializa solo.
		if (!box || box.dataset.carouselInit === '1') return;
		box.dataset.carouselInit = '1';

		const track = document.getElementById('menu-banner-track');
		const slides = track ? Array.from(track.querySelectorAll<HTMLElement>('.menu-banner-slide')) : [];
		const dots = Array.from(document.querySelectorAll<HTMLElement>('#menu-banner-dots .menu-banner-dot'));
		const prevBtn = document.getElementById('menu-banner-prev');
		const nextBtn = document.getElementById('menu-banner-next');
		if (slides.length <= 1) return;

		let current = 0;
		let busy = false;
		let timer: ReturnType<typeof setInterval> | null = null;

		function show(index: number) {
			if (busy || index === current || !slides[index]) return;
			busy = true;
			const from = slides[current];
			const to = slides[index];
			const d = CROSSFADE_MS / 1000;

			if (!reduceMotion()) {
				animate(from, { opacity: [1, 0] }, { duration: d, ease: 'easeInOut' }).then(() => {
					from.style.visibility = 'hidden';
					from.style.pointerEvents = 'none';
				});
			} else {
				from.style.opacity = '0';
				from.style.visibility = 'hidden';
				from.style.pointerEvents = 'none';
			}

			to.style.visibility = 'visible';
			to.style.pointerEvents = 'auto';
			if (!reduceMotion()) {
				animate(to, { opacity: [0, 1], scale: [1.04, 1] }, { duration: d, ease: 'easeOut' }).then(() => {
					busy = false;
				});
			} else {
				to.style.opacity = '1';
				busy = false;
			}

			current = index;
			paintDots(dots, current);
		}

		function next() {
			show((current + 1) % slides.length);
		}
		function prev() {
			show((current - 1 + slides.length) % slides.length);
		}
		function restartAutoplay() {
			stopAutoplay();
			if (reduceMotion()) return;
			timer = setInterval(next, AUTOPLAY_MS);
		}
		function stopAutoplay() {
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
		}

		prevBtn?.addEventListener('click', () => {
			prev();
			restartAutoplay();
		});
		nextBtn?.addEventListener('click', () => {
			next();
			restartAutoplay();
		});
		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				show(Number(dot.dataset.dot ?? 0));
				restartAutoplay();
			});
		});

		// Pausa el autoplay al interactuar con el banner.
		box.addEventListener('mouseenter', stopAutoplay);
		box.addEventListener('mouseleave', restartAutoplay);
		box.addEventListener('focusin', stopAutoplay);
		box.addEventListener('focusout', restartAutoplay);

		restartAutoplay();
	}

	let menuBannerScheduled = false;

	function scheduleMenuBannerEnter() {
		// Idempotente por vista: el módulo corre en carga inicial y page-load dispara
		// justo después — sin este guard la entrada se jugaría dos veces.
		if (menuBannerScheduled) return;
		menuBannerScheduled = true;
		if (!document.getElementById('menu-banner')) return;
		setMenuBannerStart();
		// Pequeño retardo para solaparse con la cortina de transición de página.
		setTimeout(playMenuBannerEnter, 120);
		initMenuBannerCarousel();
	}

	scheduleMenuBannerEnter();
	document.addEventListener('astro:before-preparation', () => {
		menuBannerScheduled = false;
	});
	document.addEventListener('astro:page-load', scheduleMenuBannerEnter);
</script>
