---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main id="main-content" class="flex min-h-screen items-center justify-center bg-beige px-6 pt-24 pb-20">
		<div class="flex w-full max-w-sm flex-col items-center gap-6 text-center">
			<h1 class="font-sans text-3xl font-extrabold text-pink">Mis pedidos</h1>
			<p class="font-sans text-sm text-brown/70">
				Aquí verás el historial de tus pedidos cuando esté disponible.
			</p>
		</div>
	</main>
</Layout>
