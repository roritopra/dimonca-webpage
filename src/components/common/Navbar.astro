---
import { Icon } from 'astro-icon/components';

const categories = [
	{ label: 'Galletas', img: '/images/home/navbar/cookie.png', imgHover: '/images/home/navbar/cookie-hover.png' },
	{ label: 'Cuchareables', img: '/images/home/navbar/cuchareable.png', imgHover: '/images/home/navbar/cuchareable-hover.png' },
	{ label: 'Brownies', img: '/images/home/navbar/brownie.png', imgHover: '/images/home/navbar/brownie-hover.png' },
	{ label: 'Pasteles', img: '/images/home/navbar/cake.png', imgHover: '/images/home/navbar/cake-hover.png' },
	{ label: 'Más Productos', img: '/images/home/navbar/crookie.png', imgHover: '/images/home/navbar/crookie-hover.png' },
];

const currentPath = Astro.url.pathname;
const isEncuentranos = currentPath === '/encuentranos' || currentPath === '/encuentranos/';
---

<header
	id="navbar"
	class="group relative z-[10000] w-full font-sans drop-shadow-[0px_11px_19.05px_rgba(58,32,14,0.14)]"
>
	<!-- Barra principal del Navbar -->
	<div
		id="nav-bar-container"
		class="relative z-50 flex items-center justify-between bg-beige px-6 py-4 sm:px-10 xl:justify-center xl:gap-x-[60px] xl:px-20 transition-colors duration-300"
	>
		<!-- Botón hamburguesa / X (visible en <xl) -->
		<button
			id="mobile-menu-btn"
			class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent text-pink p-1 transition-transform hover:scale-110 active:scale-95 xl:hidden z-50"
			type="button"
			aria-label="Abrir o cerrar menú de navegación"
			aria-expanded="false"
			aria-controls="mobile-menu-overlay"
		>
			<span id="menu-icon-bars" class="block">
				<Icon name="lucide:menu" class="h-8 w-8 stroke-[2.2]" aria-hidden="true" />
			</span>
			<span id="menu-icon-close" class="hidden">
				<Icon name="lucide:x" class="h-8 w-8 stroke-[2.2]" aria-hidden="true" />
			</span>
		</button>

		<a
			id="nav-encuentranos"
			class:list={[
				'hidden xl:flex xl:flex-1 min-w-0 items-center justify-center whitespace-nowrap p-2.5 text-[15px] leading-[1.2] no-underline transition-colors hover:opacity-75',
				isEncuentranos ? 'text-pink font-bold' : 'text-brown'
			]}
			href="/encuentranos"
			>Encuéntranos</a
		>
		<button
			id="menu-btn"
			class="relative hidden xl:flex h-[30px] flex-1 min-w-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap border-0 bg-transparent p-2.5 text-[15px] leading-[1.2] text-brown transition-colors hover:opacity-75 group-data-[open]:text-pink group-data-[open]:font-bold"
			type="button"
			aria-haspopup="true"
			aria-expanded="false"
			aria-controls="dropdown"
		>
			<span>Menú</span>
			<Icon
				name="lucide:chevron-down"
				class="h-5 w-5 shrink-0 transition-transform duration-200 group-data-[open]:rotate-180"
				aria-hidden="true"
			/>
		</button>

		<!-- Logo central que se traslada y agranda hacia abajo en blanco -->
		<a id="nav-center-logo" class="shrink-0 transition-transform hover:opacity-90 will-change-transform z-50 pointer-events-auto" href="/" aria-label="Dimonca, inicio">
			<img id="nav-center-logo-img" class="block h-9 sm:h-[46px] w-auto object-contain transition-[filter] duration-300" src="/images/shared/logo.png" alt="Dimonca" />
		</a>

		<a
			class="hidden xl:flex xl:flex-1 min-w-0 items-center justify-center whitespace-nowrap p-2.5 text-[15px] leading-[1.2] text-brown no-underline hover:opacity-75"
			href="/#sobre-nosotros"
			>Sobre Nosotros</a
		>

		<!-- Iconos Login y Carrito (cambian a blanco en menú móvil abierto) -->
		<div id="nav-action-icons" class="flex items-center justify-end gap-3 sm:gap-5 xl:flex-1 xl:justify-center z-50 text-pink transition-colors duration-300">
			<a
				id="nav-login-btn"
				class="flex h-9 w-9 items-center justify-center rounded-full transition-transform hover:scale-110 active:scale-95"
				href="/login"
				aria-label="Iniciar sesión o ver mi cuenta"
			>
				<Icon name="lucide:circle-user-round" class="h-7 w-7 sm:h-8 sm:w-8 stroke-[1.75]" aria-hidden="true" />
			</a>
			<button
				id="nav-cart-btn"
				class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent transition-transform hover:scale-110 active:scale-95"
				type="button"
				aria-label="Ver carrito de compras"
			>
				<Icon name="lucide:shopping-cart" class="h-6 w-6 sm:h-7 sm:w-7 stroke-[1.75]" aria-hidden="true" />
			</button>
		</div>
	</div>

	<nav
		class="invisible absolute top-full left-0 z-50 flex w-full items-start justify-center gap-[93px] bg-beige py-[18px] opacity-0 pointer-events-none"
		id="dropdown"
		aria-label="Categorías del menú"
	>
		{
			categories.map((c) => {
				if (c.label === 'Galletas' || c.label === 'Más Productos') {
					return (
						<a data-category="split" class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href={`/#${c.label.toLowerCase().replace(/\s+/g, '-')}`}>
							<div class="nav-cookie-wrap relative h-[121px] w-[121px]">
								<div class="nav-cookie-left absolute inset-y-0 left-0 w-1/2 overflow-hidden">
									<img class="absolute top-0 left-0 h-full w-[121px] max-w-none object-cover" src={c.img} alt={c.label} />
								</div>
								<div class="nav-cookie-right absolute inset-y-0 right-0 w-1/2 overflow-hidden">
									<img class="absolute top-0 right-0 h-full w-[121px] max-w-none object-cover" src={c.img} alt="" aria-hidden="true" />
								</div>
								<img class="nav-cookie-cracked pointer-events-none absolute inset-0 h-full w-full object-cover" style="opacity: 0;" src={c.imgHover} alt="" aria-hidden="true" />
							</div>
							<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
						</a>
					);
				} else if (c.label === 'Brownies') {
					return (
						<a data-category="brownies" class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href="/#brownies">
							<div class="relative h-[121px] w-[121px]">
								<img class="brownie-left absolute inset-0 block h-full w-full object-cover object-center opacity-0" src="/images/home/navbar/brownie-pistacho.png" alt="" aria-hidden="true" />
								<img class="brownie-right absolute inset-0 block h-full w-full object-cover object-center opacity-0" src="/images/home/navbar/brownie-redvelvet.png" alt="" aria-hidden="true" />
								<img class="brownie-center absolute inset-0 block h-full w-full object-cover object-center z-10" src="/images/home/navbar/brownie-clasico.png" alt={c.label} />
							</div>
							<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
						</a>
					);
				} else {
					return (
						<a class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href={`/#${c.label.toLowerCase().replace(/\s+/g, '-')}`}>
							<div class="relative h-[121px] w-[121px] overflow-clip">
								<img class="absolute inset-0 block h-full w-full object-cover object-center" src={c.img} alt={c.label} />
								<img class="absolute inset-0 block h-full w-full object-cover object-center opacity-0" src={c.imgHover} alt="" aria-hidden="true" />
							</div>
							<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
						</a>
					);
				}
			})
		}
	</nav>
</header>

<!-- Overlay del Menú Móvil a pantalla completa (caída en cascada de arriba a abajo) -->
<div
	id="mobile-menu-overlay"
	class="fixed inset-0 z-[9990] flex flex-col bg-pink text-white pointer-events-none overflow-y-auto xl:hidden pt-20 pb-12 px-8"
	style="transform: translateY(-100%);"
	aria-label="Menú móvil de navegación"
>
	<!-- Destino donde queda ubicado el logo agrandado en el menú desplegado -->
	<div id="mobile-menu-logo-target" class="h-24 w-full mb-4 flex items-center justify-center pointer-events-none" aria-hidden="true"></div>

	<!-- Lista de enlaces de navegación centrados con divisores finos como en la imagen -->
	<nav class="flex w-full max-w-[340px] mx-auto flex-col items-center text-center font-sans">
		<div class="mobile-nav-item w-full py-4.5 border-b border-white/40">
			<a
				class="block text-[22px] sm:text-[24px] font-normal tracking-wide text-white no-underline transition-opacity hover:opacity-80"
				href="/"
			>
				Inicio
			</a>
		</div>

		<div class="mobile-nav-item w-full py-4.5 border-b border-white/40">
			<a
				class="inline-flex items-center justify-center gap-2 text-[22px] sm:text-[24px] font-normal tracking-wide text-white no-underline transition-opacity hover:opacity-80"
				href="/#galletas"
			>
				<span>Menú</span>
				<Icon name="lucide:chevron-down" class="h-6 w-6 stroke-[2]" aria-hidden="true" />
			</a>
		</div>

		<div class="mobile-nav-item w-full py-4.5 border-b border-white/40">
			<a
				class="block text-[22px] sm:text-[24px] font-normal tracking-wide text-white no-underline transition-opacity hover:opacity-80"
				href="/encuentranos"
			>
				Encuéntranos
			</a>
		</div>

		<div class="mobile-nav-item w-full py-4.5 border-b border-white/40">
			<a
				class="block text-[22px] sm:text-[24px] font-normal tracking-wide text-white no-underline transition-opacity hover:opacity-80"
				href="/#sobre-nosotros"
			>
				Sobre Nosotros
			</a>
		</div>
	</nav>
</div>

<script>
	import { animate } from 'motion';

	function initNavbar() {
		const navbar = document.getElementById('navbar') as HTMLElement | null;
		const menuBtn = document.getElementById('menu-btn') as HTMLElement | null;
		const dropdown = document.getElementById('dropdown') as HTMLElement | null;

		if (!navbar || !menuBtn || !dropdown) return;

		const nav = navbar;
		const btn = menuBtn;
		const drop = dropdown;

		let isOpen = false;

		function open() {
			isOpen = true;
			nav.dataset.open = 'true';
			btn.setAttribute('aria-expanded', 'true');
			animate(
				drop,
				{ opacity: 1, y: 0, visibility: 'visible', pointerEvents: 'auto' },
				{ duration: 0.25, ease: 'easeOut' }
			);
		}

		function close() {
			isOpen = false;
			delete nav.dataset.open;
			btn.setAttribute('aria-expanded', 'false');
			animate(
				drop,
				{ opacity: 0, y: -8, visibility: 'hidden', pointerEvents: 'none' },
				{ duration: 0.2, ease: 'easeIn' }
			);
		}

		btn.addEventListener('click', () => {
			isOpen ? close() : open();
		});

		document.addEventListener('click', (e) => {
			if (isOpen && !nav.contains(e.target as Node)) {
				close();
			}
		});

		dropdown.querySelectorAll<HTMLAnchorElement>('[data-category="split"]').forEach((splitLink) => {
			const cookieWrap = splitLink.querySelector<HTMLElement>('.nav-cookie-wrap');
			const leftHalf = splitLink.querySelector<HTMLElement>('.nav-cookie-left');
			const rightHalf = splitLink.querySelector<HTMLElement>('.nav-cookie-right');
			const cracked = splitLink.querySelector<HTMLElement>('.nav-cookie-cracked');
			const label = splitLink.querySelector('p');
			let crackedTimeout: ReturnType<typeof setTimeout> | null = null;

			splitLink.addEventListener('mouseenter', () => {
				animate(cookieWrap!, { rotate: -17 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
				animate(leftHalf!, { x: -2 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
				animate(rightHalf!, { x: 2 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
				crackedTimeout = setTimeout(() => {
					animate(cracked!, { opacity: 1 }, { duration: 0.1, ease: 'easeOut' });
					animate(leftHalf!, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
					animate(rightHalf!, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
				}, 50);
				if (label) animate(label, { color: '#c34a70' }, { duration: 0.2, ease: 'easeOut' });
			});

			splitLink.addEventListener('mouseleave', () => {
				if (crackedTimeout) { clearTimeout(crackedTimeout); crackedTimeout = null; }
				animate(cookieWrap!, { rotate: 0 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
				animate(leftHalf!, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
				animate(rightHalf!, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
				animate(cracked!, { opacity: 0 }, { duration: 0.3, ease: 'easeInOut' });
				if (label) animate(label, { color: '#3a200e' }, { duration: 0.2, ease: 'easeOut' });
			});
		});

		const browniesLink = dropdown.querySelector<HTMLAnchorElement>('[data-category="brownies"]');
		if (browniesLink) {
			const bLeft = browniesLink.querySelector<HTMLElement>('.brownie-left');
			const bRight = browniesLink.querySelector<HTMLElement>('.brownie-right');
			const bCenter = browniesLink.querySelector<HTMLElement>('.brownie-center');
			const label = browniesLink.querySelector('p');

			browniesLink.addEventListener('mouseenter', () => {
				if (bLeft) {
					animate(bLeft, { opacity: 1, x: -30, y: 4, rotate: -12, scale: 0.9 }, { type: 'spring', stiffness: 300, damping: 20 });
				}
				if (bRight) {
					animate(bRight, { opacity: 1, x: 30, y: 4, rotate: 12, scale: 0.9 }, { type: 'spring', stiffness: 300, damping: 20 });
				}
				if (bCenter) {
					animate(bCenter, { scale: 1.05, y: -4 }, { type: 'spring', stiffness: 300, damping: 20 });
				}
				if (label) animate(label, { color: '#c34a70' }, { duration: 0.2, ease: 'easeOut' });
			});

			browniesLink.addEventListener('mouseleave', () => {
				if (bLeft) {
					animate(bLeft, { opacity: 0, x: 0, y: 0, rotate: 0, scale: 1 }, { duration: 0.25, ease: 'easeInOut' });
				}
				if (bRight) {
					animate(bRight, { opacity: 0, x: 0, y: 0, rotate: 0, scale: 1 }, { duration: 0.25, ease: 'easeInOut' });
				}
				if (bCenter) {
					animate(bCenter, { scale: 1, y: 0 }, { duration: 0.25, ease: 'easeInOut' });
				}
				if (label) animate(label, { color: '#3a200e' }, { duration: 0.2, ease: 'easeOut' });
			});
		}

		dropdown.querySelectorAll<HTMLAnchorElement>('a:not([data-category="split"]):not([data-category="brownies"])').forEach((link) => {
			const [img, imgHover] = link.querySelectorAll('img');
			const label = link.querySelector('p');

			link.addEventListener('mouseenter', () => {
				if (img && imgHover) {
					animate(img, { opacity: 0, scale: 0.94 }, { duration: 0.25, ease: 'easeOut' });
					animate(imgHover, { opacity: 1, scale: 1.06 }, { duration: 0.25, ease: 'easeOut' });
				}
				if (label) animate(label, { color: '#c34a70' }, { duration: 0.2, ease: 'easeOut' });
			});

			link.addEventListener('mouseleave', () => {
				if (img && imgHover) {
					animate(img, { opacity: 1, scale: 1 }, { duration: 0.25, ease: 'easeOut' });
					animate(imgHover, { opacity: 0, scale: 0.94 }, { duration: 0.25, ease: 'easeOut' });
				}
				if (label) animate(label, { color: '#3a200e' }, { duration: 0.2, ease: 'easeOut' });
			});
		});

		// Control del menú móvil (Overlay rosado con caída en cascada, alternancia de icono a X y traslado de logo)
		const mobileMenuBtn = document.getElementById('mobile-menu-btn');
		const menuIconBars = document.getElementById('menu-icon-bars');
		const menuIconClose = document.getElementById('menu-icon-close');
		const mobileOverlay = document.getElementById('mobile-menu-overlay');
		const navBarContainer = document.getElementById('nav-bar-container');
		const navActionIcons = document.getElementById('nav-action-icons');
		const mobileNavItems = Array.from(document.querySelectorAll<HTMLElement>('.mobile-nav-item'));
		const centerLogo = document.getElementById('nav-center-logo');
		const centerLogoImg = document.getElementById('nav-center-logo-img') as HTMLImageElement | null;

		let isMobileOpen = false;

		function toggleMobileMenu() {
			if (isMobileOpen) {
				closeMobileMenu();
			} else {
				openMobileMenu();
			}
		}

		function openMobileMenu() {
			if (isMobileOpen || !mobileOverlay) return;
			isMobileOpen = true;
			mobileMenuBtn?.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';

			// 1. Alternar icono del botón a X y cambiar colores de la barra superior a blanco
			if (menuIconBars && menuIconClose) {
				menuIconBars.classList.add('hidden');
				menuIconBars.classList.remove('block');
				menuIconClose.classList.remove('hidden');
				menuIconClose.classList.add('block');
			}
			mobileMenuBtn?.classList.remove('text-pink');
			mobileMenuBtn?.classList.add('text-white');

			navActionIcons?.classList.remove('text-pink');
			navActionIcons?.classList.add('text-white');

			navBarContainer?.classList.remove('bg-beige');
			navBarContainer?.classList.add('bg-transparent');

			// 2. Caída en cascada del overlay rosado de arriba hacia abajo
			mobileOverlay.style.pointerEvents = 'auto';
			animate(
				mobileOverlay,
				{ transform: ['translateY(-100%)', 'translateY(0%)'] },
				{ duration: 0.45, ease: [0.16, 1, 0.3, 1] }
			);

			// 3. Traslado del logo de Dimonca hacia abajo, agrandándolo y volviéndolo blanco
			if (centerLogo && centerLogoImg) {
				animate(
					centerLogo,
					{ y: [0, 95], scale: [1, 1.7] },
					{ duration: 0.48, ease: [0.16, 1, 0.3, 1] }
				);
				centerLogoImg.style.filter = 'brightness(0) invert(1)';
			}

			// 4. Entrada secuencial de los enlaces del menú
			mobileNavItems.forEach((item, index) => {
				animate(
					item,
					{ opacity: [0, 1], y: [20, 0] },
					{ duration: 0.35, delay: 0.2 + index * 0.06, ease: 'easeOut' }
				);
			});
		}

		function closeMobileMenu() {
			if (!isMobileOpen || !mobileOverlay) return;
			isMobileOpen = false;
			mobileMenuBtn?.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';

			// 1. Retornar icono del botón a barras y colores a rosado
			if (menuIconBars && menuIconClose) {
				menuIconBars.classList.remove('hidden');
				menuIconBars.classList.add('block');
				menuIconClose.classList.add('hidden');
				menuIconClose.classList.remove('block');
			}
			mobileMenuBtn?.classList.remove('text-white');
			mobileMenuBtn?.classList.add('text-pink');

			navActionIcons?.classList.remove('text-white');
			navActionIcons?.classList.add('text-pink');

			navBarContainer?.classList.remove('bg-transparent');
			navBarContainer?.classList.add('bg-beige');

			// 2. Retornar logo a su posición, tamaño y color original
			if (centerLogo && centerLogoImg) {
				animate(
					centerLogo,
					{ y: [95, 0], scale: [1.7, 1] },
					{ duration: 0.38, ease: [0.16, 1, 0.3, 1] }
				);
				centerLogoImg.style.filter = 'none';
			}

			// 3. Subir el overlay rosado hacia arriba
			animate(
				mobileOverlay,
				{ transform: ['translateY(0%)', 'translateY(-100%)'] },
				{ duration: 0.38, ease: [0.16, 1, 0.3, 1] }
			).then(() => {
				mobileOverlay.style.pointerEvents = 'none';
			});
		}

		mobileMenuBtn?.addEventListener('click', toggleMobileMenu);

		// Cerrar menú al hacer click en cualquier enlace interno del menú móvil
		mobileNavItems.forEach((item) => {
			const link = item.querySelector('a');
			link?.addEventListener('click', closeMobileMenu);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initNavbar);
	} else {
		initNavbar();
	}
	document.addEventListener('astro:page-load', initNavbar);
</script>