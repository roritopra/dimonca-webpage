---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/common/Navbar.astro';
import Footer from '../../../components/common/Footer.astro';
import CarruselScroll from '../../../components/common/CarruselScroll.astro';
import BoxBuilder from '../../../components/menu/BoxBuilder';
import { getProducts } from '../../../lib/productsApi';
import type { Product } from '../../../types/products';

// GET a Supabase en tiempo de build: los datos de la caja salen de la BD.
export async function getStaticPaths() {
	const products = await getProducts();
	const boxProducts = products.filter((p) => p.productType === 'custom_box');

	return boxProducts.map((product) => ({
		params: { id: product.id },
		props: {
			product,
		},
	}));
}

interface Props {
	product: Product;
}

const { product } = Astro.props;

if (!product || product.productType !== 'custom_box') {
	return Astro.redirect('/menu');
}
---

<Layout>
	<Navbar />

	<main id="main-content" class="bg-beige m-0 px-0 pb-0 pt-20 sm:pt-24 lg:pt-20 xl:pt-0">
		{/* Experiencia de Armado de Caja (Mitad Izquierda: Caja con fondo punteado | Mitad Derecha: Galletas y Footer) */}
		<BoxBuilder client:load key={product.id} boxProduct={product} />

		{/* Carrusel de cinta con movimiento infinito en rosado */}
		<CarruselScroll variant="pink" />
	</main>

	<Footer />
</Layout>