---
import { Icon } from "astro-icon/components";

const products = [
  {
    name: "Cuchareable de Red Velvet",
    normalImg: "/images/cuchareable-more-than.png",
    hoverImg: "/images/cuchareable-more-than-hover.png",
    alt: "Cuchareable de Red Velvet",
  },
  {
    name: "Cuchareable de Red Velvet",
    normalImg: "/images/mini-cake-more-than.png",
    hoverImg: "/images/mini-cake-more-than-hover.png",
    alt: "Mini Cake",
  },
  {
    name: "Cuchareable de Red Velvet",
    normalImg: "/images/cake-more-than.png",
    hoverImg: "/images/cake-more-than-hover.png",
    alt: "Pastel",
  },
];
---

<div
  id="more-than-interactive"
  class="relative flex w-[380px] max-w-full flex-col items-center justify-center select-none cursor-pointer"
>
  <!-- Contenedor del producto -->
  <div class="product-container relative flex h-[420px] w-full items-center justify-center">
    {products.map((item, idx) => (
      <div
        class={`product-slide absolute inset-0 flex items-center justify-center ${
          idx === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"
        }`}
        data-index={idx}
      >
        <!-- Imagen Normal -->
        <img
          src={item.normalImg}
          alt={item.alt}
          class="product-img-normal block h-full w-auto object-contain drop-shadow-[0px_14px_24px_rgba(58,32,14,0.18)]"
        />
        <!-- Imagen Hover -->
        <img
          src={item.hoverImg}
          alt={`${item.alt} variante`}
          class="product-img-hover absolute inset-0 m-auto block h-full w-auto object-contain opacity-0 drop-shadow-[0px_14px_24px_rgba(58,32,14,0.18)]"
        />

        <!-- Texto flotante en estilo script -->
        <div class="product-title-badge pointer-events-none absolute top-[70px] right-[-10px] z-10 max-w-[210px]">
          <p
            class="font-exmouth text-[44px] leading-[1.05] text-brown [-webkit-text-stroke:8px_#ffffff]"
            style="paint-order: stroke fill;"
          >
            {item.name}
          </p>
        </div>
      </div>
    ))}

    <!-- Botón flotante inferior izquierdo con corazón -->
    <button
      id="more-than-next-btn"
      type="button"
      class="group absolute bottom-[35px] left-[15px] z-20 flex h-[58px] w-[58px] items-center justify-center rounded-full border-[3px] border-white bg-[#6ca7d5] text-white shadow-[0px_8px_16px_rgba(108,167,213,0.4)] transition-transform duration-200 hover:scale-105 hover:bg-[#5b96c4]"
      aria-label="Siguiente postre"
    >
      <Icon name="lucide:heart" class="h-7 w-7 transition-transform duration-200 group-hover:scale-110" />
    </button>
  </div>
</div>

<script>
  import { animate } from "motion";

  const root = document.getElementById("more-than-interactive");
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".product-slide"));
    const nextBtn = document.getElementById("more-than-next-btn");
    let currentIndex = 0;
    let isHovered = false;

    // Control de hover para cada slide
    slides.forEach((slide) => {
      const normal = slide.querySelector<HTMLElement>(".product-img-normal");
      const hover = slide.querySelector<HTMLElement>(".product-img-hover");

      if (normal && hover) {
        slide.addEventListener("mouseenter", () => {
          isHovered = true;
          animate(normal, { opacity: 0 }, { duration: 0.2, ease: "easeOut" });
          animate(hover, { opacity: 1 }, { duration: 0.2, ease: "easeOut" });
        });

        slide.addEventListener("mouseleave", () => {
          isHovered = false;
          animate(normal, { opacity: 1 }, { duration: 0.2, ease: "easeInOut" });
          animate(hover, { opacity: 0 }, { duration: 0.2, ease: "easeInOut" });
        });
      }
    });

    // Cambio suave y directo de producto al hacer click (estilo hover / crossfade limpio)
    const nextProduct = () => {
      if (slides.length <= 1) return;

      const prevIndex = currentIndex;
      currentIndex = (currentIndex + 1) % slides.length;

      const prevSlide = slides[prevIndex];
      const nextSlide = slides[currentIndex];

      if (prevSlide && nextSlide) {
        const nextNormal = nextSlide.querySelector<HTMLElement>(".product-img-normal");
        const nextHover = nextSlide.querySelector<HTMLElement>(".product-img-hover");

        // Mantener el estado de hover si el cursor está encima al hacer clic
        if (nextNormal && nextHover) {
          if (isHovered) {
            nextNormal.style.opacity = "0";
            nextHover.style.opacity = "1";
          } else {
            nextNormal.style.opacity = "1";
            nextHover.style.opacity = "0";
          }
        }

        // Transición de cambio directo estilo hover (crossfade de 0.2s)
        animate(prevSlide, { opacity: 0 }, { duration: 0.2, ease: "easeInOut" }).then(() => {
          prevSlide.style.pointerEvents = "none";
        });

        nextSlide.style.pointerEvents = "auto";
        animate(nextSlide, { opacity: [0, 1] }, { duration: 0.2, ease: "easeInOut" });
      }
    };

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      nextProduct();
    });

    root.addEventListener("click", nextProduct);
  }
</script>