---
import { Icon } from 'astro-icon/components';

const stripes = Array.from({ length: 24 }, (_, i) => ({
	left: (i * (62.1 / 1440)) * 100,
	width: (31 / 1440) * 100,
	up: i % 2 === 0,
}));
---

<section class="relative h-220 w-full overflow-hidden bg-brown-400">
	<div id="hero-carousel" class="absolute inset-0">
		<!-- Slide 1: Galleta Habibi -->
		<div id="hero-slide-1" class="absolute inset-0" data-slide="0">
			<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
				{
					stripes.map((s) => (
						<div
							class="hero-stripe absolute top-0 bottom-0 bg-[#89796e]"
							style={`left: ${s.left}%; width: ${s.width}%;`}
							data-dir={s.up ? 'up' : 'down'}
						></div>
					))
				}
			</div>

			<div class="absolute top-0 bottom-0 left-1/2 flex min-w-360 -translate-x-1/2 items-center">
				<div class="hero-content relative h-[775px] w-full">
					<div class="pointer-events-none absolute top-29.5 left-111.5 h-131 w-131 mix-blend-overlay" aria-hidden="true">
						<img class="block h-full w-full" src="/images/ellipse-hero.svg" alt="" />
					</div>

					<p
						class="pointer-events-none absolute top-[33.68px] left-[157.8px] z-1 font-script text-[203.79px] leading-none whitespace-nowrap text-pink-200"
						aria-hidden="true"
					>
						<span class="hero-title-word inline-block" data-dir="left">Galleta</span>
					</p>
					<p
						class="pointer-events-none absolute top-[33.68px] left-[1252.2px] z-1 w-[502.2px] -translate-x-full text-right font-script text-[203.79px] leading-none whitespace-nowrap text-pink-200"
						aria-hidden="true"
					>
						<span class="hero-title-word inline-block" data-dir="right">Habibi</span>
					</p>

					<div id="hero-cookie" class="absolute top-[52.08px] left-[382.25px] z-2 h-[650px] w-[650px]">
						<div id="hero-cookie-left" class="absolute inset-y-0 left-0 w-1/2 overflow-hidden">
							<img
								class="absolute top-0 left-0 h-full w-[650px] max-w-none"
								src="/images/cream-hero.png"
								alt="Galleta Habibi"
							/>
						</div>
						<div id="hero-cookie-right" class="absolute inset-y-0 right-0 w-1/2 overflow-hidden">
							<img
								class="absolute top-0 right-0 h-full w-[650px] max-w-none"
								src="/images/cream-hero.png"
								alt="Galleta Habibi"
							/>
						</div>
						<img
							id="hero-cookie-cracked"
							class="pointer-events-none absolute inset-0 h-full w-full object-cover"
							style="opacity: 0;"
							src="/images/cookie-hero.png"
							alt="Galleta Habibi partida con crema de pistacho"
						/>
					</div>

					<div id="hero-star" class="absolute top-[186.68px] left-200 z-3 h-[279.66px] w-[282.03px]">
						<img class="block h-full w-full" src="/images/star-hero.svg" alt="" />
						<span
							class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-sans text-[27px] leading-[1.2] font-bold whitespace-nowrap text-center text-brown"
							style="margin-left: 14.4px; margin-top: -12.6px"
							>Nueva</span
						>
					</div>

					<div class="hero-left-info absolute top-[310.9px] left-53.5 z-3 w-60.75">
						<h2 class="mb-3 font-sans text-[38px] leading-[1.2] font-bold text-beige">
							Galleta Habibi
						</h2>
						<p class="font-sans text-[21.6px] leading-[1.2] text-beige">
							Galleta de chocolate tipo brownie, rellena con una exquisita crema de pistacho artesanal.
							Un postre al mejor estilo Dubai.
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Slide 2: Crookie Chips -->
		<div
			id="hero-slide-2"
			class="absolute inset-0 bg-blue-500 transition-opacity duration-300"
			data-slide="1"
			style="opacity: 0; visibility: hidden; pointer-events: none;"
		>
			<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
				{
					stripes.map((s) => (
						<div
							class="hero-stripe absolute top-0 bottom-0 bg-[#d7ebfb]"
							style={`left: ${s.left}%; width: ${s.width}%;`}
							data-dir={s.up ? 'up' : 'down'}
						></div>
					))
				}
			</div>

			<div class="absolute top-0 bottom-0 left-1/2 flex min-w-360 -translate-x-1/2 items-center">
				<div class="hero-content relative h-[775px] w-full">
					<div class="pointer-events-none absolute top-29.5 left-111.5 h-131 w-131 mix-blend-overlay" aria-hidden="true">
						<img class="block h-full w-full" src="/images/ellipse-hero-blue.svg" alt="" />
					</div>

					<p
						class="pointer-events-none absolute top-[33.68px] left-[157.8px] z-1 font-script text-[203.79px] leading-none whitespace-nowrap text-pink"
						aria-hidden="true"
					>
						<span class="hero-title-word inline-block" data-dir="left">Crookie</span>
					</p>
					<p
						class="pointer-events-none absolute top-[33.68px] left-[1252.2px] z-1 w-[502.2px] -translate-x-full text-right font-script text-[203.79px] leading-none whitespace-nowrap text-pink"
						aria-hidden="true"
					>
						<span class="hero-title-word inline-block" data-dir="right">Chips</span>
					</p>

					<div id="hero-crookie" class="absolute top-[52.08px] left-[382.25px] z-2 h-[650px] w-[650px]">
						<div id="hero-crookie-left" class="absolute inset-y-0 left-0 w-1/2 overflow-hidden">
							<img
								class="absolute top-0 left-0 h-full w-[650px] max-w-none object-cover"
								src="/images/crookie-hero.png"
								alt="Crookie Chips"
							/>
						</div>
						<div id="hero-crookie-right" class="absolute inset-y-0 right-0 w-1/2 overflow-hidden">
							<img
								class="absolute top-0 right-0 h-full w-[650px] max-w-none object-cover"
								src="/images/crookie-hero.png"
								alt="Crookie Chips"
							/>
						</div>
						<img
							id="hero-crookie-split"
							class="pointer-events-none absolute inset-0 h-full w-full object-cover"
							style="opacity: 0;"
							src="/images/crookie-hero-split.png"
							alt="Crookie partido con crema de nutella"
						/>
					</div>

					<div id="hero-star-2" class="absolute top-[186.68px] left-200 z-3 h-[311px] w-[314px]">
						<img class="block h-full w-full" src="/images/star-hero-2.svg" alt="" />
						<span
							class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-sans text-[30px] leading-[1.2] font-bold whitespace-nowrap text-center text-white"
							style="margin-left: 14.5px; margin-top: -14.4px"
							>Nueva</span
						>
					</div>

					<div class="hero-left-info absolute top-[310.9px] left-53.5 z-3 w-60.75">
						<h2 class="mb-3 font-sans text-[38px] leading-[1.2] font-bold text-brown">
							Crookie Chips
						</h2>
						<p class="font-sans text-[21.6px] leading-[1.2] text-brown-600">
							Croissant + galleta de chips de chocolate + relleno de nutella. Hojaldrado, super crocante y con
							un centro cremoso de chocolate.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Capa compartida: botones del carrusel -->
	<div class="pointer-events-none absolute top-0 bottom-0 left-1/2 z-10 flex min-w-360 -translate-x-1/2 items-center">
		<div class="relative h-[775px] w-full">
			<a
				class="pointer-events-auto absolute top-164.5 left-148.75 z-3 flex h-12.25 w-[218.1px] items-center justify-center gap-2 whitespace-nowrap rounded-[57px] bg-pink px-4 py-2 font-sans text-[19px] leading-[1.2] font-bold text-beige no-underline hover:brightness-95"
				href="#menu"
			>
				Ver menú
				<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[22.68px] bg-beige p-[6.67px]">
					<img class="block h-[16.01px] w-[16.01px]" src="/images/chef-hat.svg" alt="" />
				</span>
			</a>

			<button
				id="hero-prev"
				class="pointer-events-auto absolute top-83 left-23.75 z-4 flex h-20 w-20 cursor-pointer items-center justify-center rounded-full border-[3px] border-white bg-pink text-beige hover:brightness-95"
				type="button"
				aria-label="Anterior"
			>
				<Icon name="lucide:chevron-left" class="h-10 w-10 shrink-0" aria-hidden="true" />
			</button>
			<button
				id="hero-next"
				class="pointer-events-auto absolute top-[268.13px] left-[1219.13px] z-4 flex h-20 w-20 cursor-pointer items-center justify-center rounded-full border-[3px] border-white bg-pink text-beige hover:brightness-95"
				type="button"
				aria-label="Siguiente"
			>
				<Icon name="lucide:chevron-right" class="h-10 w-10 shrink-0" aria-hidden="true" />
			</button>
		</div>
	</div>
</section>

<script>
	import { animate } from 'motion';

	const carousel = document.getElementById('hero-carousel');
	const slides = carousel ? Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]')) : [];
	const prevBtn = document.getElementById('hero-prev');
	const nextBtn = document.getElementById('hero-next');

	const EXIT_MS = 600;
	const PAUSE_MS = 200;
	const ENTER_MS = 600;

	let current = 0;
	let transitioning = false;

	const goTo = (index: number) => {
		if (transitioning || index === current || !slides[index]) return;
		transitioning = true;

		resetCookie();
		resetCrookie();

		const from = slides[current];
		const to = slides[index];
		const fromContent = from.querySelector<HTMLElement>('.hero-content');
		const toContent = to.querySelector<HTMLElement>('.hero-content');
		const fromLeftInfo = from.querySelector<HTMLElement>('.hero-left-info');
		const toLeftInfo = to.querySelector<HTMLElement>('.hero-left-info');
		const fromCookieImg = from.querySelector<HTMLElement>('#hero-cookie, #hero-crookie');
		const toCookieImg = to.querySelector<HTMLElement>('#hero-cookie, #hero-crookie');
		const fromStar = from.querySelector<HTMLElement>('#hero-star, #hero-star-2');
		const toStar = to.querySelector<HTMLElement>('#hero-star, #hero-star-2');
		const fromStripes = Array.from(from.querySelectorAll<HTMLElement>('.hero-stripe'));
		const toStripes = Array.from(to.querySelectorAll<HTMLElement>('.hero-stripe'));
		const fromTitles = Array.from(from.querySelectorAll<HTMLElement>('.hero-title-word'));
		const toTitles = Array.from(to.querySelectorAll<HTMLElement>('.hero-title-word'));
		const travel = from.offsetHeight;

		fromStripes.forEach((stripe) => {
			const dir = stripe.dataset.dir === 'up' ? -1 : 1;
			animate(
				stripe,
				{ y: dir * travel, opacity: 0 },
				{ duration: EXIT_MS / 1000, ease: 'easeInOut' }
			);
		});

		fromTitles.forEach((word) => {
			const isLeft = word.dataset.dir === 'left';
			const targetX = isLeft ? -150 : 150;
			animate(
				word,
				{ x: targetX, opacity: 0 },
				{ duration: EXIT_MS / 1000, ease: 'easeInOut' }
			);
		});

		if (fromLeftInfo) {
			animate(
				fromLeftInfo,
				{ x: -120, opacity: 0 },
				{ duration: EXIT_MS / 1000, ease: 'easeInOut' }
			);
		}

		if (fromCookieImg) {
			animate(
				fromCookieImg,
				{ opacity: 0, scale: 0.8, rotate: -25 },
				{ duration: EXIT_MS / 1000, ease: 'backIn' }
			);
		}

		if (fromStar) {
			animate(
				fromStar,
				{ opacity: 0, scale: 0.85, y: 24, rotate: -45 },
				{ duration: EXIT_MS / 1000, ease: 'backIn' }
			);
		}

		setTimeout(() => {
			animate(from, { opacity: 0 }, { duration: 0.3, ease: 'easeInOut' }).then(() => {
				from.style.visibility = 'hidden';
				from.style.pointerEvents = 'none';
			});

			to.style.visibility = 'visible';
			to.style.pointerEvents = 'auto';
			animate(to, { opacity: [0, 1] }, { duration: 0.4, ease: 'easeInOut' });

			toStripes.forEach((stripe) => {
				const dir = stripe.dataset.dir === 'up' ? -1 : 1;
				animate(
					stripe,
					{ y: [dir * travel, 0], opacity: [0, 1] },
					{ duration: ENTER_MS / 1000, ease: 'easeInOut' }
				);
			});
			toTitles.forEach((word) => {
				const isLeft = word.dataset.dir === 'left';
				const startX = isLeft ? -150 : 150;
				animate(
					word,
					{ x: [startX, 0], opacity: [0, 1] },
					{ duration: ENTER_MS / 1000, ease: 'easeOut' }
				);
			});
			if (toLeftInfo) {
				animate(
					toLeftInfo,
					{ x: [-120, 0], opacity: [0, 1] },
					{ duration: ENTER_MS / 1000, ease: 'easeOut' }
				);
			}
			if (toCookieImg) {
				animate(
					toCookieImg,
					{ opacity: [0, 1], scale: [0.8, 1], rotate: [25, 0] },
					{ duration: ENTER_MS / 1000, ease: 'backOut' }
				);
			}
			if (toStar) {
				animate(
					toStar,
					{ opacity: [0, 1], scale: [0.9, 1], y: [-16, 0], rotate: [45, 0] },
					{ duration: ENTER_MS / 1000, ease: 'backOut' }
				);
			}
			transitioning = false;
		}, EXIT_MS + PAUSE_MS);

		current = index;
	};

	prevBtn?.addEventListener('click', () => goTo(current === 0 ? slides.length - 1 : current - 1));
	nextBtn?.addEventListener('click', () => goTo(current === slides.length - 1 ? 0 : current + 1));

	const cookie = document.getElementById('hero-cookie');
	const leftHalf = document.getElementById('hero-cookie-left');
	const rightHalf = document.getElementById('hero-cookie-right');
	const cracked = document.getElementById('hero-cookie-cracked');
	const star = document.getElementById('hero-star');

	let cookieTimeout: ReturnType<typeof setTimeout> | null = null;

	const startCookie = () => {
		if (cookieTimeout || !cookie || !leftHalf || !rightHalf || !cracked) return;
		const slide = cookie.offsetWidth / 522.26 * 2;
		animate(cookie, { rotate: -15 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		animate(leftHalf, { x: -slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		animate(rightHalf, { x: slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });

		cookieTimeout = setTimeout(() => {
			animate(cracked, { opacity: 1 }, { duration: 0.1, ease: 'easeOut' });
			animate(leftHalf, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
			animate(rightHalf, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
			animate(cookie, { scale: 1.1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		}, 50);
	};

	const resetCookie = () => {
		if (!cookie || !leftHalf || !rightHalf || !cracked) return;
		if (cookieTimeout) {
			clearTimeout(cookieTimeout);
			cookieTimeout = null;
		}
		animate(cookie, { rotate: 0, scale: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		animate(leftHalf, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		animate(rightHalf, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		animate(cracked, { opacity: 0 }, { duration: 0.3, ease: 'easeInOut' });
	};

	cookie?.addEventListener('mouseenter', startCookie);
	cookie?.addEventListener('mouseleave', resetCookie);
	star?.addEventListener('mouseenter', startCookie);
	star?.addEventListener('mouseleave', resetCookie);

	const crookie = document.getElementById('hero-crookie');
	const crookieLeft = document.getElementById('hero-crookie-left');
	const crookieRight = document.getElementById('hero-crookie-right');
	const crookieSplit = document.getElementById('hero-crookie-split');
	const star2 = document.getElementById('hero-star-2');

	let crookieTimeout: ReturnType<typeof setTimeout> | null = null;

	const startCrookie = () => {
		if (crookieTimeout || !crookie || !crookieLeft || !crookieRight || !crookieSplit) return;
		const slide = crookie.offsetWidth / 650 * 3;
		animate(crookie, { rotate: -3.64 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		animate(crookieLeft, { x: -slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
		animate(crookieRight, { x: slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });

		crookieTimeout = setTimeout(() => {
			animate(crookieSplit, { opacity: 1 }, { duration: 0.1, ease: 'easeOut' });
			animate(crookieLeft, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
			animate(crookieRight, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
			animate(crookie, { scale: 1.065 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		}, 50);
	};

	const resetCrookie = () => {
		if (!crookie || !crookieLeft || !crookieRight || !crookieSplit) return;
		if (crookieTimeout) {
			clearTimeout(crookieTimeout);
			crookieTimeout = null;
		}
		animate(crookie, { rotate: 0, scale: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		animate(crookieLeft, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		animate(crookieRight, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
		animate(crookieSplit, { opacity: 0 }, { duration: 0.3, ease: 'easeInOut' });
	};

	crookie?.addEventListener('mouseenter', startCrookie);
	crookie?.addEventListener('mouseleave', resetCrookie);
	star2?.addEventListener('mouseenter', startCrookie);
	star2?.addEventListener('mouseleave', resetCrookie);
</script>
