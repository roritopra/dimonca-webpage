---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
---

<Layout>
	<Navbar />
	<main id="main-content" class="flex min-h-screen flex-col items-center justify-center bg-beige px-6 text-center">
		<h1 class="font-sans text-4xl font-bold text-brown">
			Hola, estás en Encuéntranos
		</h1>
		<a
			href="/"
			class="mt-6 inline-flex items-center justify-center rounded-full bg-pink px-6 py-3 font-sans text-base font-bold text-beige transition-transform hover:scale-105"
		>
			Volver al inicio
		</a>
	</main>
</Layout>
