# ─────────────────────────────────────────────────────────────
# Dimonca · Variables de entorno (ejemplo)
# Copia este archivo como ".env" (o ".env.local") y rellena los valores.
# NUNCA subas el .env real a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Supabase — Project URL
# Dónde conseguirlo: Supabase Dashboard → botón "Connect" (arriba) → pestaña
# "App Frameworks" → Astro. También está en Project Settings → API → Project URL.
# Para este proyecto es: https://lllfiozaabjevitbpfch.supabase.co
PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Supabase — Publishable key (la clave PÚBLICA, segura para el front)
# Dónde conseguirlo: Supabase Dashboard → Project Settings → API Keys →
# clave "publishable" (formato sb_publishable_...).
# Es la sucesora de la antigua "anon key": ambas son públicas por diseño,
# la seguridad real la dan las políticas RLS de la base de datos.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXX
