---
import { Icon } from 'astro-icon/components';
---

<section class="w-full bg-beige">
	<div class="mx-auto flex min-h-[400px] max-w-[1440px] items-center justify-between gap-12 px-20 py-16">
		<div class="flex w-full max-w-[450px] flex-col items-start gap-6">
			<div class="relative w-full">
				<p class="m-0 ml-1 font-sans text-[47px] leading-[1.2] font-bold text-brown">
					Encuentranos en:
				</p>
				<span
					class="absolute top-[46px] left-0 font-exmouth text-[81px] leading-[1.2] text-pink whitespace-nowrap"
					aria-hidden="true"
					>Valle del Lili</span
				>
			</div>
			<div class="flex items-center gap-[9px]">
				<img class="block size-10 shrink-0" src="/images/marker-pin.svg" alt="" aria-hidden="true" />
				<p class="m-0 font-sans text-[30px] leading-[1.2] text-brown">Cra 90 #42-28</p>
			</div>
			<p class="m-0 max-w-[410px] text-[19px] leading-[1.2] text-brown">
				Te esperamos con el aroma de galletas recién horneadas y muchas delicias para compartir.
			</p>
			<a
				class="group flex h-[52px] w-[210px] items-center justify-center gap-3 whitespace-nowrap rounded-[57px] bg-pink px-6 py-3 font-sans text-[19px] leading-[1.2] font-bold text-beige no-underline shadow-[0_4px_14px_rgba(244,93,140,0.4)] transition-all duration-300 hover:shadow-[0_6px_20px_rgba(244,93,140,0.6)] hover:brightness-95"
				href="#como-llegar"
			>
				Como llegar
				<span
					class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-beige p-[7px] transition-transform duration-300 group-hover:scale-110"
				>
					<Icon name="lucide:map" class="block h-[16px] w-[16px] text-pink" aria-hidden="true" />
				</span>
			</a>
		</div>
	</div>
</section>