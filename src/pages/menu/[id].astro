---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import CarruselScroll from '../../components/common/CarruselScroll.astro';
import ProductDetailActions from '../../components/menu/ProductDetailActions';
import MenuCard from '../../components/menu/MenuCard';
import { PRODUCTS } from '../../data/products';
import type { Product, ProductCategory } from '../../types/products';

export function getStaticPaths() {
	// Solo productos normales / individuales
	const singleProducts = PRODUCTS.filter((p) => p.productType === 'single');

	return singleProducts.map((product) => ({
		params: { id: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;

if (!product || product.productType !== 'single') {
	return Astro.redirect('/menu');
}

// Tema visual por categoría: el diseño de la página depende del tipo de producto.
// Galletas: fondo rosado con puntitos + badge estrella azul (diseño final de Figma).
const DETAIL_THEMES: Record<ProductCategory, { bg: string; dot: string; star: string }> = {
	galletas: { bg: '#f8a9c6', dot: '#9accf4', star: '#9accf4' },
	brownies: { bg: '#f8a9c6', dot: '#9accf4', star: '#9accf4' },
	tortas: { bg: '#f8a9c6', dot: '#9accf4', star: '#9accf4' },
	otros: { bg: '#f8a9c6', dot: '#9accf4', star: '#9accf4' },
	// TODO: diseño propio para cuchareables (incluye condicional de toppings)
	cuchareables: { bg: '#f8a9c6', dot: '#9accf4', star: '#9accf4' },
};
const theme = DETAIL_THEMES[product.category] ?? DETAIL_THEMES.otros;

// Galería de fotos del producto (se reemplaza/puebla con fotos reales por producto)
const gallery = [product.imageSrc, product.imageHoverSrc].filter(Boolean) as string[];

const polkaBgStyle = `background-color:${theme.bg};background-image:radial-gradient(${theme.dot} 7%, transparent 8%),radial-gradient(${theme.dot} 7%, transparent 8%);background-position:0 0,17px 17px;background-size:34px 34px;`;

// Primera fila del menú en galletas, tal cual está en /menu: caramelo salado, roché, arma tu caja x3, klim y maracuyá
const firstRowProducts: Product[] = [
	PRODUCTS.find((p) => p.id === 'galleta-caramelo-salado'),
	PRODUCTS.find((p) => p.id === 'galleta-roche'),
	PRODUCTS.find((p) => p.id === 'combo-arma-tu-caja-x3'),
	PRODUCTS.find((p) => p.id === 'galleta-klim'),
	PRODUCTS.find((p) => p.id === 'galleta-maracuya'),
].filter((p): p is Product => Boolean(p));
---

<Layout>
	<Navbar />

	<main id="main-content" class="min-h-screen pb-20">
		<!-- Sección héroe del producto: diseño final de Figma (galletas) -->
		<section class="relative w-full" style={polkaBgStyle}>
			<div
				class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-6 py-14 sm:py-20 lg:grid-cols-[minmax(250px,300px)_1fr_88px] lg:gap-6 lg:py-24"
			>
				<!-- Columna izquierda: información del producto -->
				<div class="order-2 flex flex-col lg:order-1">
					<!-- Título con contorno blanco (duplicado posicionado detrás) -->
					<h1 class="relative z-0 inline-block self-start font-sans text-4xl font-extrabold leading-tight text-pink sm:text-5xl">
						<span
							aria-hidden="true"
							class="absolute inset-0 select-none text-white [-webkit-text-stroke:10px_white]"
						>
							{product.name}
						</span>
						<span class="relative">{product.name}</span>
					</h1>

					<!-- Precio con contorno blanco igual que el título -->
					<p class="relative z-0 inline-block self-start mt-3 font-sans text-3xl font-bold text-brown sm:text-4xl">
						<span
							aria-hidden="true"
							class="absolute inset-0 select-none text-white [-webkit-text-stroke:9px_white]"
						>
							{product.priceFormatted}
						</span>
						<span class="relative">{product.priceFormatted}</span>
					</p>

					<p class="mt-4 max-w-[300px] text-[13px] leading-7 text-brown/90 sm:text-sm sm:leading-[1.95]">{product.fullDescription}</p>

					<div class="mt-8 max-w-[300px]">
						<ProductDetailActions client:load product={product} />
					</div>
				</div>

				<!-- Columna central: producto sobre badge de estrella festoneada -->
				<div class="order-1 flex justify-center lg:order-2">
					<div class="relative w-[300px] sm:w-[400px] lg:w-[440px]">
						<svg
							viewBox="0 0 438.648 437.279"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							class="h-auto w-full drop-shadow-[0_18px_30px_rgba(58,32,14,0.18)]"
							role="presentation"
						>
							<path fill={theme.star} d="M202.121 15.5555C204.213 -5.18518 234.436 -5.18517 236.528 15.5555C238.296 33.0823 262.076 37.0505 269.439 21.0475C278.153 2.10993 306.738 11.9233 301.982 32.2195C297.964 49.3707 319.167 60.8454 331.327 48.1003C345.718 33.018 369.568 51.5812 358.48 69.2336C349.11 84.1506 365.438 101.888 381.078 93.7823C399.586 84.1897 416.116 109.491 399.897 122.587C386.191 133.653 395.876 155.732 413.3 153.143C433.92 150.08 441.339 179.378 421.747 186.498C405.19 192.514 407.181 216.541 424.502 219.75C444.999 223.548 442.504 253.668 421.661 254.04C404.048 254.355 398.13 277.726 413.47 286.386C431.623 296.633 419.483 324.31 399.649 317.895C382.888 312.473 369.701 332.657 381.399 345.828C395.241 361.415 374.772 383.65 358.096 371.142C344.003 360.573 324.978 375.381 331.765 391.637C339.796 410.873 313.216 425.258 301.504 408.013C291.608 393.44 268.805 401.268 269.946 418.847C271.296 439.649 241.485 444.624 236.008 424.51C231.379 407.513 207.27 407.513 202.641 424.51C197.163 444.624 167.353 439.649 168.703 418.847C169.844 401.268 147.041 393.44 137.144 408.013C125.433 425.258 98.8525 410.873 106.884 391.637C113.671 375.381 94.6452 360.573 80.5529 371.142C63.8765 383.65 43.4072 361.415 57.2496 345.828C68.947 332.657 55.7605 312.473 38.9997 317.895C19.1655 324.31 7.02517 296.633 25.1785 286.386C40.5189 277.726 34.6004 254.355 16.9875 254.04C-3.85512 253.668 -6.3509 223.548 14.1462 219.75C31.4671 216.541 33.458 192.514 16.9015 186.498C-2.69087 179.378 4.72837 150.08 25.348 153.143C42.7725 155.732 52.4571 133.653 38.7512 122.587C22.5322 109.491 39.0625 84.1897 57.5702 93.7823C73.2101 101.888 89.5388 84.1506 80.1688 69.2336C69.0807 51.5812 92.9307 33.018 107.321 48.1003C119.481 60.8454 140.685 49.3707 136.666 32.2195C131.91 11.9233 160.496 2.10994 169.209 21.0475C176.572 37.0505 200.353 33.0823 202.121 15.5555Z"></path>
						</svg>
						<img
							id="pd-main-image"
							src={gallery[0]}
							alt={product.name}
							class="absolute inset-0 m-auto h-[90%] w-[90%] object-contain drop-shadow-[0_12px_18px_rgba(58,32,14,0.25)] transition-transform duration-300"
							width="440"
							height="440"
						/>
					</div>
				</div>

				<!-- Columna derecha: galería de fotos del producto -->
				{
					gallery.length > 0 && (
						<div class="order-3 flex flex-row justify-center gap-4 lg:flex-col lg:gap-5">
							{gallery.map((src, i) => (
								<button
									type="button"
									data-gallery-thumb
									aria-label={`Ver foto ${i + 1} de ${product.name}`}
									class:list={[
										'h-20 w-16 shrink-0 overflow-hidden rounded-2xl bg-white/40 shadow-[0_4px_14px_rgba(58,32,14,0.12)] outline-offset-2 transition-all sm:h-24 sm:w-[76px] lg:h-[104px] lg:w-[84px]',
										i === 0 ? 'outline outline-white' : 'hover:scale-105',
									]}
								>
									<img src={src} alt="" class="h-full w-full object-cover" width="84" height="104" loading="lazy" />
								</button>
							))}
						</div>
					)
				}
			</div>
		</section>

		<!-- Carrusel de cinta en rosado: conectado sin espaciado con la sección del producto -->
		<CarruselScroll variant="pink" />

		<!-- Más sabores para ti: primera fila del menú en galletas (reutiliza MenuCard) -->
		<section class="bg-beige pt-8 sm:pt-10 pb-20">
			<div class="mx-auto w-full max-w-[1400px] px-4 sm:px-6">
				<h2 class="font-sans text-2xl font-extrabold text-brown sm:text-3xl">Más sabores para ti</h2>
				<div class="mt-5 sm:mt-6 grid grid-cols-2 gap-3.5 sm:grid-cols-4 sm:gap-5 lg:grid-cols-6">
					{
						firstRowProducts.map((rel: Product) => (
							<MenuCard client:visible product={rel} />
						))
					}
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	const mainImage = document.getElementById('pd-main-image') as HTMLImageElement | null;

	document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((thumb, index) => {
		thumb.addEventListener('click', () => {
			const img = thumb.querySelector('img');
			if (!img || !mainImage) return;

			mainImage.src = img.src;
			document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((t) => {
				t.classList.remove('outline', 'outline-white');
			});
			thumb.classList.add('outline', 'outline-white');
			void index;
		});
	});
</script>
