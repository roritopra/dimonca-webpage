<section class="relative h-[775px] w-full overflow-hidden bg-brown-400">
	<div
		class="absolute inset-0 bg-[repeating-linear-gradient(90deg,#89796e_0px_31px,transparent_31px_62.1px)]"
		aria-hidden="true"
	></div>

	<div class="absolute top-0 bottom-0 left-1/2 min-w-[1440px] -translate-x-1/2">
		<div class="pointer-events-none absolute top-[118px] left-[446px] h-[524px] w-[524px] mix-blend-overlay" aria-hidden="true">
			<img class="block h-full w-full" src="/images/ellipse-hero.svg" alt="" />
		</div>

		<p
			class="pointer-events-none absolute top-[33.68px] left-[157.8px] z-[1] font-script text-[203.79px] leading-none whitespace-nowrap text-pink-200"
			aria-hidden="true"
			>Galleta</p
		>
		<p
			class="pointer-events-none absolute top-[33.68px] left-[1252.2px] z-[1] w-[502.2px] -translate-x-full text-right font-script text-[203.79px] leading-none whitespace-nowrap text-pink-200"
			aria-hidden="true"
			>Habibi</p
		>

		<div id="hero-cookie" class="group absolute top-[115.95px] left-[446.12px] z-[2] h-[522.26px] w-[522.26px]">
			<img
				class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ease-in-out group-hover:opacity-0"
				src="/images/cream-hero.png"
				alt="Galleta Habibi"
			/>
			<img
				class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-in-out group-hover:opacity-100"
				src="/images/cookie-hero.png"
				alt="Galleta Habibi partida con crema de pistacho"
			/>
		</div>

		<div class="absolute top-[186.68px] left-[831px] z-[3]">
			<img class="block h-full w-full" src="/images/star-hero.svg" alt="" />
			<span
				class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-sans text-[27px] leading-[1.2] font-bold whitespace-nowrap text-center text-brown"
				>Nueva</span
			>
		</div>

		<div class="absolute top-[310.9px] left-[214px] z-[3] w-[243px]">
			<h2 class="mb-3 font-sans text-[38px] leading-[1.2] font-bold text-beige">Galleta Habibi</h2>
			<p class="font-sans text-[21.6px] leading-[1.2] text-beige">
				Galleta de chocolate tipo brownie, rellena con una exquisita crema de pistacho artesanal.
				Un postre al mejor estilo Dubai.
			</p>
		</div>

		<a
			class="absolute top-[658px] left-[595px] z-[3] flex h-[49px] w-[218.1px] items-center justify-center gap-2 whitespace-nowrap rounded-[57px] bg-pink px-4 py-2 font-sans text-[19px] leading-[1.2] font-bold text-beige no-underline hover:brightness-95"
			href="#menu"
		>
			Ver menú
			<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[22.68px] bg-beige p-[6.67px]">
				<img class="block h-[16.01px] w-[16.01px]" src="/images/chef-hat.svg" alt="" />
			</span>
		</a>

		<button
			class="absolute top-[332px] left-[95px] z-[4] flex h-[73px] w-[73px] cursor-pointer items-center justify-center rounded-[94.4px] border-[3.05px] border-beige bg-pink p-[15.23px] hover:brightness-95"
			type="button"
			aria-label="Anterior"
		>
			<img class="block h-[36.55px] w-[36.55px]" src="/images/chevron-left.svg" alt="" />
		</button>
		<button
			class="absolute top-[268.13px] left-[1219.13px] z-[4] flex h-[73px] w-[73px] cursor-pointer items-center justify-center rounded-[94.4px] border-[3.05px] border-beige bg-pink p-[15.23px] hover:brightness-95"
			type="button"
			aria-label="Siguiente"
		>
			<img class="block h-[36.55px] w-[36.55px] rotate-180" src="/images/chevron-left.svg" alt="" />
		</button>
	</div>
</section>

<script>
	import { animate, hover } from 'motion';

	const cookie = document.getElementById('hero-cookie');

	if (cookie) {
		hover(cookie, (element, isHovering) => {
			if (isHovering) {
				animate(cookie, { scale: 1.05 }, { duration: 0.35, ease: 'easeOut' });
			} else {
				animate(cookie, { scale: 1 }, { duration: 0.35, ease: 'easeInOut' });
			}
		});
	}
</script>
