---
import { Icon } from 'astro-icon/components';

const categories = [
	{ label: 'Galletas', img: '/images/cookie.png' },
	{ label: 'Cuchareables', img: '/images/cuchareable.png' },
	{ label: 'Brownies', img: '/images/brownie.png' },
	{ label: 'Pasteles', img: '/images/cake.png' },
	{ label: 'Más Productos', img: '/images/crookie.png' },
];
---

<header
	id="navbar"
	class="group relative z-10 w-full font-sans drop-shadow-[0px_11px_19.05px_rgba(58,32,14,0.14)]"
>
	<div
		class="flex flex-wrap items-center justify-center gap-x-[60px] gap-y-6 bg-beige px-20 py-4 max-[900px]:gap-x-8 max-[900px]:px-6"
	>
		<a
			class="flex flex-1 min-w-0 items-center justify-center whitespace-nowrap p-2.5 text-[15px] leading-[1.2] text-brown no-underline hover:opacity-75 max-[900px]:flex-none"
			href="#encuentranos"
			>Encuéntranos</a
		>
		<button
			id="menu-btn"
			class="relative flex h-[30px] flex-1 min-w-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap border-0 bg-transparent p-2.5 text-[15px] leading-[1.2] text-brown hover:opacity-75 max-[900px]:flex-none"
			type="button"
			aria-haspopup="true"
			aria-expanded="false"
			aria-controls="dropdown"
		>
			Menú
			<Icon
				name="lucide:chevron-down"
				class="h-6 w-6 shrink-0 transition-transform duration-200 group-data-[open]:rotate-180"
				aria-hidden="true"
			/>
		</button>
		<a class="shrink-0" href="/" aria-label="Dimonca, inicio">
			<img class="block h-[46px] w-[159px]" src="/images/logo.png" alt="Dimonca" />
		</a>
		<a
			class="flex flex-1 min-w-0 items-center justify-center whitespace-nowrap p-2.5 text-[15px] leading-[1.2] text-brown no-underline hover:opacity-75 max-[900px]:flex-none"
			href="#sobre-nosotros"
			>Sobre Nosotros</a
		>
		<a
			class="flex h-[46px] flex-1 min-w-0 items-center justify-center gap-2 whitespace-nowrap rounded-[57px] bg-pink px-4 py-2 text-[15px] font-bold leading-[1.2] text-beige no-underline hover:brightness-95 max-[900px]:flex-none"
			href="#pedido"
		>
			Haz tu pedido
			<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-[18.38px] bg-beige p-[5.4px]">
				<img class="block h-[12.98px] w-[12.98px]" src="/images/map.svg" alt="" />
			</span>
		</a>
	</div>
	<nav
		class="invisible absolute top-full left-0 z-50 flex w-full items-start justify-center gap-[93px] bg-beige py-[18px] opacity-0 -translate-y-2 pointer-events-none transition-[opacity,transform,visibility] duration-200 ease-in-out group-data-[open]:visible group-data-[open]:translate-y-0 group-data-[open]:pointer-events-auto group-data-[open]:opacity-100"
		id="dropdown"
		aria-label="Categorías del menú"
	>
		{
			categories.map((c) => (
				<a class="flex w-[121px] flex-col items-center justify-center gap-[9px] no-underline" href={`#${c.label.toLowerCase().replace(/\s+/g, '-')}`}>
					<img class="block h-[121px] w-[121px] object-cover object-center" src={c.img} alt={c.label} />
					<p class="m-0 text-center text-[15px] leading-[1.2] text-brown">{c.label}</p>
				</a>
			))
		}
	</nav>
</header>

<script>
	const navbar = document.getElementById('navbar');
	const menuBtn = document.getElementById('menu-btn');

	if (navbar && menuBtn) {
		const open = () => {
			navbar.dataset.open = 'true';
			menuBtn.setAttribute('aria-expanded', 'true');
		};
		const close = () => {
			delete navbar.dataset.open;
			menuBtn.setAttribute('aria-expanded', 'false');
		};

		menuBtn.addEventListener('mouseenter', open);
		navbar.addEventListener('mouseleave', close);
	}
</script>
