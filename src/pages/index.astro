---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/common/Navbar.astro";
import Hero from "../components/home/Hero.astro";
import CarruselScroll from "../components/common/CarruselScroll.astro";
import SobreNosotros from "../components/home/SobreNosotros.astro";
import OurProducts from "../components/home/OurProducts.astro";
import MoreThanCookies from "../components/home/MoreThanCookies.astro";
import Combos from "../components/home/Combos.astro";
import FindUs from "../components/home/FindUs.astro";
import Testimonials from "../components/home/Testimonials.astro";
import CallToAction from "../components/home/CallToAction.astro";
import Footer from "../components/common/Footer.astro";
---

<Layout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <SobreNosotros />
    <CarruselScroll />
    <OurProducts />
    <MoreThanCookies />
    <CarruselScroll variant="brown" />
    <Combos />
    <FindUs />
    <Testimonials />
    <CallToAction />
  </main>
  <Footer />
</Layout>

