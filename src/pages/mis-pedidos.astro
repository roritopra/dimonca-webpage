---
import Layout from '../layouts/Layout.astro';
import OrdersView from '../components/checkout/OrdersView';
---

<Layout>
	<main id="main-content" class="flex min-h-screen items-start justify-center bg-beige px-6 pt-24 pb-20">
		<div class="flex w-full max-w-lg flex-col items-center gap-8">
			<div class="text-center">
				<h1 class="font-sans text-3xl font-extrabold text-pink">Mis pedidos</h1>
				<p class="mt-2 font-sans text-sm text-brown/70">
					El historial de todos tus pedidos en Dimonca
				</p>
			</div>

			<OrdersView client:load />
		</div>
	</main>
</Layout>
