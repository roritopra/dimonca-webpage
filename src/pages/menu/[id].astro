---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import ProductDetailActions from '../../components/menu/ProductDetailActions';
import { PRODUCTS } from '../../data/products';

export function getStaticPaths() {
	// Solo productos normales / individuales
	const singleProducts = PRODUCTS.filter((p) => p.productType === 'single');

	return singleProducts.map((product) => ({
		params: { id: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;

if (!product || product.productType !== 'single') {
	return Astro.redirect('/menu');
}

const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id && p.productType === 'single').slice(0, 3);
---

<Layout>
	<Navbar />

	<main id="main-content" class="min-h-screen bg-beige pt-24 sm:pt-28 pb-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4">
			<nav class="flex items-center gap-2 text-xs sm:text-sm font-medium text-brown/60">
				<a href="/" class="hover:text-pink transition-colors">Inicio</a>
				<span>/</span>
				<a href="/menu" class="hover:text-pink transition-colors">Menú</a>
				<span>/</span>
				<span class="text-pink font-semibold">{product.categoryLabel}</span>
				<span>/</span>
				<span class="text-brown font-bold truncate max-w-[200px]">{product.name}</span>
			</nav>
		</div>

		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 mt-2">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 rounded-3xl bg-white p-6 sm:p-10 shadow-[0_4px_30px_rgba(58,32,14,0.06)] border border-brown/10">
				<div class="relative flex min-h-[340px] sm:min-h-[420px] items-center justify-center rounded-2xl bg-beige/60 p-8">
					{product.badge && (
						<span
							style={{ backgroundColor: product.badgeColor || '#f45d8c' }}
							class="absolute top-4 left-4 z-10 rounded-full px-3.5 py-1 text-xs font-bold text-white shadow-sm"
						>
							{product.badge}
						</span>
					)}
					<img
						src={product.imageSrc}
						alt={product.name}
						class="h-72 w-72 sm:h-96 sm:w-96 object-contain drop-shadow-xl transition-transform hover:scale-105 duration-300"
					/>
				</div>

				<div class="flex flex-col justify-center">
					<div class="flex items-center gap-2">
						<span class="rounded-full bg-pink/15 px-3 py-1 text-xs font-bold uppercase tracking-wider text-pink">
							{product.categoryLabel}
						</span>
						{product.rating && (
							<div class="flex items-center gap-1 text-xs font-semibold text-brown/80">
								<span class="text-amber-500">★</span>
								<span>{product.rating}</span>
							</div>
						)}
					</div>

					<h1 class="mt-3 font-sans text-2xl sm:text-4xl font-extrabold text-brown">
						{product.name}
					</h1>

					<p class="mt-2 text-2xl sm:text-3xl font-bold text-pink">
						{product.priceFormatted}
					</p>

					<p class="mt-4 text-sm sm:text-base text-brown/80 leading-relaxed">
						{product.fullDescription}
					</p>

					{product.ingredients && product.ingredients.length > 0 && (
						<div class="mt-6">
							<h2 class="text-xs font-bold uppercase tracking-wider text-brown/70">
								Ingredientes seleccionados:
							</h2>
							<div class="mt-2 flex flex-wrap gap-2">
								{product.ingredients.map((ing) => (
									<span class="rounded-lg bg-beige px-2.5 py-1 text-xs font-medium text-brown">
										{ing}
									</span>
								))}
							</div>
						</div>
					)}

					{product.allergens && product.allergens.length > 0 && (
						<div class="mt-4 text-xs text-brown/60">
							<strong>Alérgenos:</strong> {product.allergens.join(', ')}.
						</div>
					)}

					<div class="mt-6">
						<ProductDetailActions client:load product={product} />
					</div>
				</div>
			</div>

			{relatedProducts.length > 0 && (
				<section class="mt-16">
					<div class="text-center mb-8">
						<h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-brown">
							También te puede gustar
						</h2>
						<p class="font-script text-2xl text-pink">el maridaje perfecto</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
						{relatedProducts.map((rel) => (
							<a
								href={`/menu/${rel.id}`}
								class="group flex flex-col rounded-3xl bg-white p-5 shadow-[0_4px_20px_rgba(58,32,14,0.06)] border border-brown/10 transition-all hover:-translate-y-1 hover:shadow-lg"
							>
								<div class="flex h-44 items-center justify-center rounded-2xl bg-beige/50 p-4">
									<img
										src={rel.imageSrc}
										alt={rel.name}
										class="h-full object-contain transition-transform group-hover:scale-105"
									/>
								</div>
								<div class="mt-4">
									<span class="text-[11px] font-semibold uppercase tracking-wider text-pink">
										{rel.categoryLabel}
									</span>
									<h3 class="font-sans text-base font-bold text-brown group-hover:text-pink transition-colors">
										{rel.name}
									</h3>
									<span class="mt-1 block font-sans text-base font-bold text-brown">
										{rel.priceFormatted}
									</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}
		</div>
	</main>

	<Footer />
</Layout>