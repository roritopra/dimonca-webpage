---
import { Icon } from "astro-icon/components";

const stripes = Array.from({ length: 24 }, (_, i) => ({
  left: i * (62.1 / 1440) * 100,
  width: (31 / 1440) * 100,
  up: i % 2 === 0,
}));
---

<section class="relative h-[690px] w-full overflow-hidden bg-[#3A200E]">
  <!-- Rayas verticales en el fondo -->
  <div
    class="absolute inset-0 overflow-hidden pointer-events-none"
    aria-hidden="true"
  >
    {
      stripes.map((s) => (
        <div
          class="hero-stripe absolute top-0 bottom-0 bg-[#89796e]"
          style={`left: ${s.left}%; width: ${s.width}%;`}
        />
      ))
    }
  </div>

  <div
    class="relative mx-auto flex h-full max-w-[1440px] items-center justify-between px-10 md:px-20"
  >
    <!-- Lado izquierdo: Imagen combos-caja -->
    <div class="relative z-10 flex flex-1 items-center justify-center">
      <img
        src="/images/combos-caja.png"
        alt="Combos de galletas en caja"
        class="h-auto max-h-[580px] w-auto max-w-full object-contain"
      />
    </div>

    <!-- Lado derecho: Información -->
    <div
      class="relative z-10 flex w-full max-w-[440px] flex-col items-start gap-20"
    >
      <div class="relative w-full pb-8">
        <h2
          style="paint-order: stroke;"
          class="m-0 font-sans text-[54px] font-bold leading-none text-beige [-webkit-text-stroke:10px_#3A200E] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
        >
          Lleva tus
        </h2>
        <span
          style="paint-order: stroke;"
          class="absolute top-[50px] left-[130px] font-exmouth text-[100px] leading-none text-blue-500 whitespace-nowrap [-webkit-text-stroke:10px_#3A200E] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
          aria-hidden="true"
        >
          Combos
        </span>
      </div>
      <p
        style="paint-order: stroke;"
        class="m-0 text-[18px] leading-relaxed text-beige [-webkit-text-stroke:5px_#3A200E]
	  [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
      >
        Reúne tus productos favoritos del menú en nuestros combos de 3 o 9
        unidades. Mezcla sabores, descubre nuevas opciones y crea la combinación
        ideal para cualquier ocasión.
      </p>
      <a
        class="flex h-[52px] items-center justify-center gap-3 whitespace-nowrap rounded-[57px] bg-blue-600 px-6 py-2 font-sans text-[18px] font-bold text-beige no-underline shadow-md transition-all hover:brightness-95"
        href="#pedido"
      >
        Haz tu pedido
        <span
          class="flex h-[32px] w-[32px] shrink-0 items-center justify-center rounded-full bg-beige"
        >
          <Icon
            name="lucide:map"
            class="h-[16px] w-[16px] text-blue-600"
            aria-hidden="true"
          />
        </span>
      </a>
    </div>
  </div>
</section>
