---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import CarruselScroll from '../../components/common/CarruselScroll.astro';
import ProductDetailActions from '../../components/menu/ProductDetailActions';
import MenuCard from '../../components/menu/MenuCard';
import { Icon } from 'astro-icon/components';
import { PRODUCTS } from '../../data/products';
import type { Product, ProductCategory } from '../../types/products';

export function getStaticPaths() {
	// Solo productos normales / individuales
	const singleProducts = PRODUCTS.filter((p) => p.productType === 'single');

	return singleProducts.map((product) => ({
		params: { id: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;

if (!product || product.productType !== 'single') {
	return Astro.redirect('/menu');
}

// Tema visual por categoría: el diseño dependende del tipo de producto.
// Desktop (>=1024px): fondo rosado con puntitos + estrella azul (diseño final de Figma).
// Mobile/Tablet (<1024px): fondo azul con puntitos + estrella rosa (diseño final mobile).
interface DetailTheme {
	bg: string;
	dot: string;
	star: string;
	mobileBg: string;
	mobileDot: string;
	mobileStar: string;
}
const baseTheme: DetailTheme = {
	bg: '#f8a9c6',
	dot: '#aed6f6',
	star: '#9accf4',
	mobileBg: '#9cc8ef',
	mobileDot: 'rgba(255,255,255,0.4)',
	mobileStar: '#f45d8c',
};
const DETAIL_THEMES: Record<ProductCategory, DetailTheme> = {
	galletas: baseTheme,
	brownies: baseTheme,
	tortas: baseTheme,
	otros: baseTheme,
	// TODO: diseño propio para cuchareables (incluye condicional de toppings)
	cuchareables: { ...baseTheme, mobileBg: '#a5d2f6' },
};
const theme = DETAIL_THEMES[product.category] ?? DETAIL_THEMES.otros;

// Galería: la primera es el PNG del producto (principal), el resto son foto terciarias (máx. 3)
const gallery = [product.imageSrc, ...(product.gallery ?? [])];

const polkaBgVars = `--pd-bg-mobile:${theme.mobileBg};--pd-dot-mobile:${theme.mobileDot};--pd-bg-desktop:${theme.bg};--pd-dot-desktop:${theme.dot};--pd-star-mobile:${theme.mobileStar};--pd-star-desktop:${theme.star};`;

// Primera fila del menú en galletas, tal cual está en /menu: caramelo salado, roché, arma tu caja x3, klim y maracuyá
const firstRowProducts: Product[] = [
	PRODUCTS.find((p) => p.id === 'galleta-caramelo-salado'),
	PRODUCTS.find((p) => p.id === 'galleta-roche'),
	PRODUCTS.find((p) => p.id === 'combo-arma-tu-caja-x3'),
	PRODUCTS.find((p) => p.id === 'galleta-klim'),
	PRODUCTS.find((p) => p.id === 'galleta-maracuya'),
].filter((p): p is Product => Boolean(p));
---

<Layout>
	<Navbar />

	<main id="main-content" class="min-h-screen">
		<!-- Sección héroe del producto: azul con puntitos en mobile/tablet, rosado en desktop -->
		<section
			id="pd-hero"
			class="pd-hero relative w-full"
			style={polkaBgVars}
		>
			<div class="mx-auto w-full max-w-6xl px-6 pb-10 pt-6 lg:py-24">
				<!-- Barra superior mobile/tablet: volver y compartir -->
				<div class="mb-8 flex items-center justify-between lg:hidden">
					<a
						href="/menu"
						class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-pink shadow-md transition-transform active:scale-95"
						aria-label="Volver al menú"
					>
						<Icon name="lucide:arrow-left" class="h-5 w-5" aria-hidden="true" />
					</a>
					<button
						type="button"
						data-product-share
						data-title={product.name}
						class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-pink shadow-md transition-transform active:scale-95"
						aria-label="Compartir producto"
					>
						<Icon name="lucide:share-2" class="h-5 w-5" aria-hidden="true" />
					</button>
				</div>

				<div
					class="flex flex-col items-stretch gap-10 lg:grid lg:grid-cols-[minmax(250px,300px)_1fr_88px] lg:items-center lg:gap-6 lg:pb-0 pt-2 lg:pt-0"
				>
					<!-- Columna izquierda: información del producto (mobile: bloque beige de ancho completo) -->
					<div class="order-4 -mx-6 flex flex-col bg-beige px-6 pb-9 pt-10 sm:pt-12 lg:order-1 lg:m-0 lg:bg-transparent lg:p-0 lg:pb-0">
						<!-- Título con contorno blanco (duplicado posicionado detrás) -->
						<h1 class="relative z-0 inline-block self-start font-sans text-4xl font-extrabold leading-tight text-pink sm:text-5xl">
							<span
								aria-hidden="true"
								class="absolute inset-0 select-none text-white [-webkit-text-stroke:10px_white]"
							>
								{product.name}
							</span>
							<span class="relative">{product.name}</span>
						</h1>

						<!-- Precio con contorno blanco igual que el título -->
						<p class="relative z-0 inline-block self-start mt-3 font-sans text-3xl font-bold text-brown sm:text-4xl">
							<span
								aria-hidden="true"
								class="absolute inset-0 select-none text-white [-webkit-text-stroke:9px_white]"
							>
								{product.priceFormatted}
							</span>
							<span class="relative">{product.priceFormatted}</span>
						</p>

						<p class="mt-4 max-w-[300px] text-[13px] leading-7 text-brown/90 sm:text-sm sm:leading-[1.95]">{product.fullDescription}</p>

						<div class="mt-8 max-w-[300px]">
							<ProductDetailActions client:load product={product} />
						</div>
					</div>

					<!-- Columna central: producto sobre badge de estrella festoneada -->
					<div class="order-1 flex justify-center lg:order-2">
						<div class="relative w-[min(300px,80vw)] sm:w-[400px] lg:w-[440px]">
						<!-- Iluminador: elipse blanca 20% más grande que la estrella, con layer blur y 55% transparencia -->
						<div
							aria-hidden="true"
							class="absolute -inset-[10%] rounded-full bg-white/55 blur-3xl"
						>
						</div>
						<svg
							id="pd-star-shape"
							viewBox="0 0 438.648 437.279"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							class="pd-layer pd-principal-layer h-auto w-full drop-shadow-[0_18px_30px_rgba(58,32,14,0.18)]"
							role="presentation"
						>
							<path class="pd-star-path" fill={theme.star} d="M202.121 15.5555C204.213 -5.18518 234.436 -5.18517 236.528 15.5555C238.296 33.0823 262.076 37.0505 269.439 21.0475C278.153 2.10993 306.738 11.9233 301.982 32.2195C297.964 49.3707 319.167 60.8454 331.327 48.1003C345.718 33.018 369.568 51.5812 358.48 69.2336C349.11 84.1506 365.438 101.888 381.078 93.7823C399.586 84.1897 416.116 109.491 399.897 122.587C386.191 133.653 395.876 155.732 413.3 153.143C433.92 150.08 441.339 179.378 421.747 186.498C405.19 192.514 407.181 216.541 424.502 219.75C444.999 223.548 442.504 253.668 421.661 254.04C404.048 254.355 398.13 277.726 413.47 286.386C431.623 296.633 419.483 324.31 399.649 317.895C382.888 312.473 369.701 332.657 381.399 345.828C395.241 361.415 374.772 383.65 358.096 371.142C344.003 360.573 324.978 375.381 331.765 391.637C339.796 410.873 313.216 425.258 301.504 408.013C291.608 393.44 268.805 401.268 269.946 418.847C271.296 439.649 241.485 444.624 236.008 424.51C231.379 407.513 207.27 407.513 202.641 424.51C197.163 444.624 167.353 439.649 168.703 418.847C169.844 401.268 147.041 393.44 137.144 408.013C125.433 425.258 98.8525 410.873 106.884 391.637C113.671 375.381 94.6452 360.573 80.5529 371.142C63.8765 383.65 43.4072 361.415 57.2496 345.828C68.947 332.657 55.7605 312.473 38.9997 317.895C19.1655 324.31 7.02517 296.633 25.1785 286.386C40.5189 277.726 34.6004 254.355 16.9875 254.04C-3.85512 253.668 -6.3509 223.548 14.1462 219.75C31.4671 216.541 33.458 192.514 16.9015 186.498C-2.69087 179.378 4.72837 150.08 25.348 153.143C42.7725 155.732 52.4571 133.653 38.7512 122.587C22.5322 109.491 39.0625 84.1897 57.5702 93.7823C73.2101 101.888 89.5388 84.1506 80.1688 69.2336C69.0807 51.5812 92.9307 33.018 107.321 48.1003C119.481 60.8454 140.685 49.3707 136.666 32.2195C131.91 11.9233 160.496 2.10994 169.209 21.0475C176.572 37.0505 200.353 33.0823 202.121 15.5555Z"></path>
						</svg>
						<!-- Foto terciaria: la estrella se convierte en la imagen usando la estrella como máscara CSS. -->
						<!-- Ambas capas SIEMPRE renderizadas (patrón de BoxBuilder: crossfade con opacity, nunca display:none) -->
						<img
							id="pd-star-photo"
							alt={product.name}
							src={gallery[1] ?? ''}
							class="pd-layer pd-photo-layer pd-layer-hidden pd-star-mask absolute inset-0 h-full w-full object-cover"
						/>
						<img
							id="pd-main-image"
							src={gallery[0]}
							alt={product.name}
							class="pd-layer pd-principal-layer absolute inset-0 m-auto h-[90%] w-[90%] object-contain drop-shadow-[0_12px_18px_rgba(58,32,14,0.25)] transition-transform duration-300"
							width="440"
							height="440"
						/>
					</div>
				</div>

				<!-- Columna derecha: galería de fotos del producto -->
					{
						gallery.length > 0 && (
							<div class="order-2 flex flex-row justify-center gap-4 lg:order-3 lg:flex-col lg:gap-5">
							{gallery.map((src, i) => (
								<button
									type="button"
									data-gallery-thumb
									aria-label={`Ver foto ${i + 1} de ${product.name}`}
									class:list={[
										'h-20 w-16 shrink-0 overflow-hidden rounded-2xl bg-white/40 shadow-[0_4px_14px_rgba(58,32,14,0.12)] outline-offset-2 transition-all sm:h-24 sm:w-[76px] lg:h-[104px] lg:w-[84px]',
										i === 0 ? 'outline outline-white' : 'hover:scale-105',
									]}
								>
									<img src={src} alt="" class="h-full w-full object-cover" width="84" height="104" loading="lazy" />
								</button>
							))}
						</div>
					)
				}
				</div>
			</div>
		</section>

		<!-- Carrusel de cinta en rosado: conectado sin espaciado con la sección del producto -->
		<CarruselScroll variant="pink" />

		<!-- Más sabores para ti: primera fila del menú en galletas (reutiliza MenuCard) -->
		<section class="bg-beige pt-8 sm:pt-10 pb-20">
			<div class="mx-auto w-full max-w-[1400px] px-4 sm:px-6">
				<h2 class="font-sans text-2xl font-extrabold text-brown sm:text-3xl">Más sabores para ti</h2>
				<div class="mt-5 sm:mt-6 grid grid-cols-2 gap-3.5 sm:grid-cols-4 sm:gap-5 lg:grid-cols-6">
					{
						firstRowProducts.map((rel: Product) => (
							<MenuCard client:visible product={rel} />
						))
					}
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	// Con <ClientRouter>, los scripts empaquetados solo se ejecutan una vez y el DOM se
	// reemplaza en cada transición. Se usa delegación de eventos sobre document para que
	// la lógica sobreviva a la navegación (patrón de la doc de Astro: solo eventos de DOM
	// que no se re-vinculan).
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		// Compartir producto (barra mobile): nativo si está disponible, copiar link como fallback
		const shareBtn = event.target.closest<HTMLButtonElement>('[data-product-share]');
		if (shareBtn) {
			const url = window.location.href;
			const title = shareBtn.dataset.title;
			if (navigator.share) {
				navigator.share({ title, url }).catch(() => {});
			} else {
				navigator.clipboard?.writeText(url).catch(() => {});
			}
			return;
		}

		const thumb = event.target.closest<HTMLButtonElement>('[data-gallery-thumb]');
		if (!thumb) return;

		// Solo actúa en páginas que tienen la galería del detalle
		const mainImage = document.getElementById('pd-main-image');
		if (!mainImage) return;

		const img = thumb.querySelector('img');
		if (!img) return;

		const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
		thumbs.forEach((t) => {
			t.classList.toggle('outline', t === thumb);
			t.classList.toggle('outline-white', t === thumb);
		});

		const principalLayers = [...document.querySelectorAll<HTMLElement>('.pd-principal-layer')];
		const photoLayer = document.querySelector<HTMLElement>('.pd-photo-layer');

		if (thumbs.indexOf(thumb) === 0) {
			// Imagen principal: PNG del producto sobre la estrella festoneada
			principalLayers.forEach((el) => el.classList.remove('pd-layer-hidden'));
			photoLayer?.classList.add('pd-layer-hidden');
		} else {
			// Foto terciaria: la imagen llena toda la forma de la estrella vía máscara CSS
			principalLayers.forEach((el) => el.classList.add('pd-layer-hidden'));
			if (photoLayer) {
				photoLayer.src = img.src;
				photoLayer.classList.remove('pd-layer-hidden');
			}
		}
	});
</script>

<style is:global>
	pd-star-mask,
  .pd-star-mask {
    -webkit-mask-image: url('data:image/svg+xml;base64,');
    mask-image: url('data:image/svg+xml;base64,');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .pd-layer {
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
  }

  .pd-layer-hidden {
    opacity: 0 !important;
    transform: scale(0.98);
    pointer-events: none;
  }
</style>

<style is:global>
  /* Fondo de puntitos del hero: azul en mobile/tablet, rosado en desktop */
  .pd-hero {
    background-color: var(--pd-bg-mobile, #9cc8ef);
    background-image: radial-gradient(var(--pd-dot-mobile, rgba(255,255,255,0.4)) 7%, transparent 8%),
      radial-gradient(var(--pd-dot-mobile, rgba(255,255,255,0.4)) 7%, transparent 8%);
    background-position: 0 0, 17px 17px;
    background-size: 34px 34px;
  }

  @media (min-width: 1024px) {
    .pd-hero {
      background-color: var(--pd-bg-desktop, #f8a9c6);
      background-image: radial-gradient(var(--pd-dot-desktop, #aed6f6) 7%, transparent 8%),
        radial-gradient(var(--pd-dot-desktop, #aed6f6) 7%, transparent 8%);
    }
  }

  /* Color de la estrella festoneada: rosa en mobile, azul en desktop (CSS gana sobre el fill del path) */
  .pd-star-path {
    fill: var(--pd-star-mobile, #f45d8c);
  }

  @media (min-width: 1024px) {
    .pd-star-path {
      fill: var(--pd-star-desktop, #9accf4);
    }
  }
</style>