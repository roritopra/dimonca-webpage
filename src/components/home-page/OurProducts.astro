<section class="relative h-[606px] w-full overflow-hidden bg-blue-500">
  <div class="absolute inset-0 left-1/2 w-[1440px] max-w-full -translate-x-1/2">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-35"
      style={{
        width: "2000px",
        height: "2000px",
        backgroundImage:
          "radial-gradient(circle, #f7f2e8 2.8px, transparent 3px)",
        backgroundSize: "20px 20px",
        backgroundPosition: "8px 8px",
      }}
      aria-hidden="true"
    >
    </div>

    <div class="absolute inset-x-0 top-[51px] text-center">
      <p
        style="paint-order: stroke;"
        class="m-0 font-sans text-[38px] leading-[1.2] text-brown [-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
      >
        Conoce Nuestras
      </p>
    </div>
    <div class="absolute inset-x-0 top-[81px] text-center">
      <p
        style="paint-order: stroke;"
        class="m-0 font-exmouth text-[154.71px] leading-[1.2] text-brown [-webkit-text-stroke:15px_#F7F2E8] [filter:drop-shadow(0px_4px_4px_rgba(58,32,14,0.5))]"
      >
        Galletas
      </p>
    </div>
  </div>
</section>
