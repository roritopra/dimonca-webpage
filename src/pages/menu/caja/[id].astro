---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/common/Navbar.astro';
import Footer from '../../../components/common/Footer.astro';
import CarruselScroll from '../../../components/common/CarruselScroll.astro';
import BoxBuilder from '../../../components/menu/BoxBuilder';
import { PRODUCTS, getAvailableCookies } from '../../../data/products';
import type { Product } from '../../../types/products';

export function getStaticPaths() {
	const boxProducts = PRODUCTS.filter((p) => p.productType === 'custom_box');
	const availableCookies = PRODUCTS.filter((p) => p.productType === 'single' && p.category === 'galletas');

	return boxProducts.map((product) => ({
		params: { id: product.id },
		props: {
			product,
			availableCookies,
		},
	}));
}

interface Props {
	product: Product;
	availableCookies: Product[];
}

const { product, availableCookies } = Astro.props;

if (!product || product.productType !== 'custom_box') {
	return Astro.redirect('/menu');
}
---

<Layout>
	<Navbar />

	<main id="main-content" class="min-h-screen bg-beige pb-0">
		{/* Experiencia de Armado de Caja (Mitad Izquierda: Caja con fondo punteado | Mitad Derecha: Galletas y Footer) */}
		<BoxBuilder client:load boxProduct={product} availableCookies={availableCookies} />

		{/* Carrusel de cinta con movimiento infinito */}
		<CarruselScroll />
	</main>

	<Footer />
</Layout>