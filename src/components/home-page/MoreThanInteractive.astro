---
import { Icon } from "astro-icon/components";

const products = [
  {
    name: "Cuchareable de Red Velvet",
    normalImg: "/images/cuchareable-more-than.png",
    hoverImg: "/images/cuchareable-more-than-hover.png",
    alt: "Cuchareable de Red Velvet",
  },
];
---

<div
  id="more-than-interactive"
  class="relative flex w-[380px] max-w-full flex-col items-center justify-center select-none cursor-pointer"
  data-current="0"
>
  <!-- Contenedor del producto -->
  <div class="product-container relative flex h-[420px] w-full items-center justify-center">
    {products.map((item, idx) => (
      <div
        class={`product-slide absolute inset-0 flex items-center justify-center transition-opacity duration-300 ${
          idx === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"
        }`}
        data-index={idx}
      >
        <!-- Imagen Normal -->
        <img
          src={item.normalImg}
          alt={item.alt}
          class="product-img-normal block h-full w-auto object-contain drop-shadow-[0px_14px_24px_rgba(58,32,14,0.18)] transition-all duration-300"
        />
        <!-- Imagen Hover -->
        <img
          src={item.hoverImg}
          alt={`${item.alt} abierto`}
          class="product-img-hover absolute inset-0 m-auto block h-full w-auto object-contain opacity-0 drop-shadow-[0px_14px_24px_rgba(58,32,14,0.18)] transition-all duration-300"
        />

        <!-- Texto flotante en estilo script -->
        <div class="pointer-events-none absolute top-[70px] right-[-10px] z-10 max-w-[190px]">
          <p
            class="font-exmouth text-[44px] leading-[1.05] text-brown [-webkit-text-stroke:2px_#ffffff]"
            style="paint-order: stroke fill;"
          >
            {item.name}
          </p>
        </div>
      </div>
    ))}

    <!-- Botón flotante inferior izquierdo con corazón -->
    <button
      id="more-than-next-btn"
      type="button"
      class="group absolute bottom-[35px] left-[15px] z-20 flex h-[58px] w-[58px] items-center justify-center rounded-full border-[3px] border-white bg-[#6ca7d5] text-white shadow-[0px_8px_16px_rgba(108,167,213,0.4)] transition-all duration-300 hover:scale-105 hover:bg-[#5b96c4]"
      aria-label="Siguiente postre"
    >
      <Icon name="lucide:heart" class="h-7 w-7 transition-transform duration-300 group-hover:scale-110" />
    </button>
  </div>
</div>

<script>
  import { animate } from "motion";

  const root = document.getElementById("more-than-interactive");
  if (root) {
    const slides = root.querySelectorAll<HTMLElement>(".product-slide");
    const nextBtn = document.getElementById("more-than-next-btn");
    let currentIndex = 0;

    // Hover effect para mostrar la variante abierta/hover
    slides.forEach((slide) => {
      const normal = slide.querySelector<HTMLElement>(".product-img-normal");
      const hover = slide.querySelector<HTMLElement>(".product-img-hover");

      if (normal && hover) {
        slide.addEventListener("mouseenter", () => {
          animate(normal, { opacity: 0, scale: 0.98 }, { duration: 0.25, ease: "easeOut" });
          animate(hover, { opacity: 1, scale: 1.02 }, { duration: 0.25, ease: "easeOut" });
        });

        slide.addEventListener("mouseleave", () => {
          animate(normal, { opacity: 1, scale: 1 }, { duration: 0.25, ease: "easeInOut" });
          animate(hover, { opacity: 0, scale: 0.98 }, { duration: 0.25, ease: "easeInOut" });
        });
      }
    });

    // Función para cambiar de producto en click
    const nextProduct = () => {
      if (slides.length <= 1) return;
      const prevIndex = currentIndex;
      currentIndex = (currentIndex + 1) % slides.length;

      const prevSlide = slides[prevIndex];
      const nextSlide = slides[currentIndex];

      if (prevSlide && nextSlide) {
        animate(prevSlide, { opacity: 0, scale: 0.9 }, { duration: 0.3, ease: "easeIn" }).then(() => {
          prevSlide.style.pointerEvents = "none";
        });

        nextSlide.style.pointerEvents = "auto";
        animate(nextSlide, { opacity: [0, 1], scale: [1.1, 1] }, { duration: 0.35, ease: "easeOut" });
      }
    };

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      nextProduct();
    });

    root.addEventListener("click", nextProduct);
  }
</script>

