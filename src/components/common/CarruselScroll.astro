---
interface Props {
  variant?: 'blue' | 'brown';
}

const { variant = 'blue' } = Astro.props;

const items = [
  { year: "2021" },
  { year: "2021" },
  { year: "2021" },
  { year: "2021" },
  { year: "2021" },
  { year: "2021" },
];

const repeats = 4;

const isBrown = variant === 'brown';
const borderClass = isBrown ? 'border-brown' : 'border-blue-500';
const textClass = isBrown ? 'text-brown' : 'text-blue-500';
const icon = isBrown ? '/images/est-icon-brown.png' : '/images/est-icon.png';
---

<section
  class={`relative z-10 w-full overflow-hidden border-y-2 bg-beige ${borderClass}`}
>
  <div class="scroll-carousel w-full py-[10px] sm:py-[14px]">
    <div
      class="scroll-carousel-track flex w-max items-center will-change-transform"
      data-repeats={repeats}
    >
      {Array.from({ length: repeats }).map(() =>
        items.map((item) => (
          <div class="flex shrink-0 items-center gap-[12px] sm:gap-[18px] lg:gap-[22px] pr-[44px] sm:pr-[68px] lg:pr-[92px]">
            <p class={`m-0 font-sans text-[13px] sm:text-[16px] lg:text-[19px] leading-[1.2] ${textClass}`}>EST</p>
            <img
              class="block h-5 w-5 sm:h-6 sm:w-6 lg:h-8 lg:w-[30px] object-cover"
              src={icon}
              alt=""
              aria-hidden="true"
            />
            <p class={`m-0 text-right font-sans text-[13px] sm:text-[16px] lg:text-[19px] leading-[1.2] ${textClass}`}>
              {item.year}
            </p>
          </div>
        ))
      )}
    </div>
  </div>
</section>

<script>
  function initCarruselScroll() {
    const tracks = document.querySelectorAll<HTMLElement>(".scroll-carousel-track");

    tracks.forEach((track) => {
      const repeats = parseInt(track.dataset.repeats ?? "4", 10);
      const oneSetWidth = track.scrollWidth / repeats;

      const speed = 0.6;
      const autoSpeed = 0.35;
      let target = 0;
      let current = 0;
      let lastY = window.scrollY;
      let direction = -1;
      let lastScrollAt = Date.now();
      let rafId: number | null = null;

      const wrap = () => {
        if (current <= -oneSetWidth) {
          current += oneSetWidth;
          target += oneSetWidth;
        } else if (current >= 0) {
          current -= oneSetWidth;
          target -= oneSetWidth;
        }
      };

      const tick = () => {
        const idle = Date.now() - lastScrollAt > 150;
        if (idle) {
          target += direction * autoSpeed;
        }
        current += (target - current) * 0.08;
        wrap();
        track.style.transform = `translate3d(${current}px, 0, 0)`;
        rafId = requestAnimationFrame(tick);
      };

      const onScroll = () => {
        const delta = window.scrollY - lastY;
        lastY = window.scrollY;
        if (Math.abs(delta) > 0.1) {
          direction = delta > 0 ? -1 : 1;
          lastScrollAt = Date.now();
        }
        target -= delta * speed;
        if (rafId === null) {
          rafId = requestAnimationFrame(tick);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      rafId = requestAnimationFrame(tick);
    });
  }

  document.addEventListener("astro:page-load", initCarruselScroll);
</script>