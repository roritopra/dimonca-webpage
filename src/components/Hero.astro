---
const gridLine = {
	left: ['0', '62.1', '124.2', '186.3', '248.4', '310.5', '372.6', '434.7', '496.8', '553', '615.1', '677.2', '739.3', '801.4', '863.5', '925.6', '987.7', '1049.8', '1111', '1173.1', '1235.2', '1297.3', '1359.4', '1421.5', '1483.6', '1536.7', '1598.8'],
};
---

<section class="hero">
	<div class="hero-inner">
		<div class="grid-lines" style={`left:${gridLine.left[0]}px`} aria-hidden="true"></div>

		<div class="ellipse" aria-hidden="true">
			<img src="/images/ellipse-hero.svg" alt="" />
		</div>

		<p class="script script-left" aria-hidden="true">Galleta</p>
		<p class="script script-right" aria-hidden="true">Habibi</p>

		<div class="cookie">
			<img class="cookie-main" src="/images/cookie-hero.png" alt="Galleta Habibi partida con crema de pistacho" />
			<div class="cream cream-right">
				<img src="/images/cream-hero.png" alt="" />
			</div>
			<div class="cream cream-left">
				<img src="/images/cream-hero.png" alt="" />
			</div>
		</div>

		<div class="badge">
			<img class="badge-star" src="/images/star-hero.svg" alt="" />
			<span class="badge-label">Nueva</span>
		</div>

		<div class="hero-copy">
			<h2 class="hero-title">Galleta Habibi</h2>
			<p class="hero-desc">
				Galleta de chocolate tipo brownie, rellena con una exquisita crema de pistacho artesanal.
				Un postre al mejor estilo Dubai.
			</p>
		</div>

		<a class="cta" href="#menu">
			Ver menú
			<span class="cta-icon"><img src="/images/chef-hat.svg" alt="" /></span>
		</a>

		<button class="arrow arrow-prev" type="button" aria-label="Anterior">
			<img src="/images/chevron-left.svg" alt="" />
		</button>
		<button class="arrow arrow-next" type="button" aria-label="Siguiente">
			<img src="/images/chevron-left.svg" alt="" />
		</button>
	</div>
</section>

<style>
