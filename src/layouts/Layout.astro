---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Intro from '../components/home/Intro.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Dimonca Repostería - Deliciosas galletas artesanales, cuchareables, brownies y pasteles preparados con amor y los mejores ingredientes."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&family=Sacramento&display=swap"
			rel="stylesheet"
		/>
		<title>Dimonca | Repostería y Galletas Artesanales</title>
		<ClientRouter />
	</head>
	<body>
		<Intro />
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-pink focus:px-6 focus:py-3 focus:font-sans focus:font-bold focus:text-beige focus:shadow-lg focus:outline-none focus:ring-4 focus:ring-beige"
		>
			Saltar al contenido principal
		</a>
		<slot />
		<script>
			import Lenis from 'lenis';

			let lenisInstance: Lenis | null = null;
			let rafId: number | null = null;

			function initSmoothScroll() {
				if (lenisInstance) {
					lenisInstance.destroy();
				}
				if (rafId) {
					cancelAnimationFrame(rafId);
				}

				lenisInstance = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					smoothWheel: true,
					touchMultiplier: 1.5,
				});

				function raf(time: number) {
					lenisInstance?.raf(time);
					rafId = requestAnimationFrame(raf);
				}

				rafId = requestAnimationFrame(raf);
			}

			document.addEventListener('astro:page-load', initSmoothScroll);
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
