---
import { Icon } from 'astro-icon/components';

interface Props {
  img?: string;
  imgCracked?: string;
  scriptTop?: string;
  scriptBottom?: string;
  title?: string;
  price?: string;
  description?: string;
  color?: string;
}

const {
  img = '/images/cookie-card.png',
  imgCracked = '/images/cookie-card-animate.png',
  scriptTop = 'Pistacho',
  scriptBottom = 'Queen',
  title = 'Pistacho Queen',
  price = '$ 13.000',
  description = 'Galleta premium de pistacho con trozos reales de pistacho y chips ...',
  color = '#6ca7d5',
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
---

<article
  class="cookie-card relative flex w-[305px] flex-col items-start gap-[13px] overflow-clip rounded-[24px] border-2 bg-beige"
  style={`border-color: ${color};`}
  data-uid={uid}
  data-color={color}
>
  <div class="relative h-[319px] w-full shrink-0 overflow-clip rounded-[20px]">
    <p
      class="absolute top-[-27px] left-[-40px] font-exmouth text-[120.34px] leading-[1.05] whitespace-nowrap"
      style={`color: ${color};`}
      aria-hidden="true"
    >
      {scriptTop}
    </p>
    <p
      class="absolute top-[206px] left-[86px] font-exmouth text-[120.34px] leading-[1.05] whitespace-nowrap"
      style={`color: ${color};`}
      aria-hidden="true"
    >
      {scriptBottom}
    </p>

    <!-- Contenedor de la galleta (gira y escala) -->
    <div class="cookie-img-wrap absolute top-[31px] left-[25px] h-[257.29px] w-[280.35px]">
      <!-- Mitad izquierda -->
      <div class="cookie-half-left absolute inset-y-0 left-0 w-1/2 overflow-hidden">
        <img
          class="absolute top-0 left-0 h-full w-[280.35px] max-w-none object-cover drop-shadow-[0px_8.45px_19.16px_rgba(58,32,14,0.31)]"
          src={img}
          alt=""
        />
      </div>
      <!-- Mitad derecha -->
      <div class="cookie-half-right absolute inset-y-0 right-0 w-1/2 overflow-hidden">
        <img
          class="absolute top-0 right-0 h-full w-[280.35px] max-w-none object-cover drop-shadow-[0px_8.45px_19.16px_rgba(58,32,14,0.31)]"
          src={img}
          alt=""
        />
      </div>
      <!-- Imagen partida (oculta por defecto) -->
      <img
        class="cookie-cracked pointer-events-none absolute inset-0 h-full w-full object-cover drop-shadow-[0px_8.45px_19.16px_rgba(58,32,14,0.31)]"
        style="opacity: 0;"
        src={imgCracked}
        alt=""
      />
    </div>
  </div>

  <div class="cookie-info flex w-full shrink-0 flex-1 flex-col items-start gap-2 px-3 py-[14px]">
    <p class="cookie-title m-0 w-full font-sans text-[24px] leading-[1.2] font-bold text-brown">{title}</p>
    <p class="cookie-price m-0 w-full font-sans text-[24px] leading-[1.2] font-bold" style={`color: ${color};`}>
      {price}
    </p>
    <p class="cookie-desc m-0 w-full font-sans text-[15px] leading-[1.2] text-brown">{description}</p>
    <div class="mt-auto flex w-full items-start">
      <a
        class="cookie-btn flex h-[40.13px] flex-1 items-center justify-center gap-2 rounded-[57px] px-4 py-2 font-sans text-[15px] leading-[1.2] font-bold text-beige no-underline"
        style={`background-color: ${color};`}
        href="#"
      >
        Ver más
        <span class="cookie-btn-icon flex h-[24px] w-[24px] shrink-0 items-center justify-center rounded-[18.38px] bg-beige p-[5.4px]">
          <Icon
            name="lucide:arrow-up-right"
            class="cookie-btn-svg block h-[12.98px] w-[12.98px]"
            style={`color: ${color};`}
            aria-hidden="true"
          />
        </span>
      </a>
    </div>
  </div>
</article>

<script>
  import { animate } from 'motion';

  function hexToRgba(hex: string, alpha: number) {
    const h = hex.replace('#', '');
    const r = parseInt(h.slice(0, 2), 16);
    const g = parseInt(h.slice(2, 4), 16);
    const b = parseInt(h.slice(4, 6), 16);
    return `rgba(${r},${g},${b},${alpha})`;
  }

  function getLuminance(hex: string) {
    const h = hex.replace('#', '');
    const toLinear = (c: number) => {
      const s = c / 255;
      return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * toLinear(parseInt(h.slice(0, 2), 16))
         + 0.7152 * toLinear(parseInt(h.slice(2, 4), 16))
         + 0.0722 * toLinear(parseInt(h.slice(4, 6), 16));
  }

  document.querySelectorAll<HTMLElement>('.cookie-card').forEach((card) => {
    const wrap = card.querySelector<HTMLElement>('.cookie-img-wrap');
    const left = card.querySelector<HTMLElement>('.cookie-half-left');
    const right = card.querySelector<HTMLElement>('.cookie-half-right');
    const cracked = card.querySelector<HTMLElement>('.cookie-cracked');

    const info = card.querySelector<HTMLElement>('.cookie-info');
    const title = card.querySelector<HTMLElement>('.cookie-title');
    const desc = card.querySelector<HTMLElement>('.cookie-desc');
    const price = card.querySelector<HTMLElement>('.cookie-price');
    const btn = card.querySelector<HTMLElement>('.cookie-btn');
    const btnIcon = card.querySelector<HTMLElement>('.cookie-btn-icon');
    const btnSvg = card.querySelector<HTMLElement>('.cookie-btn-svg');
    const color = card.dataset.color ?? '#6ca7d5';

    if (!wrap || !left || !right || !cracked || !info || !price || !btn || !btnIcon) return;

    const EASE: [number, number, number, number] = [0.4, 0, 0.2, 1];
    const DUR = 0.38;
    const color0 = hexToRgba(color, 0);
    const beige = '#f7f2e8';
    const beige0 = hexToRgba(beige, 0);
    const isDark = getLuminance(color) < 0.05;
    const priceHoverColor = isDark ? '#C2E0F8' : '#ffffff';
    const titleOrigColor = title ? getComputedStyle(title).color : '';
    const descOrigColor = desc ? getComputedStyle(desc).color : '';

    let splitTimeout: ReturnType<typeof setTimeout> | null = null;
    let active = false;

    const start = () => {
      if (active) return;
      active = true;
      card.style.zIndex = '10';

      animate(card, { scale: 1.1 }, { type: 'spring', stiffness: 280, damping: 14, mass: 1 });
      animate(info, { backgroundColor: [color0, color] }, { duration: DUR, ease: EASE });
      animate(price, { color: ['', priceHoverColor] }, { duration: DUR, ease: EASE });
      if (isDark && title) animate(title, { color: [titleOrigColor, '#F7F2E8'] }, { duration: DUR, ease: EASE });
      if (isDark && desc) animate(desc, { color: [descOrigColor, '#ffffff'] }, { duration: DUR, ease: EASE });
      animate(btn, { backgroundColor: [color, '#ffffff'], color: [beige, color] }, { duration: DUR, ease: EASE });
      animate(btnIcon, { backgroundColor: [beige, color] }, { duration: DUR, ease: EASE });
      if (btnSvg) animate(btnSvg, { color: [color, '#ffffff'] }, { duration: DUR, ease: EASE });

      const slide = wrap.offsetWidth / 522.26 * 2;
      animate(wrap, { rotate: -15 }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
      animate(left, { x: -slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });
      animate(right, { x: slide }, { type: 'spring', stiffness: 350, damping: 20, mass: 1 });

      splitTimeout = setTimeout(() => {
        animate(cracked, { opacity: 1 }, { duration: 0.1, ease: 'easeOut' });
        animate(left, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
        animate(right, { opacity: 0 }, { duration: 0.1, ease: 'easeOut' });
        animate(wrap, { scale: 1.1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
      }, 50);
    };

    const reset = () => {
      active = false;
      card.style.zIndex = '';

      animate(card, { scale: 1 }, { type: 'spring', stiffness: 280, damping: 18, mass: 1 });
      animate(info, { backgroundColor: [color, color0] }, { duration: DUR, ease: EASE });
      animate(price, { color: [priceHoverColor, color] }, { duration: DUR, ease: EASE });
      if (isDark && title) animate(title, { color: ['#F7F2E8', titleOrigColor] }, { duration: DUR, ease: EASE });
      if (isDark && desc) animate(desc, { color: ['#ffffff', descOrigColor] }, { duration: DUR, ease: EASE });
      animate(btn, { backgroundColor: ['#ffffff', color], color: [color, beige] }, { duration: DUR, ease: EASE });
      animate(btnIcon, { backgroundColor: [color, beige] }, { duration: DUR, ease: EASE });
      if (btnSvg) animate(btnSvg, { color: ['#ffffff', color] }, { duration: DUR, ease: EASE });

      if (splitTimeout) {
        clearTimeout(splitTimeout);
        splitTimeout = null;
      }
      animate(wrap, { rotate: 0, scale: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
      animate(left, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
      animate(right, { x: 0, opacity: 1 }, { type: 'spring', stiffness: 300, damping: 20, mass: 1 });
      animate(cracked, { opacity: 0 }, { duration: DUR, ease: EASE });
    };

    card.addEventListener('mouseenter', start);
    card.addEventListener('mouseleave', reset);
  });
</script>
